---
/**
 * The header's release badge: the current `stable` version, and the `latest`
 * pre-release when there is one newer than it — the two channels the
 * installer offers (see STABILITY.md).
 *
 * **Read live, in the browser.** The site is deployed by hand, not on every
 * release, and blessing a build (`gh release edit --prerelease=false`) changes
 * nothing the site is built from. A version baked in at build time would be
 * wrong from the first release after a deploy until the next deploy. So the
 * script below asks GitHub's releases API on page load, and caches the answer
 * for a few minutes: the unauthenticated API allows 60 requests an hour per
 * visitor, and a docs session easily opens more pages than that.
 *
 * **Also read at build time**, so the badge is right with JavaScript off and
 * fills in without a flash. If the build cannot reach GitHub the badge renders
 * hidden, and the script shows it once it has an answer: a missing version is
 * better than a wrong one.
 */
import { repo } from '../../site.config.mjs';

interface Release {
	tag_name: string;
	html_url: string;
	prerelease: boolean;
	draft: boolean;
}

interface Channels {
	stable?: { version: string; url: string };
	latest?: { version: string; url: string };
}

const apiUrl = repo.replace('https://github.com/', 'https://api.github.com/repos/') + '/releases?per_page=20';
const releasesUrl = `${repo}/releases`;

/**
 * `stable` is the newest release not marked pre-release — what
 * `/releases/latest` resolves to, and so what the installer installs by
 * default. `latest` is the newest pre-release, shown only when it is newer
 * than `stable`: once a pre-release has been blessed, the two are the same
 * build and one badge says it. GitHub lists releases newest first.
 */
function channels(releases: Release[]): Channels {
	const published = releases.filter((r) => !r.draft);
	const stableIdx = published.findIndex((r) => !r.prerelease);
	const toEntry = (r: Release) => ({ version: r.tag_name.replace(/^v/, ''), url: r.html_url });
	const out: Channels = {};
	if (stableIdx !== -1) out.stable = toEntry(published[stableIdx]!);
	const newestPre = published.findIndex((r) => r.prerelease);
	if (newestPre !== -1 && (stableIdx === -1 || newestPre < stableIdx)) {
		out.latest = toEntry(published[newestPre]!);
	}
	return out;
}

let initial: Channels = {};
try {
	const res = await fetch(apiUrl, {
		headers: { Accept: 'application/vnd.github+json' },
		signal: AbortSignal.timeout(5000),
	});
	if (res.ok) initial = channels((await res.json()) as Release[]);
} catch {
	// Offline build, or rate-limited: render hidden and let the browser fill it.
}
const hasAny = Boolean(initial.stable || initial.latest);
---

<div
	class="saule-releases"
	data-api={apiUrl}
	hidden={!hasAny}
	aria-label="Saule releases"
>
	<a
		class="saule-release saule-release--stable"
		data-channel="stable"
		href={initial.stable?.url ?? releasesUrl}
		hidden={!initial.stable}
		title="The stable channel — what the installer installs by default"
	>
		<span class="saule-release__label">stable</span>
		<span class="saule-release__version">{initial.stable?.version ?? ''}</span>
	</a>
	<a
		class="saule-release saule-release--latest"
		data-channel="latest"
		href={initial.latest?.url ?? releasesUrl}
		hidden={!initial.latest}
		title="The latest pre-release — install with SAULE_CHANNEL=latest"
	>
		<span class="saule-release__label">latest</span>
		<span class="saule-release__version">{initial.latest?.version ?? ''}</span>
	</a>
</div>

<script>
	interface Release {
		tag_name: string;
		html_url: string;
		prerelease: boolean;
		draft: boolean;
	}
	interface Entry {
		version: string;
		url: string;
	}
	interface Channels {
		stable?: Entry;
		latest?: Entry;
	}

	const CACHE_KEY = 'saule-release-channels';
	const CACHE_MS = 10 * 60 * 1000;

	// The same rule as the build-time half above; kept in step by hand
	// because one runs in Astro's frontmatter and the other in the browser.
	function channels(releases: Release[]): Channels {
		const published = releases.filter((r) => !r.draft);
		const stableIdx = published.findIndex((r) => !r.prerelease);
		const toEntry = (r: Release): Entry => ({
			version: r.tag_name.replace(/^v/, ''),
			url: r.html_url,
		});
		const out: Channels = {};
		if (stableIdx !== -1) out.stable = toEntry(published[stableIdx]!);
		const newestPre = published.findIndex((r) => r.prerelease);
		if (newestPre !== -1 && (stableIdx === -1 || newestPre < stableIdx)) {
			out.latest = toEntry(published[newestPre]!);
		}
		return out;
	}

	// Storage can be unavailable or throw (private windows, blocked site
	// data), so every access is guarded and the badge works without it.
	function readCache(): Channels | null {
		try {
			const raw = localStorage.getItem(CACHE_KEY);
			if (!raw) return null;
			const { at, value } = JSON.parse(raw) as { at: number; value: Channels };
			return Date.now() - at < CACHE_MS ? value : null;
		} catch {
			return null;
		}
	}

	function writeCache(value: Channels) {
		try {
			localStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), value }));
		} catch {
			// Nothing to do: the next page load simply asks again.
		}
	}

	function render(root: HTMLElement, value: Channels) {
		for (const name of ['stable', 'latest'] as const) {
			const link = root.querySelector<HTMLAnchorElement>(`[data-channel="${name}"]`);
			if (!link) continue;
			const entry = value[name];
			link.hidden = !entry;
			if (!entry) continue;
			link.href = entry.url;
			const v = link.querySelector('.saule-release__version');
			if (v) v.textContent = entry.version;
		}
		root.hidden = !(value.stable || value.latest);
	}

	async function refresh(root: HTMLElement) {
		const cached = readCache();
		if (cached) {
			render(root, cached);
			return;
		}
		try {
			const res = await fetch(root.dataset.api!, {
				headers: { Accept: 'application/vnd.github+json' },
			});
			// Rate-limited or down: keep whatever the build rendered.
			if (!res.ok) return;
			const value = channels((await res.json()) as Release[]);
			writeCache(value);
			render(root, value);
		} catch {
			// Offline: the build-time answer stays.
		}
	}

	for (const root of document.querySelectorAll<HTMLElement>('.saule-releases')) {
		void refresh(root);
	}
</script>

<style>
	.saule-releases {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	.saule-releases[hidden],
	.saule-release[hidden] {
		display: none;
	}

	.saule-release {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		padding: 0.25rem 0.6rem;
		font-size: var(--sl-text-xs);
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		transition:
			border-color var(--saule-mid, 200ms) var(--saule-ease, ease-out),
			color var(--saule-mid, 200ms) var(--saule-ease, ease-out);
	}

	.saule-release:hover,
	.saule-release:focus-visible {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}

	.saule-release__label {
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 0.68rem;
		font-weight: 600;
	}

	.saule-release--stable .saule-release__label {
		color: var(--saule-success);
	}

	.saule-release--latest .saule-release__label {
		color: var(--saule-warning);
	}

	.saule-release__version {
		font-family: var(--saule-font-mono);
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-white);
	}

	/* The header is tight below this width; the same breakpoint hides the
	   Docs button. The pre-release goes first, the stable version a little
	   later, since it is the one most readers want. */
	@media (max-width: 64rem) {
		.saule-release--latest {
			display: none;
		}
	}

	@media (max-width: 50rem) {
		.saule-releases {
			display: none;
		}
	}
</style>
