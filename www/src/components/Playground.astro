---
/**
 * The Saule playground: a CodeMirror editor, a program picker, and an output
 * pane.
 *
 * The picker holds two kinds of program. Examples ship with the site and are
 * read-only in the sense that editing one never overwrites it — you fork it
 * into a script of your own. Scripts are what the visitor writes, and they
 * live in `localStorage` (see `lib/playground-storage.ts`); they autosave,
 * rename and delete, and they share by link exactly as examples do.
 *
 * Execution goes through `src/lib/runtime.ts`, which is the only piece that
 * knows how a program actually runs.
 */
---

<!--
	`not-content` is load-bearing, not decorative. This component renders inside
	Starlight's `.sl-markdown-content`, whose prose spacing rule puts a 16px
	`margin-top` on every element that follows a sibling. That reaches into
	CodeMirror's internal DOM and margins each `.cm-line` and each
	`.cm-gutterElement` — which not only spaces the code out absurdly, it
	desynchronises the gutter from the content and breaks CodeMirror's
	coordinate maths, so clicking and selecting land on the wrong characters.
	Starlight's rule explicitly exempts `:where(.not-content *)`.
-->
<div class="playground not-content" data-playground>
	<div class="pg-toolbar">
		<div class="pg-picker-group">
			<label class="pg-picker">
				<span class="pg-picker-label">Program</span>
				<select data-examples aria-label="Open an example or one of your scripts"></select>
			</label>
			<button type="button" class="pg-btn" data-new title="Start a script of your own">
				<svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
					<path d="M7 2h2v5h5v2H9v5H7V9H2V7h5V2Z" fill="currentColor"></path>
				</svg>
				New
			</button>
		</div>

		<div class="pg-actions">
			<button type="button" class="pg-btn pg-btn-primary" data-run>
				<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
					<path d="M4 2.5v11l9-5.5-9-5.5Z" fill="currentColor"></path>
				</svg>
				Run
				<kbd>⌘↵</kbd>
			</button>
			<button type="button" class="pg-btn pg-btn-stop" data-stop hidden>
				<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
					<rect x="3" y="3" width="10" height="10" rx="1" fill="currentColor"></rect>
				</svg>
				Stop
			</button>
			<button type="button" class="pg-btn" data-save-as hidden>Save as my script</button>
			<button type="button" class="pg-btn" data-reset hidden>Reset</button>
			<button type="button" class="pg-btn" data-rename hidden>Rename</button>
			<button type="button" class="pg-btn pg-btn-danger-ghost" data-delete hidden>Delete</button>
			<button type="button" class="pg-btn" data-share>Copy link</button>
		</div>
	</div>

	<p class="pg-blurb" data-blurb></p>

	<div class="pg-split">
		<div class="pg-pane pg-pane-editor">
			<div class="pg-pane-head">
				<span data-filename>main.sau</span>
				<span class="pg-savestate" data-savestate></span>
			</div>
			<div class="pg-editor" data-editor></div>
		</div>

		<div class="pg-pane pg-pane-output">
			<div class="pg-pane-head">
				<span>Output</span>
				<span class="pg-status" data-status></span>
			</div>
			<pre class="pg-output" data-output aria-live="polite"><span class="pg-dim"
					>Press Run to execute the program.</span
				></pre>
		</div>
	</div>

	<!--
		One dialog serves naming, renaming and confirming a delete: they differ
		only in their title, whether the text field is shown, and whether the
		confirm button is destructive. `method="dialog"` means Enter in the
		field confirms and Escape cancels without any keyboard handling here.
	-->
	<dialog class="pg-dialog" data-dialog>
		<form method="dialog" class="pg-dialog-form" data-dialog-form>
			<h2 class="pg-dialog-title" data-dialog-title></h2>
			<p class="pg-dialog-body" data-dialog-body hidden></p>
			<label class="pg-dialog-field" data-dialog-field>
				<span>File name</span>
				<input type="text" data-dialog-input autocomplete="off" spellcheck="false" />
			</label>
			<div class="pg-dialog-actions">
				<button type="button" class="pg-btn" data-dialog-cancel>Cancel</button>
				<button type="submit" value="confirm" class="pg-btn pg-btn-primary" data-dialog-confirm>
					Save
				</button>
			</div>
		</form>
	</dialog>
</div>

<script>
	import { EditorState, Compartment } from '@codemirror/state';
	import {
		EditorView,
		keymap,
		lineNumbers,
		highlightActiveLine,
		highlightActiveLineGutter,
		drawSelection,
		rectangularSelection,
		highlightSpecialChars,
	} from '@codemirror/view';
	import { defaultKeymap, history, historyKeymap, indentWithTab } from '@codemirror/commands';
	import {
		syntaxHighlighting,
		HighlightStyle,
		bracketMatching,
		indentUnit,
	} from '@codemirror/language';
	import { closeBrackets, closeBracketsKeymap } from '@codemirror/autocomplete';
	import { tags as t } from '@lezer/highlight';

	import { saule } from '../lib/saule-mode';
	import { EXAMPLES, DEFAULT_EXAMPLE } from '../lib/playground-examples';
	import {
		listScripts,
		getScript,
		createScript,
		updateScript,
		renameScript,
		deleteScript,
		normaliseName,
		uniqueName,
		isPersistent,
		lastOpened,
		rememberLast,
	} from '../lib/playground-storage';
	import type { UserScript } from '../lib/playground-storage';
	import {
		runSaule,
		stopSaule,
		RUNTIME_AVAILABLE,
		RuntimeUnavailableError,
		RunCancelledError,
	} from '../lib/runtime';
	import type { Diagnostic } from '../lib/runtime';

	/** What a brand-new script starts with — enough to press Run against. */
	const STARTER = `-- A script of your own. It saves in this browser as you type.
println("Hello from my script!")
`;

	const root = document.querySelector<HTMLElement>('[data-playground]');
	if (root) init(root);

	function init(root: HTMLElement) {
		const editorHost = root.querySelector<HTMLElement>('[data-editor]')!;
		const picker = root.querySelector<HTMLSelectElement>('[data-examples]')!;
		const blurb = root.querySelector<HTMLElement>('[data-blurb]')!;
		const output = root.querySelector<HTMLElement>('[data-output]')!;
		const status = root.querySelector<HTMLElement>('[data-status]')!;
		const runBtn = root.querySelector<HTMLButtonElement>('[data-run]')!;
		const stopBtn = root.querySelector<HTMLButtonElement>('[data-stop]')!;
		const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!;
		const shareBtn = root.querySelector<HTMLButtonElement>('[data-share]')!;
		const newBtn = root.querySelector<HTMLButtonElement>('[data-new]')!;
		const saveAsBtn = root.querySelector<HTMLButtonElement>('[data-save-as]')!;
		const renameBtn = root.querySelector<HTMLButtonElement>('[data-rename]')!;
		const deleteBtn = root.querySelector<HTMLButtonElement>('[data-delete]')!;
		const filename = root.querySelector<HTMLElement>('[data-filename]')!;
		const savestate = root.querySelector<HTMLElement>('[data-savestate]')!;

		const dialog = root.querySelector<HTMLDialogElement>('[data-dialog]')!;
		const dialogTitle = root.querySelector<HTMLElement>('[data-dialog-title]')!;
		const dialogBody = root.querySelector<HTMLElement>('[data-dialog-body]')!;
		const dialogField = root.querySelector<HTMLElement>('[data-dialog-field]')!;
		const dialogInput = root.querySelector<HTMLInputElement>('[data-dialog-input]')!;
		const dialogCancel = root.querySelector<HTMLButtonElement>('[data-dialog-cancel]')!;
		const dialogConfirm = root.querySelector<HTMLButtonElement>('[data-dialog-confirm]')!;

		/**
		 * What the editor is currently showing. `example` and `user` name an
		 * entry in the picker; `shared` is a program that arrived in the URL
		 * and belongs to neither list until it is saved.
		 */
		type Current =
			| { kind: 'example'; id: string }
			| { kind: 'user'; id: string }
			| { kind: 'shared'; name: string };

		/**
		 * Whether scripts survive a reload. False in Safari's private mode and
		 * wherever storage is denied — the playground still works, but it says
		 * so in the editor's title bar instead of quietly losing files.
		 */
		const persistent = isPersistent();

		let current: Current = { kind: 'example', id: DEFAULT_EXAMPLE.id };
		/** True while a `load` is writing the document, so the autosave sits it out. */
		let applying = false;
		/** Edits to an example or a shared program, which have nowhere to go yet. */
		let dirty = false;
		let saveTimer: number | undefined;

		// Colours come from CSS variables so the editor follows Starlight's
		// light/dark toggle without re-creating the EditorView.
		const highlight = HighlightStyle.define([
			{ tag: t.comment, color: 'var(--cm-comment)', fontStyle: 'italic' },
			{ tag: t.string, color: 'var(--cm-string)' },
			{ tag: t.number, color: 'var(--cm-number)' },
			{ tag: t.atom, color: 'var(--cm-atom)' },
			{ tag: t.keyword, color: 'var(--cm-keyword)' },
			{ tag: t.definitionKeyword, color: 'var(--cm-decl)', fontWeight: '600' },
			{ tag: t.operatorKeyword, color: 'var(--cm-keyword)' },
			{ tag: t.self, color: 'var(--cm-self)', fontStyle: 'italic' },
			{ tag: t.typeName, color: 'var(--cm-type)' },
			{ tag: t.function(t.variableName), color: 'var(--cm-fn)' },
			{ tag: t.variableName, color: 'var(--cm-text)' },
			{ tag: t.operator, color: 'var(--cm-op)' },
			{ tag: t.bracket, color: 'var(--cm-op)' },
			{ tag: t.punctuation, color: 'var(--cm-punct)' },
		]);

		const theme = EditorView.theme({
			// Typography is set on the editor root, not partway down the tree.
			// CodeMirror measures line heights with probe elements of its own,
			// and those inherit from `.cm-editor` — so if the root's
			// line-height differs from the lines' (here Starlight's body 1.75
			// was reaching `.cm-editor` while `.cm-scroller` had 1.6), it
			// caches wrong heights, sizes every gutter element from them, and
			// the numbers drift out of step with the code.
			'&': {
				height: '100%',
				fontSize: '0.85rem',
				fontFamily: 'var(--saule-font-mono)',
				lineHeight: '1.6',
				backgroundColor: 'transparent',
				color: 'var(--cm-text)',
			},
			// Deliberately no vertical padding on `.cm-content`: CodeMirror
			// aligns the gutter against it, and padding one without the other
			// offsets the line numbers from their lines. Breathing room is
			// added on the `.pg-editor` wrapper instead, outside CodeMirror's
			// own layout. Line height is set on the scroller so `.cm-content`
			// and `.cm-gutters` — its two children — inherit the same value.
			'.cm-content': { fontFamily: 'var(--saule-font-mono)' },
			'.cm-scroller': { fontFamily: 'var(--saule-font-mono)', lineHeight: '1.6' },
			'.cm-gutters': {
				backgroundColor: 'transparent',
				border: 'none',
				color: 'var(--cm-gutter)',
			},
			'.cm-activeLine': { backgroundColor: 'var(--cm-active)' },
			'.cm-activeLineGutter': {
				backgroundColor: 'var(--cm-active)',
				color: 'var(--cm-text)',
			},
			'.cm-cursor': { borderLeftColor: 'var(--cm-text)' },
			'&.cm-focused': { outline: 'none' },
			// Selection is drawn by `drawSelection` as absolutely positioned
			// rectangles, not by the browser: the native `::selection` inside
			// `.cm-line` is forced transparent at `Prec.highest`, so styling
			// it here would do nothing. What has to be overridden instead is
			// CodeMirror's base theme, and its selectors are deliberately
			// specific:
			//
			//   &light .cm-selectionBackground                                  (3)
			//   &light.cm-focused > .cm-scroller > .cm-selectionLayer
			//       .cm-selectionBackground                                     (5)
			//
			// A bare `.cm-selectionBackground` is 2 and silently loses — which
			// is why the editor used to select in CodeMirror's default
			// lavender however this theme was written. Adding `.cm-editor`
			// puts each rule one class above its counterpart. (`&light` is the
			// branch in play because this theme does not declare itself dark;
			// it tracks Starlight's toggle through CSS variables instead.)
			'&.cm-editor .cm-selectionLayer .cm-selectionBackground': {
				backgroundColor: 'var(--cm-selection)',
			},
			'&.cm-editor.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground': {
				backgroundColor: 'var(--cm-selection)',
			},
			'.cm-errorLine': { backgroundColor: 'var(--cm-error-line)' },
		});

		const readOnly = new Compartment();
		const startup = resolveStartup();

		const view = new EditorView({
			parent: editorHost,
			state: EditorState.create({
				doc: startup.source,
				extensions: [
					lineNumbers(),
					highlightActiveLineGutter(),
					highlightSpecialChars(),
					history(),
					drawSelection(),
					rectangularSelection(),
					highlightActiveLine(),
					bracketMatching(),
					closeBrackets(),
					indentUnit.of('    '),
					saule(),
					syntaxHighlighting(highlight),
					theme,
					EditorView.lineWrapping,
					keymap.of([
						{ key: 'Mod-Enter', run: () => (run(), true) },
						{ key: 'Mod-s', run: () => (run(), true), preventDefault: true },
						...closeBracketsKeymap,
						...defaultKeymap,
						...historyKeymap,
						indentWithTab,
					]),
					readOnly.of(EditorState.readOnly.of(false)),
					EditorView.updateListener.of((update) => {
						if (update.docChanged && !applying) onEdit();
					}),
				],
			}),
		});

		// ---- the picker -----------------------------------------------------

		/** The option value for whatever is open, or '' for a shared program. */
		function currentValue(): string {
			if (current.kind === 'shared') return 'shared';
			return `${current.kind}:${current.id}`;
		}

		/**
		 * Rebuild both groups from scratch. Scripts are listed first: once
		 * someone has files of their own, those are what they came back for.
		 */
		function renderPicker() {
			picker.replaceChildren();

			const scripts = listScripts();
			if (scripts.length) {
				const group = document.createElement('optgroup');
				group.label = 'My scripts';
				for (const script of scripts) {
					const option = document.createElement('option');
					option.value = `user:${script.id}`;
					option.textContent = script.name;
					group.append(option);
				}
				picker.append(group);
			}

			const examples = document.createElement('optgroup');
			examples.label = 'Examples';
			for (const example of EXAMPLES) {
				const option = document.createElement('option');
				option.value = `example:${example.id}`;
				option.textContent = example.label;
				examples.append(option);
			}
			picker.append(examples);

			// A shared program is in neither list, so it needs a placeholder to
			// select — otherwise the picker would show an unrelated entry.
			if (current.kind === 'shared') {
				const option = document.createElement('option');
				option.value = 'shared';
				option.textContent = `${current.name} (shared link)`;
				picker.prepend(option);
			}

			picker.value = currentValue();
		}

		// ---- opening programs -----------------------------------------------

		/** Replace the document without the change counting as a user edit. */
		function setDoc(source: string) {
			applying = true;
			view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: source } });
			applying = false;
		}

		function openExample(id: string) {
			const example = EXAMPLES.find((e) => e.id === id) ?? DEFAULT_EXAMPLE;
			current = { kind: 'example', id: example.id };
			dirty = false;
			setDoc(example.source);
			blurb.textContent = example.blurb;
			afterOpen();
		}

		function openScript(script: UserScript) {
			current = { kind: 'user', id: script.id };
			dirty = false;
			setDoc(script.source);
			blurb.textContent = 'Your script. Edits save as you type.';
			afterOpen();
		}

		function openShared(name: string, source: string) {
			current = { kind: 'shared', name };
			dirty = false;
			setDoc(source);
			blurb.textContent = 'Loaded from a shared link — save it to keep it.';
			afterOpen({ keepHash: true });
		}

		function afterOpen(options: { keepHash?: boolean } = {}) {
			if (!options.keepHash) history_replace('');
			rememberLast(current.kind === 'shared' ? null : currentValue());
			renderPicker();
			applyMode();
			clearOutput();
		}

		/** Show the actions that make sense for what is open, and say so. */
		function applyMode() {
			const isUser = current.kind === 'user';
			resetBtn.hidden = current.kind !== 'example';
			renameBtn.hidden = !isUser;
			deleteBtn.hidden = !isUser;
			saveAsBtn.hidden = isUser;

			if (isUser) {
				const script = getScript(current.id);
				filename.textContent = script?.name ?? 'untitled.sau';
			} else if (current.kind === 'shared') {
				filename.textContent = current.name;
			} else {
				filename.textContent = 'main.sau';
			}

			setSaveState(isUser ? 'saved' : dirty ? 'unsaved' : 'clean');
		}

		function setSaveState(state: 'saved' | 'saving' | 'unsaved' | 'clean') {
			savestate.className = 'pg-savestate';
			if (state === 'clean') {
				savestate.textContent = '';
			} else if (state === 'saving') {
				savestate.textContent = 'saving…';
			} else if (state === 'saved') {
				savestate.textContent = persistent ? 'saved' : 'this session only';
				savestate.classList.add(persistent ? 'pg-saved' : 'pg-unsaved');
			} else {
				savestate.textContent = 'unsaved';
				savestate.classList.add('pg-unsaved');
			}
		}

		/**
		 * Every edit either autosaves, or is flagged as having nowhere to go.
		 * Examples and shared programs are never written over: editing one
		 * just offers "Save as my script".
		 */
		function onEdit() {
			// The hash describes a program that no longer matches the buffer.
			if (window.location.hash) history_replace('');

			if (current.kind !== 'user') {
				if (!dirty) {
					dirty = true;
					setSaveState('unsaved');
				}
				return;
			}

			setSaveState('saving');
			window.clearTimeout(saveTimer);
			saveTimer = window.setTimeout(() => {
				if (current.kind !== 'user') return;
				const saved = updateScript(current.id, view.state.doc.toString());
				// Deleted in another tab; fall back rather than resurrect it.
				if (!saved) {
					openExample(DEFAULT_EXAMPLE.id);
					return;
				}
				setSaveState('saved');
			}, 400);
		}

		/** Flush a pending autosave, so an action never races the debounce. */
		function flushSave() {
			if (saveTimer === undefined) return;
			window.clearTimeout(saveTimer);
			saveTimer = undefined;
			if (current.kind === 'user') updateScript(current.id, view.state.doc.toString());
		}

		/** Ask before throwing away edits that are not being autosaved. */
		async function confirmDiscard(): Promise<boolean> {
			if (!dirty || current.kind === 'user') return true;
			const answer = await openDialog({
				title: 'Discard your changes?',
				body: 'This program is not one of your scripts, so its edits are not saved. Save it as a script first to keep them.',
				confirm: 'Discard',
				danger: true,
			});
			return answer !== null;
		}

		picker.addEventListener('change', async () => {
			const value = picker.value;
			if (value === currentValue()) return;
			if (!(await confirmDiscard())) {
				picker.value = currentValue();
				return;
			}

			if (value.startsWith('user:')) {
				const script = getScript(value.slice(5));
				if (script) openScript(script);
				else renderPicker();
			} else if (value.startsWith('example:')) {
				openExample(value.slice(8));
			}
		});

		resetBtn.addEventListener('click', () => {
			if (current.kind === 'example') openExample(current.id);
		});

		// ---- scripts of your own --------------------------------------------

		newBtn.addEventListener('click', async () => {
			if (!(await confirmDiscard())) return;
			const name = await openDialog({
				title: 'New script',
				input: uniqueName('scratch.sau'),
				confirm: 'Create',
			});
			if (name === null) return;
			openScript(createScript(name, STARTER));
			view.focus();
		});

		saveAsBtn.addEventListener('click', async () => {
			const suggested =
				current.kind === 'shared'
					? current.name
					: `${EXAMPLES.find((e) => e.id === current.id)?.id ?? 'program'}.sau`;
			const name = await openDialog({
				title: 'Save as my script',
				body: 'Saved in this browser only. Use Copy link to take it elsewhere.',
				input: uniqueName(suggested),
				confirm: 'Save',
			});
			if (name === null) return;
			openScript(createScript(name, view.state.doc.toString()));
		});

		renameBtn.addEventListener('click', async () => {
			if (current.kind !== 'user') return;
			const script = getScript(current.id);
			if (!script) return;
			const name = await openDialog({
				title: 'Rename script',
				input: script.name,
				confirm: 'Rename',
			});
			if (name === null) return;
			renameScript(script.id, name || script.name);
			renderPicker();
			applyMode();
		});

		deleteBtn.addEventListener('click', async () => {
			if (current.kind !== 'user') return;
			const script = getScript(current.id);
			if (!script) return;
			const answer = await openDialog({
				title: `Delete ${script.name}?`,
				body: 'This cannot be undone.',
				confirm: 'Delete',
				danger: true,
			});
			if (answer === null) return;
			window.clearTimeout(saveTimer);
			saveTimer = undefined;
			deleteScript(script.id);
			openExample(DEFAULT_EXAMPLE.id);
		});

		// ---- the dialog ------------------------------------------------------

		interface DialogOptions {
			title: string;
			body?: string;
			/** Initial text. Omit for a confirmation with no field. */
			input?: string;
			confirm: string;
			danger?: boolean;
		}

		/** Resolves to the typed name, '' for a fieldless confirm, or null. */
		function openDialog(options: DialogOptions): Promise<string | null> {
			const wantsInput = options.input !== undefined;

			dialogTitle.textContent = options.title;
			dialogBody.textContent = options.body ?? '';
			dialogBody.hidden = !options.body;
			dialogField.hidden = !wantsInput;
			dialogInput.value = options.input ?? '';
			dialogInput.disabled = !wantsInput;
			dialogConfirm.textContent = options.confirm;
			dialogConfirm.classList.toggle('pg-btn-danger', !!options.danger);
			dialogConfirm.classList.toggle('pg-btn-primary', !options.danger);

			return new Promise((resolve) => {
				dialog.addEventListener(
					'close',
					() => {
						if (dialog.returnValue !== 'confirm') return resolve(null);
						resolve(wantsInput ? normaliseName(dialogInput.value) : '');
					},
					{ once: true },
				);
				dialog.returnValue = '';
				dialog.showModal();
				if (wantsInput) dialogInput.select();
			});
		}

		// Cancel is a plain button rather than a second submit, so Enter in the
		// text field always means "confirm" whatever the DOM order is.
		dialogCancel.addEventListener('click', () => dialog.close(''));
		// Implicit submission would normally handle Enter, but it is easy to
		// suppress by accident (an outer keydown handler, an automated key
		// event) and a name dialog that ignores Enter feels broken. Take it
		// over explicitly, cancelling the implicit path so it fires once.
		dialogInput.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter') return;
			event.preventDefault();
			dialogConfirm.click();
		});
		// Clicking the backdrop — anywhere outside the form — cancels too.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close('');
		});

		// ---- sharing --------------------------------------------------------

		/**
		 * Programs travel in the URL fragment, base64url-encoded. The fragment
		 * never reaches the server, which matters on GitHub Pages where there
		 * is no server to reach — and it keeps whatever someone typed out of
		 * access logs.
		 */
		function encode(source: string): string {
			const bytes = new TextEncoder().encode(source);
			let binary = '';
			for (const byte of bytes) binary += String.fromCharCode(byte);
			return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
		}

		function decode(encoded: string): string | null {
			try {
				const padded = encoded.replace(/-/g, '+').replace(/_/g, '/');
				const binary = atob(padded);
				const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
				return new TextDecoder().decode(bytes);
			} catch {
				return null;
			}
		}

		/**
		 * What to open on arrival, in order of how specific the request is: a
		 * shared link, then whatever was open last, then the first example.
		 * Called before the editor exists, so it only returns a description.
		 */
		function resolveStartup():
			| { kind: 'example'; id: string; source: string }
			| { kind: 'user'; id: string; source: string }
			| { kind: 'shared'; name: string; source: string } {
			const code = /[#&]code=([^&]+)/.exec(window.location.hash);
			const shared = code ? decode(code[1]!) : null;
			if (shared !== null) {
				const named = /[#&]name=([^&]+)/.exec(window.location.hash);
				const name = normaliseName(named ? (decode(named[1]!) ?? 'shared.sau') : 'shared.sau');
				// Reloading a link you copied from your own script should
				// reopen that script, not offer to save a second copy of it.
				const mine = listScripts().find((s) => s.name === name && s.source === shared);
				if (mine) return { kind: 'user', id: mine.id, source: mine.source };
				return { kind: 'shared', name, source: shared };
			}

			const last = lastOpened();
			if (last?.startsWith('user:')) {
				const script = getScript(last.slice(5));
				if (script) return { kind: 'user', id: script.id, source: script.source };
			}
			if (last?.startsWith('example:')) {
				const example = EXAMPLES.find((e) => e.id === last.slice(8));
				if (example) return { kind: 'example', id: example.id, source: example.source };
			}

			return { kind: 'example', id: DEFAULT_EXAMPLE.id, source: DEFAULT_EXAMPLE.source };
		}

		function history_replace(hash: string) {
			const url = new URL(window.location.href);
			url.hash = hash;
			window.history.replaceState(null, '', url.toString());
		}

		shareBtn.addEventListener('click', async () => {
			flushSave();
			// The name rides along so the recipient opens `parser.sau`, not an
			// anonymous buffer — and so "Save as my script" can suggest it.
			const name = current.kind === 'example' ? null : filename.textContent;
			const parts = [`code=${encode(view.state.doc.toString())}`];
			if (name) parts.push(`name=${encode(name)}`);
			history_replace(parts.join('&'));

			const label = shareBtn.textContent;
			try {
				await navigator.clipboard.writeText(window.location.href);
				shareBtn.textContent = 'Copied!';
			} catch {
				// Clipboard access can be denied; the URL bar still has the link.
				shareBtn.textContent = 'Link in URL bar';
			}
			setTimeout(() => {
				shareBtn.textContent = label;
			}, 2000);
		});

		// ---- running --------------------------------------------------------

		function clearOutput() {
			output.replaceChildren(dim('Press Run to execute the program.'));
			status.textContent = '';
			status.className = 'pg-status';
		}

		function dim(text: string): HTMLElement {
			const span = document.createElement('span');
			span.className = 'pg-dim';
			span.textContent = text;
			return span;
		}

		function line(text: string, className?: string): HTMLElement {
			const span = document.createElement('span');
			if (className) span.className = className;
			span.textContent = text;
			return span;
		}

		/**
		 * Turn a diagnostic's byte offset into a line and column.
		 *
		 * The runtime reports UTF-8 byte offsets, because that is what the
		 * compiler works in; JavaScript strings are indexed in UTF-16 code
		 * units. The two agree for ASCII and diverge the moment a program
		 * contains a non-ASCII string literal or comment, so the walk below
		 * counts bytes explicitly rather than trusting the string index.
		 */
		function locate(source: string, byteOffset: number): { line: number; column: number } {
			let bytes = 0;
			let ln = 1;
			let column = 1;

			for (let i = 0; i < source.length && bytes < byteOffset; i++) {
				const code = source.codePointAt(i)!;

				if (source[i] === '\n') {
					ln++;
					column = 1;
				} else {
					column++;
				}

				if (code > 0xffff) {
					// An astral character is one surrogate pair here and four
					// bytes there; skip its low surrogate so it counts once.
					bytes += 4;
					i++;
				} else if (code > 0x7ff) {
					bytes += 3;
				} else if (code > 0x7f) {
					bytes += 2;
				} else {
					bytes += 1;
				}
			}

			return { line: ln, column };
		}

		/** Render a diagnostic the way the CLI does: phase, position, message, help. */
		function renderDiagnostic(d: Diagnostic, source: string): HTMLElement {
			const wrap = document.createElement('div');
			wrap.className = d.severity === 'error' ? 'pg-error' : 'pg-warning';

			wrap.append(line(`${d.phase} ${d.severity}`, 'pg-diag-label'));
			// Some errors carry no location at all — a runtime failure with no
			// frame to blame, say — and those simply go without one.
			if (d.span) {
				const { line: ln, column } = locate(source, d.span.start);
				wrap.append(line(` (line ${ln}, column ${column})`, 'pg-diag-loc'));
			}
			wrap.append(line(': '), line(d.message));

			if (d.help) {
				wrap.append(document.createElement('br'), line(`  help: ${d.help}`, 'pg-dim'));
			}
			return wrap;
		}

		let running = false;
		/** The first run pays for fetching and initialising the wasm module. */
		let firstRun = true;

		function setRunning(active: boolean) {
			running = active;
			runBtn.disabled = active;
			// Swap Run for Stop rather than showing both: while a program is
			// running, stopping it is the only useful action.
			stopBtn.hidden = !active;
		}

		async function run() {
			if (running) return;
			setRunning(true);
			// The module is fetched on first use, so say so — a couple of
			// hundred milliseconds of silence otherwise looks like a hang.
			status.textContent = firstRun ? 'Starting the runtime…' : 'Running…';
			status.className = 'pg-status';
			output.replaceChildren();

			// The source is captured rather than re-read after the run, so the
			// offsets in the diagnostics are resolved against the exact text
			// that produced them even if the editor moved on meanwhile.
			const source = view.state.doc.toString();

			try {
				const result = await runSaule(source);
				firstRun = false;

				const nodes: Node[] = [];
				for (const chunk of result.output) {
					nodes.push(line(chunk.text, chunk.stream === 'stderr' ? 'pg-stderr' : undefined));
				}
				for (const d of result.diagnostics) nodes.push(renderDiagnostic(d, source));

				if (!nodes.length) nodes.push(dim('(no output)'));
				output.replaceChildren(...nodes);

				status.textContent = result.ok
					? `Finished in ${result.durationMs.toFixed(0)} ms`
					: `Failed — ${result.diagnostics.length} diagnostic(s)`;
				status.className = result.ok ? 'pg-status pg-ok' : 'pg-status pg-fail';
			} catch (err) {
				if (err instanceof RunCancelledError) {
					// Stopped on purpose — by the button or the timeout. Not a
					// failure of the program, so it reads differently.
					const box = document.createElement('div');
					box.className = 'pg-notice';
					box.append(line(err.message));
					output.replaceChildren(box);
					status.textContent = 'Stopped';
					status.className = 'pg-status pg-fail';
				} else {
					const message =
						err instanceof RuntimeUnavailableError
							? err.message
							: `Unexpected failure: ${err instanceof Error ? err.message : String(err)}`;

					const box = document.createElement('div');
					box.className = 'pg-notice';
					box.append(line(message));
					output.replaceChildren(box);

					status.textContent = 'Runtime unavailable';
					status.className = 'pg-status pg-fail';
				}
			} finally {
				setRunning(false);
			}
		}

		runBtn.addEventListener('click', run);
		stopBtn.addEventListener('click', () => stopSaule());

		// ---- boot -----------------------------------------------------------

		// The document is already in the editor — `resolveStartup` fed it to
		// `EditorState.create`. What is left is the chrome around it, and the
		// `open*` helpers do that without re-writing an identical document.
		if (startup.kind === 'shared') openShared(startup.name, startup.source);
		else if (startup.kind === 'user') {
			const script = getScript(startup.id)!;
			openScript(script);
		} else openExample(startup.id);

		if (!RUNTIME_AVAILABLE) {
			runBtn.title = 'The browser runtime is still being built';
			status.textContent = 'Runtime not yet available';
			status.className = 'pg-status pg-fail';
		}

		// Stopping a program is worth a keyboard shortcut of its own, since
		// the mouse may be nowhere near the button when a loop runs away.
		document.addEventListener('keydown', (event) => {
			if (running && event.key === 'Escape') {
				event.preventDefault();
				stopSaule();
			}
		});
	}
</script>

