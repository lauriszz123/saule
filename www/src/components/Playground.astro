---
/**
 * The Saule playground.
 *
 * A full-height editor rather than a widget on a page: a sidebar of
 * programs, a tab bar, a CodeMirror editor with live diagnostics, and an
 * output pane, over a status bar.
 *
 * Three pieces do the work and are documented where they live:
 *
 *   * `lib/runtime.ts` — the only thing that knows how a program runs,
 *     checks or formats, and the only thing that touches a worker.
 *   * `lib/saule-complete.ts` — completion and hover, generated from
 *     DOCS.md so the editor and the reference cannot disagree.
 *   * `lib/playground-storage.ts` — scripts and the workspace, in
 *     `localStorage`, since there is no server behind this site.
 *
 * The picker holds two kinds of program. Examples ship with the site and
 * are read-only in the sense that editing one never overwrites it — you
 * fork it into a script of your own. Scripts are what the visitor writes;
 * they autosave, rename and delete, and share by link exactly as examples
 * do.
 */
---

<!--
	`not-content` is load-bearing, not decorative. This component renders inside
	Starlight's `.sl-markdown-content`, whose prose spacing rule puts a 16px
	`margin-top` on every element that follows a sibling. That reaches into
	CodeMirror's internal DOM and margins each `.cm-line` and each
	`.cm-gutterElement` — which not only spaces the code out absurdly, it
	desynchronises the gutter from the content and breaks CodeMirror's
	coordinate maths, so clicking and selecting land on the wrong characters.
	Starlight's rule explicitly exempts `:where(.not-content *)`.
-->
<div class="pg not-content" data-playground data-layout="side-by-side" data-view="code">
	<!-- Behind the sidebar when it is a drawer; tapping away is how it closes. -->
	<button type="button" class="pg-scrim" data-scrim tabindex="-1" aria-label="Close the programs list" hidden
	></button>

	<aside class="pg-sidebar" data-sidebar>
		<div class="pg-sidebar-head">
			<span class="pg-sidebar-title">Programs</span>
			<button type="button" class="pg-icon" data-new title="New script (Ctrl+Alt+N)">
				<svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
					<path d="M7 2h2v5h5v2H9v5H7V9H2V7h5V2Z" fill="currentColor"></path>
				</svg>
				<span class="sr-only">New script</span>
			</button>
		</div>
		<nav class="pg-tree" data-tree aria-label="Programs"></nav>
		<p class="pg-storage" data-storage></p>
	</aside>

	<button
		type="button"
		class="pg-sidebar-toggle"
		data-sidebar-toggle
		aria-expanded="true"
		title="Hide the sidebar (Ctrl+B)"
	>
		<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
			<path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2"></path>
		</svg>
		<span class="sr-only">Toggle the sidebar</span>
	</button>

	<div class="pg-main">
		<!--
			Tabs on the left, actions on the right, as IntelliJ's toolbar is
			laid out: what is open and what you can do to it belong on the
			same line, above the thing they act on.
		-->
		<div class="pg-toolbar">
			<button
				type="button"
				class="pg-drawer-btn"
				data-drawer-open
				aria-expanded="false"
				title="Programs"
			>
				<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
					<path
						d="M2 3.5h12M2 8h12M2 12.5h12"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"></path>
				</svg>
				<span class="sr-only">Programs</span>
			</button>

			<div class="pg-tabs" data-tabs role="tablist" aria-label="Open programs"></div>

			<div class="pg-actions">
				<!-- Which pane is showing, where only one fits. -->
				<div class="pg-views" role="group" aria-label="Show">
					<button type="button" class="pg-view" data-view-code aria-pressed="true">Code</button>
					<button type="button" class="pg-view" data-view-output aria-pressed="false">Output</button>
				</div>

				<!--
					The run widget: one control that names its target and
					runs it, with Stop taking the same space while a program
					is running.
				-->
				<div class="pg-run-widget">
					<button type="button" class="pg-run" data-run>
						<svg class="pg-run-glyph" aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
							<path d="M4.5 2.8v10.4l8.5-5.2-8.5-5.2Z" fill="currentColor"></path>
						</svg>
						<span class="pg-run-target" data-run-target></span>
						<span class="pg-run-label">Run</span>
						<kbd data-run-key>Ctrl ↵</kbd>
					</button>
					<button type="button" class="pg-stop" data-stop disabled>
						<svg aria-hidden="true" viewBox="0 0 16 16" width="11" height="11">
							<rect x="3" y="3" width="10" height="10" rx="1.5" fill="currentColor"></rect>
						</svg>
						Stop
						<kbd>Esc</kbd>
					</button>
				</div>

				<span class="pg-sep"></span>

				<!--
					Labelled, not icons. An icon-only toolbar hides what the
					page can do behind a hover: the point of Share is partly
					that someone sees it is possible. The label lives in its
					own span because both buttons report back through it —
					"Copied!", "Already tidy" — and swapping the button's
					text wholesale would take the glyph with it.
				-->
				<button type="button" class="pg-btn" data-format title="Format (Shift+Alt+F)">
					<svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
						<path
							d="M2.5 3.5h11M2.5 6.8h7M2.5 10h11M2.5 13.2h7"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"></path>
					</svg>
					<span data-format-label>Format</span>
				</button>
				<button type="button" class="pg-btn" data-share title="Copy a link to this program">
					<svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
						<path
							d="M6.6 9.4a3 3 0 0 0 4.3 0l2-2a3 3 0 0 0-4.3-4.3l-.9.9M9.4 6.6a3 3 0 0 0-4.3 0l-2 2a3 3 0 0 0 4.3 4.3l.9-.9"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"></path>
					</svg>
					<span data-share-label>Share</span>
				</button>
			</div>
		</div>

		<div class="pg-split" data-split>
			<section class="pg-pane pg-pane-editor" data-editor-pane>
				<!--
					An editor notification, the way an IDE explains a
					read-only file: these two actions exist *because* of
					what is open, so they belong to the file rather than to
					the toolbar. They were two variable-width buttons in a
					fixed-width row, and "Save as my script" is long enough
					to push the row past the window on any ordinary laptop.
				-->
				<div class="pg-banner" data-banner hidden>
					<svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
						<circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"
						></circle>
						<path d="M8 7.3v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
						></path>
						<circle cx="8" cy="4.8" r="0.85" fill="currentColor"></circle>
					</svg>
					<span data-banner-text></span>
					<span class="pg-banner-spacer"></span>
					<button type="button" class="pg-banner-action" data-save-as>Save a copy</button>
					<button type="button" class="pg-banner-action" data-reset hidden>Reset</button>
				</div>
				<div class="pg-editor" data-editor></div>
			</section>

			<div
				class="pg-gutter"
				data-gutter
				role="separator"
				aria-orientation="vertical"
				aria-label="Resize the panes"
				tabindex="0"
			>
			</div>

			<section class="pg-pane pg-pane-output">
				<div class="pg-pane-head">
					<span class="pg-pane-title">Output</span>
					<span class="pg-status" data-status></span>
					<span class="pg-pane-spacer"></span>
					<button
						type="button"
						class="pg-icon"
						data-layout-toggle
						title="Stack the panes instead"
					>
						<svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
							<rect
								x="1.5"
								y="2.5"
								width="13"
								height="11"
								rx="1.5"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"></rect>
							<path
								d="M8 2.5v11"
								data-layout-divider
								stroke="currentColor"
								stroke-width="1.6"></path>
						</svg>
						<span class="sr-only">Toggle the pane arrangement</span>
					</button>
					<button type="button" class="pg-icon" data-clear title="Clear the output">
						<svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
							<path
								d="M3 5h10M6.5 5V3.5h3V5M5 5l.7 8.5h4.6L11 5"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"></path>
						</svg>
						<span class="sr-only">Clear the output</span>
					</button>
				</div>
				<pre class="pg-output" data-output aria-live="polite"></pre>
			</section>
		</div>

		<!--
			A tool window rather than a strip inside the editor: Problems
			spans the whole width and opens over both panes, which is where
			IntelliJ puts it and what gives a long message room to be read.
		-->
		<div class="pg-problems" data-problems hidden>
			<ul class="pg-problems-list" data-problems-list></ul>
		</div>

		<div class="pg-keybar" data-keybar role="toolbar" aria-label="Insert into the editor" hidden></div>

		<!--
			The status bar is for what is true, not for what you can do: a
			single thin line of readings, the way an IDE's is. The one
			control on it is the stripe button that opens Problems, which is
			itself a statement that there are some.
		-->
		<div class="pg-statusbar">
			<button type="button" class="pg-stripe" data-problems-toggle hidden>
				<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
					<path
						d="M8 2.2 15 14H1L8 2.2Z"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						stroke-linejoin="round"></path>
					<path d="M8 6.3v3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
					></path>
					<circle cx="8" cy="11.7" r="0.8" fill="currentColor"></circle>
				</svg>
				<span data-problems-count></span>
			</button>

			<span class="pg-statusbar-spacer"></span>

			<span class="pg-meta" data-savestate></span>
			<span class="pg-meta" data-cursor></span>
			<span class="pg-meta">4 spaces</span>
			<span class="pg-meta">UTF-8</span>
			<span class="pg-meta pg-version" data-version></span>
			<button type="button" class="pg-icon pg-icon-sm" data-help title="Keyboard shortcuts (?)">
				<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
					<circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"
					></circle>
					<path
						d="M6.2 6.1a1.9 1.9 0 1 1 2.4 1.8c-.4.1-.6.5-.6.9v.4"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"></path>
					<circle cx="8" cy="11.6" r="0.9" fill="currentColor"></circle>
				</svg>
				<span class="sr-only">Keyboard shortcuts</span>
			</button>
		</div>
	</div>

	<!--
		One dialog serves naming, renaming and confirming a delete: they differ
		only in their title, whether the text field is shown, and whether the
		confirm button is destructive. `method="dialog"` means Enter in the
		field confirms and Escape cancels without any keyboard handling here.
	-->
	<dialog class="pg-dialog" data-dialog>
		<form method="dialog" class="pg-dialog-form" data-dialog-form>
			<h2 class="pg-dialog-title" data-dialog-title></h2>
			<p class="pg-dialog-body" data-dialog-body hidden></p>
			<label class="pg-dialog-field" data-dialog-field>
				<span>File name</span>
				<input type="text" data-dialog-input autocomplete="off" spellcheck="false" />
			</label>
			<div class="pg-dialog-actions">
				<button type="button" class="pg-btn" data-dialog-cancel>Cancel</button>
				<button type="submit" value="confirm" class="pg-btn pg-btn-primary" data-dialog-confirm>
					Save
				</button>
			</div>
		</form>
	</dialog>

	<!--
		`autofocus` on the dialog itself, not on anything inside it.

		Opening a modal focuses its first focusable descendant when nothing
		claims focus, and in here that is the Close button at the very
		bottom — so the browser scrolled it into view and the dialog opened
		at its own end. Focusing the dialog leaves the scroll where it
		starts, and Escape still closes it.
	-->
	<dialog class="pg-dialog pg-dialog-help" data-help-dialog tabindex="-1" autofocus>
		<h2 class="pg-dialog-title">Keyboard shortcuts</h2>
		<dl class="pg-keys" data-keys></dl>
		<h2 class="pg-dialog-title">How it works</h2>
		<p class="pg-dialog-body">
			Your code runs entirely in your browser — the same compiler and VM the
			<code>saule</code> CLI uses, built to WebAssembly. Nothing is sent to a server, so the
			type checker, the diagnostics and the output are the ones you would get locally. The
			runtime is fetched the first time you press Run.
		</p>
		<p class="pg-dialog-body">
			Programs run in single-file mode, like <code>saule run file.sau</code>: top to bottom,
			with no <code>class Main</code>. <code>import</code> does not work here, nor do the
			parts of <code>Os</code> and <code>Io</code> that reach for real files or processes.
			Everything else behaves exactly as it does locally.
		</p>
		<p class="pg-dialog-body">
			Scripts are saved in this browser only. <strong>Copy link</strong> puts a program in
			the URL, which is how one travels to another machine.
		</p>
		<div class="pg-dialog-actions">
			<button type="button" class="pg-btn pg-btn-primary" data-help-close>Close</button>
		</div>
	</dialog>
</div>

<script>
	import { EditorState, StateEffect, StateField } from '@codemirror/state';
	import {
		EditorView,
		keymap,
		lineNumbers,
		highlightActiveLine,
		highlightActiveLineGutter,
		drawSelection,
		rectangularSelection,
		highlightSpecialChars,
		Decoration,
		type DecorationSet,
	} from '@codemirror/view';
	import {
		defaultKeymap,
		history,
		historyKeymap,
		indentMore,
		indentWithTab,
		redo,
		undo,
	} from '@codemirror/commands';
	import { searchKeymap, highlightSelectionMatches } from '@codemirror/search';
	import {
		syntaxHighlighting,
		HighlightStyle,
		bracketMatching,
		indentUnit,
		foldGutter,
		foldKeymap,
		codeFolding,
	} from '@codemirror/language';
	import { closeBrackets, closeBracketsKeymap, insertBracket } from '@codemirror/autocomplete';
	import { linter, lintGutter, type Diagnostic as CmDiagnostic } from '@codemirror/lint';
	import { tags as t } from '@lezer/highlight';

	import { saule } from '../lib/saule-mode';
	import { sauleDocs } from '../lib/saule-complete';
	import { EXAMPLES, DEFAULT_EXAMPLE } from '../lib/playground-examples';
	import {
		listScripts,
		getScript,
		createScript,
		updateScript,
		renameScript,
		deleteScript,
		normaliseName,
		uniqueName,
		isPersistent,
		readSession,
		writeSession,
	} from '../lib/playground-storage';
	import type { OpenTab, Session, UserScript } from '../lib/playground-storage';
	import {
		runSaule,
		stopSaule,
		checkSaule,
		formatSaule,
		getRuntimeVersion,
		RuntimeUnavailableError,
		RunCancelledError,
	} from '../lib/runtime';
	import type { Diagnostic } from '../lib/runtime';

	/** What a brand-new script starts with — enough to press Run against. */
	const STARTER = `-- A script of your own. It saves in this browser as you type.
println("Hello from my script!")
`;

	const root = document.querySelector<HTMLElement>('[data-playground]');
	if (root) init(root);

	function init(root: HTMLElement) {
		// Defaults to `HTMLElement`, which is what all but one of these are;
		// the exception passes its own type.
		const q = <T extends Element = HTMLElement>(name: string) =>
			root.querySelector<T>(`[data-${name}]`)!;

		const editorHost = q('editor');
		const tabBar = q('tabs');
		const tree = q('tree');
		const sidebar = q('sidebar');
		const sidebarToggle = q<HTMLButtonElement>('sidebar-toggle');
		const storageNote = q('storage');
		const output = q('output');
		const status = q('status');
		const splitEl = q('split');
		const gutterEl = q('gutter');
		const problems = q('problems');
		const problemsCount = q('problems-count');
		const problemsList = q<HTMLUListElement>('problems-list');
		const savestate = q('savestate');
		const cursorMeta = q('cursor');
		const versionMeta = q('version');

		const runBtn = q<HTMLButtonElement>('run');
		const runTarget = q('run-target');
		const stopBtn = q<HTMLButtonElement>('stop');
		const formatBtn = q<HTMLButtonElement>('format');
		const shareBtn = q<HTMLButtonElement>('share');
		const shareLabel = q('share-label');
		const formatLabel = q('format-label');
		const saveAsBtn = q<HTMLButtonElement>('save-as');
		const banner = q('banner');
		const bannerText = q('banner-text');
		const resetBtn = q<HTMLButtonElement>('reset');
		const newBtn = q<HTMLButtonElement>('new');
		const clearBtn = q<HTMLButtonElement>('clear');
		const problemsStripe = q<HTMLButtonElement>('problems-toggle');
		const layoutBtn = q<HTMLButtonElement>('layout-toggle');
		const layoutDivider = q<SVGPathElement>('layout-divider');
		const helpBtn = q<HTMLButtonElement>('help');
		const runKey = q('run-key');
		const scrim = q<HTMLButtonElement>('scrim');
		const drawerBtn = q<HTMLButtonElement>('drawer-open');
		const viewCodeBtn = q<HTMLButtonElement>('view-code');
		const viewOutputBtn = q<HTMLButtonElement>('view-output');
		const keybar = q('keybar');

		// The sidebar is a drawer and the panes always stack below this. The
		// same widths are in playground.css.
		const compactScreen = window.matchMedia('(max-width: 60rem)');
		const singlePane = window.matchMedia(
			'(max-width: 40rem), (max-width: 60rem) and (max-height: 30rem)'
		);
		const coarsePointer = window.matchMedia('(pointer: coarse)');
		// Not part of the session: a phone opening its drawer should not leave
		// the same browser's desktop layout changed, and a drawer left open
		// should not cover the editor on the next visit.
		let drawerOpen = false;

		const dialog = q<HTMLDialogElement>('dialog');
		const dialogTitle = q('dialog-title');
		const dialogBody = q('dialog-body');
		const dialogField = q('dialog-field');
		const dialogInput = q<HTMLInputElement>('dialog-input');
		const dialogCancel = q<HTMLButtonElement>('dialog-cancel');
		const dialogConfirm = q<HTMLButtonElement>('dialog-confirm');
		const helpDialog = q<HTMLDialogElement>('help-dialog');
		const helpClose = q<HTMLButtonElement>('help-close');
		const keysList = q('keys');

		/** macOS writes ⌘ where everyone else writes Ctrl. */
		const MAC = /mac|iphone|ipad/i.test(navigator.platform || navigator.userAgent);
		const MOD = MAC ? '⌘' : 'Ctrl';
		runKey.textContent = `${MOD} ↵`;

		/**
		 * Whether scripts survive a reload. False in Safari's private mode and
		 * wherever storage is denied — the playground still works, but it says
		 * so rather than quietly losing files.
		 */
		const persistent = isPersistent();
		storageNote.textContent = persistent
			? 'Saved in this browser.'
			: 'Storage is unavailable — scripts last for this session only.';
		storageNote.classList.toggle('pg-warn', !persistent);

		let session: Session = readSession();

		// ---- what is open ----------------------------------------------------

		/**
		 * The editor's text for each open tab.
		 *
		 * A user script's text lives in storage and is read back from there;
		 * an example's and a shared program's live here, because an example
		 * is never overwritten and a shared program has nowhere to go until
		 * it is saved. Keyed by `tabKey`, so switching tabs restores exactly
		 * what was in the editor.
		 */
		const buffers = new Map<string, string>();
		/** Tabs whose edits have nowhere to be saved. */
		const dirty = new Set<string>();

		function tabKey(tab: OpenTab): string {
			return `${tab.kind}:${tab.id}`;
		}

		function activeTab(): OpenTab | null {
			return session.tabs[session.active] ?? null;
		}

		function tabLabel(tab: OpenTab): string {
			if (tab.kind === 'user') return getScript(tab.id)?.name ?? 'untitled.sau';
			if (tab.kind === 'shared') return tab.id;
			return `${EXAMPLES.find((e) => e.id === tab.id)?.label ?? tab.id}`;
		}

		function tabSource(tab: OpenTab): string {
			const key = tabKey(tab);
			const held = buffers.get(key);
			if (held !== undefined) return held;
			if (tab.kind === 'user') return getScript(tab.id)?.source ?? '';
			if (tab.kind === 'shared') return tab.source ?? '';
			return EXAMPLES.find((e) => e.id === tab.id)?.source ?? '';
		}

		function persist() {
			// The editor's current text belongs to the active tab before
			// anything about the arrangement is written down.
			const tab = activeTab();
			if (tab) buffers.set(tabKey(tab), view.state.doc.toString());
			writeSession({
				...session,
				tabs: session.tabs.map((t) =>
					t.kind === 'shared' ? { ...t, source: buffers.get(tabKey(t)) ?? t.source } : t
				),
			});
		}

		// ---- the editor ------------------------------------------------------

		// Colours come from CSS variables so the editor follows Starlight's
		// light/dark toggle without re-creating the EditorView.
		const highlight = HighlightStyle.define([
			{ tag: t.comment, color: 'var(--cm-comment)', fontStyle: 'italic' },
			{ tag: t.string, color: 'var(--cm-string)' },
			{ tag: t.number, color: 'var(--cm-number)' },
			{ tag: t.atom, color: 'var(--cm-atom)' },
			{ tag: t.keyword, color: 'var(--cm-keyword)' },
			{ tag: t.definitionKeyword, color: 'var(--cm-decl)', fontWeight: '600' },
			{ tag: t.operatorKeyword, color: 'var(--cm-keyword)' },
			{ tag: t.self, color: 'var(--cm-self)', fontStyle: 'italic' },
			{ tag: t.typeName, color: 'var(--cm-type)' },
			{ tag: t.function(t.variableName), color: 'var(--cm-fn)' },
			{ tag: t.variableName, color: 'var(--cm-text)' },
			{ tag: t.operator, color: 'var(--cm-op)' },
			{ tag: t.bracket, color: 'var(--cm-op)' },
			{ tag: t.punctuation, color: 'var(--cm-punct)' },
		]);

		const theme = EditorView.theme({
			// Typography is set on the editor root, not partway down the tree.
			// CodeMirror measures line heights with probe elements of its own,
			// and those inherit from `.cm-editor` — so if the root's
			// line-height differs from the lines' (here Starlight's body 1.75
			// was reaching `.cm-editor` while `.cm-scroller` had 1.6), it
			// caches wrong heights, sizes every gutter element from them, and
			// the numbers drift out of step with the code.
			'&': {
				height: '100%',
				fontSize: '0.85rem',
				fontFamily: 'var(--saule-font-mono)',
				lineHeight: '1.6',
				backgroundColor: 'transparent',
				color: 'var(--cm-text)',
			},
			// Deliberately no vertical padding on `.cm-content`: CodeMirror
			// aligns the gutter against it, and padding one without the other
			// offsets the line numbers from their lines. Breathing room is
			// added on the `.pg-editor` wrapper instead, outside CodeMirror's
			// own layout. Line height is set on the scroller so `.cm-content`
			// and `.cm-gutters` — its two children — inherit the same value.
			'.cm-content': { fontFamily: 'var(--saule-font-mono)' },
			'.cm-scroller': { fontFamily: 'var(--saule-font-mono)', lineHeight: '1.6' },
			'.cm-gutters': {
				backgroundColor: 'transparent',
				border: 'none',
				color: 'var(--cm-gutter)',
			},
			'.cm-activeLine': { backgroundColor: 'var(--cm-active)' },
			'.cm-activeLineGutter': {
				backgroundColor: 'var(--cm-active)',
				color: 'var(--cm-text)',
			},
			'.cm-cursor': { borderLeftColor: 'var(--cm-text)' },
			'&.cm-focused': { outline: 'none' },
			// Selection is drawn by `drawSelection` as absolutely positioned
			// rectangles, not by the browser: the native `::selection` inside
			// `.cm-line` is forced transparent at `Prec.highest`, so styling
			// it here would do nothing. What has to be overridden instead is
			// CodeMirror's base theme, and its selectors are deliberately
			// specific:
			//
			//   &light .cm-selectionBackground                                  (3)
			//   &light.cm-focused > .cm-scroller > .cm-selectionLayer
			//       .cm-selectionBackground                                     (5)
			//
			// A bare `.cm-selectionBackground` is 2 and silently loses — which
			// is why the editor used to select in CodeMirror's default
			// lavender however this theme was written. Adding `.cm-editor`
			// puts each rule one class above its counterpart. (`&light` is the
			// branch in play because this theme does not declare itself dark;
			// it tracks Starlight's toggle through CSS variables instead.)
			'&.cm-editor .cm-selectionLayer .cm-selectionBackground': {
				backgroundColor: 'var(--cm-selection)',
			},
			'&.cm-editor.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground': {
				backgroundColor: 'var(--cm-selection)',
			},
		});

		/**
		 * The line a run failed on, highlighted until the next edit.
		 *
		 * The squiggles come from the linter and describe *compile* errors.
		 * A run-time failure has no linter to report it — the program
		 * compiled — so it is drawn here instead.
		 */
		const setErrorLine = StateEffect.define<number | null>();
		const errorLine = StateField.define<DecorationSet>({
			create: () => Decoration.none,
			update(value, tr) {
				value = value.map(tr.changes);
				for (const effect of tr.effects) {
					if (!effect.is(setErrorLine)) continue;
					value =
						effect.value === null
							? Decoration.none
							: Decoration.set([
									Decoration.line({ class: 'cm-errorLine' }).range(effect.value),
								]);
				}
				return tr.docChanged ? Decoration.none : value;
			},
			provide: (f) => EditorView.decorations.from(f),
		});

		/** True while `load` is writing the document, so autosave sits it out. */
		let applying = false;

		const view = new EditorView({
			parent: editorHost,
			state: EditorState.create({
				doc: '',
				extensions: [
					lineNumbers(),
					highlightActiveLineGutter(),
					highlightSpecialChars(),
					history(),
					drawSelection(),
					rectangularSelection(),
					highlightActiveLine(),
					highlightSelectionMatches(),
					bracketMatching(),
					closeBrackets(),
					codeFolding(),
					foldGutter(),
					lintGutter(),
					linter(lintSource, { delay: 400 }),
					indentUnit.of('    '),
					saule(),
					sauleDocs(),
					syntaxHighlighting(highlight),
					errorLine,
					theme,
					EditorView.lineWrapping,
					// Without these a phone capitalises the first letter of each
					// line and "corrects" identifiers into English.
					EditorView.contentAttributes.of({
						autocapitalize: 'off',
						autocorrect: 'off',
						spellcheck: 'false',
					}),
					keymap.of([
						{ key: 'Mod-Enter', run: () => (void run(), true) },
						{ key: 'Mod-s', run: () => (void run(), true), preventDefault: true },
						{ key: 'Shift-Alt-f', run: () => (void format(), true) },
						...closeBracketsKeymap,
						...defaultKeymap,
						...historyKeymap,
						...searchKeymap,
						...foldKeymap,
						indentWithTab,
					]),
					EditorView.updateListener.of((update) => {
						if (update.docChanged && !applying) onEdit();
						if (update.selectionSet || update.docChanged) showCursor();
						if (update.focusChanged) syncKeybar();
					}),
				],
			}),
		});

		// ---- live diagnostics -------------------------------------------------

		/**
		 * Compile the buffer and hand the linter what the compiler said.
		 *
		 * `checkSaule` resolves to `null` when a newer request has already
		 * superseded this one; returning the previous set for that case is
		 * what keeps the squiggles from flickering off and back on with
		 * every keystroke.
		 */
		let lastDiagnostics: CmDiagnostic[] = [];

		async function lintSource(view: EditorView): Promise<CmDiagnostic[]> {
			const source = view.state.doc.toString();
			let found: Diagnostic[] | null;
			try {
				found = await checkSaule(source);
			} catch {
				// The runtime could not start. The editor still works; it
				// just has nothing to underline.
				return [];
			}
			if (found === null) return lastDiagnostics;

			const doc = view.state.doc;
			lastDiagnostics = found.map((d) => {
				const from = d.span ? toCharOffset(source, d.span.start) : 0;
				const to = d.span ? toCharOffset(source, d.span.end) : 0;
				return {
					// A diagnostic with no span belongs to the whole program;
					// anchoring it to the first line is the least misleading
					// place to put it.
					from: Math.min(from, doc.length),
					to: Math.min(Math.max(to, from + 1), doc.length),
					severity: d.severity === 'warning' ? 'warning' : 'error',
					source: d.phase,
					message: d.help ? `${d.message}\n\nhelp: ${d.help}` : d.message,
				} satisfies CmDiagnostic;
			});
			showProblems(found, source);
			return lastDiagnostics;
		}

		/**
		 * A UTF-8 byte offset as a JavaScript string index.
		 *
		 * The compiler reports byte offsets, because that is what it works
		 * in; JavaScript strings are indexed in UTF-16 code units. The two
		 * agree for ASCII and diverge the moment a program contains a
		 * non-ASCII string literal or comment — and an editor that
		 * underlines the wrong characters is worse than one that does not
		 * underline at all.
		 */
		function toCharOffset(source: string, byteOffset: number): number {
			let bytes = 0;
			let i = 0;
			while (i < source.length && bytes < byteOffset) {
				const code = source.codePointAt(i)!;
				if (code > 0xffff) {
					bytes += 4;
					i += 2;
				} else {
					bytes += code > 0x7ff ? 3 : code > 0x7f ? 2 : 1;
					i += 1;
				}
			}
			return i;
		}

		/** Line and column for a byte offset, for the problems list. */
		function locate(source: string, byteOffset: number): { line: number; column: number } {
			const at = toCharOffset(source, byteOffset);
			const before = source.slice(0, at);
			const nl = before.lastIndexOf('\n');
			return { line: before.split('\n').length, column: at - nl };
		}

		function showProblems(found: Diagnostic[], source: string) {
			// The stripe is the whole indication when there is nothing
			// wrong: a tool window that opens itself on every keystroke
			// would take the editor's room away mid-sentence.
			problemsStripe.hidden = found.length === 0;
			if (!found.length) {
				problems.hidden = true;
				problemsStripe.classList.remove('pg-stripe-on');
				return;
			}

			const errors = found.filter((d) => d.severity === 'error').length;
			const warnings = found.length - errors;
			problemsStripe.classList.toggle('pg-stripe-error', errors > 0);
			problemsCount.textContent = [
				errors ? `${errors} error${errors === 1 ? '' : 's'}` : '',
				warnings ? `${warnings} warning${warnings === 1 ? '' : 's'}` : '',
			]
				.filter(Boolean)
				.join(', ');

			problemsList.replaceChildren(
				...found.map((d) => {
					const li = document.createElement('li');
					li.className = d.severity === 'error' ? 'pg-problem-error' : 'pg-problem-warning';
					const button = document.createElement('button');
					button.type = 'button';
					if (d.span) {
						const { line, column } = locate(source, d.span.start);
						const where = document.createElement('span');
						where.className = 'pg-problem-at';
						where.textContent = `${line}:${column}`;
						button.append(where);
						button.addEventListener('click', () => jumpTo(d.span!.start, source));
					}
					button.append(document.createTextNode(d.message));
					li.append(button);
					return li;
				})
			);
		}

		/** Put the cursor on a diagnostic's position and scroll it into view. */
		function jumpTo(byteOffset: number, source: string) {
			const at = Math.min(toCharOffset(source, byteOffset), view.state.doc.length);
			showPane('code');
			view.dispatch({
				selection: { anchor: at },
				effects: EditorView.scrollIntoView(at, { y: 'center' }),
			});
			view.focus();
		}

		problemsStripe.addEventListener('click', () => {
			const open = problems.hasAttribute('hidden');
			problems.toggleAttribute('hidden', !open);
			problemsStripe.classList.toggle('pg-stripe-on', open);
		});

		function showCursor() {
			const head = view.state.selection.main.head;
			const line = view.state.doc.lineAt(head);
			cursorMeta.textContent = `Ln ${line.number}, Col ${head - line.from + 1}`;
		}

		// ---- the sidebar ------------------------------------------------------

		function renderTree() {
			tree.replaceChildren();

			// Your own files come first and are always here, listed or
			// not. Ten examples under four headings is enough to push a
			// short list of scripts off the bottom of a laptop's sidebar,
			// and the scripts are what someone came back for.
			tree.append(groupHeading('My scripts'));
			const scripts = listScripts();
			if (scripts.length) {
				const list = document.createElement('ul');
				list.className = 'pg-tree-list';
				for (const script of scripts) {
					list.append(treeItem({ kind: 'user', id: script.id }, script.name, script));
				}
				tree.append(list);
			} else {
				const empty = document.createElement('p');
				empty.className = 'pg-tree-empty';
				empty.textContent = 'Nothing yet — press + to start one.';
				tree.append(empty);
			}

			// Examples fold away as one category. `<details>` rather than a
			// button and a class: the open/closed state, the keyboard
			// behaviour and the semantics come with it.
			const category = document.createElement('details');
			category.className = 'pg-tree-category';
			category.open = session.examples;
			category.addEventListener('toggle', () => {
				session.examples = category.open;
				persist();
			});

			const summary = document.createElement('summary');
			summary.className = 'pg-tree-group pg-tree-summary';
			const chevron = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
			chevron.setAttribute('class', 'pg-tree-chevron');
			chevron.setAttribute('viewBox', '0 0 16 16');
			chevron.setAttribute('width', '10');
			chevron.setAttribute('height', '10');
			chevron.setAttribute('aria-hidden', 'true');
			const arm = document.createElementNS('http://www.w3.org/2000/svg', 'path');
			arm.setAttribute('d', 'm6 3 5 5-5 5');
			arm.setAttribute('fill', 'none');
			arm.setAttribute('stroke', 'currentColor');
			arm.setAttribute('stroke-width', '2');
			chevron.append(arm);
			summary.append(chevron, document.createTextNode('Examples'));
			category.append(summary);

			// Group order follows first appearance in EXAMPLES, so the array
			// is the reading order and there is no second list to maintain.
			const groups = new Map<string, typeof EXAMPLES>();
			for (const example of EXAMPLES) {
				const list = groups.get(example.group);
				if (list) list.push(example);
				else groups.set(example.group, [example]);
			}
			for (const [name, examples] of groups) {
				const heading = groupHeading(name);
				heading.classList.add('pg-tree-subgroup');
				category.append(heading);
				const list = document.createElement('ul');
				list.className = 'pg-tree-list pg-tree-sublist';
				for (const example of examples) {
					list.append(treeItem({ kind: 'example', id: example.id }, example.label));
				}
				category.append(list);
			}
			tree.append(category);
		}

		function groupHeading(text: string): HTMLElement {
			const h = document.createElement('h3');
			h.className = 'pg-tree-group';
			h.textContent = text;
			return h;
		}

		function treeItem(tab: OpenTab, label: string, script?: UserScript): HTMLElement {
			const li = document.createElement('li');
			li.className = 'pg-tree-item';

			const open = document.createElement('button');
			open.type = 'button';
			open.className = 'pg-tree-open';
			open.textContent = label;
			const current = activeTab();
			if (current && tabKey(current) === tabKey(tab)) open.classList.add('pg-tree-current');
			open.addEventListener('click', () => openTab(tab));
			li.append(open);

			if (script) {
				const menu = document.createElement('span');
				menu.className = 'pg-tree-actions';
				menu.append(
					iconButton('Rename', 'M11.5 2.5 13.5 4.5 5 13H3v-2l8.5-8.5Z', () =>
						void renameFlow(script)
					),
					iconButton('Delete', 'M3 5h10M6.5 5V3.5h3V5M5 5l.7 8.5h4.6L11 5', () =>
						void deleteFlow(script)
					)
				);
				li.append(menu);
			}
			return li;
		}

		function iconButton(label: string, path: string, onClick: () => void): HTMLButtonElement {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'pg-icon pg-icon-sm';
			button.title = label;
			button.innerHTML =
				`<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">` +
				`<path d="${path}" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`;
			const sr = document.createElement('span');
			sr.className = 'sr-only';
			sr.textContent = label;
			button.append(sr);
			button.addEventListener('click', (event) => {
				event.stopPropagation();
				onClick();
			});
			return button;
		}

		// ---- tabs --------------------------------------------------------------

		function renderTabs() {
			tabBar.replaceChildren();
			session.tabs.forEach((tab, i) => {
				const key = tabKey(tab);
				const el = document.createElement('div');
				el.className = 'pg-tab';
				if (i === session.active) el.classList.add('pg-tab-active');
				if (dirty.has(key)) el.classList.add('pg-tab-dirty');

				const label = document.createElement('button');
				label.type = 'button';
				label.className = 'pg-tab-label';
				label.setAttribute('role', 'tab');
				label.setAttribute('aria-selected', String(i === session.active));
				label.textContent = tabLabel(tab);
				if (tab.kind !== 'user') {
					const badge = document.createElement('span');
					badge.className = 'pg-tab-badge';
					badge.textContent = tab.kind === 'shared' ? 'link' : 'example';
					label.append(badge);
				}
				label.addEventListener('click', () => {
					showPane('code');
					activate(i);
				});
				el.append(label);

				const close = document.createElement('button');
				close.type = 'button';
				close.className = 'pg-tab-close';
				close.title = 'Close';
				close.textContent = '×';
				close.addEventListener('click', (event) => {
					event.stopPropagation();
					void closeTab(i);
				});
				el.append(close);

				// Middle-click closes, as it does in every editor and every
				// browser. `auxclick` rather than `click`, which only fires
				// for the primary button.
				el.addEventListener('auxclick', (event) => {
					if (event.button !== 1) return;
					event.preventDefault();
					void closeTab(i);
				});
				// A middle *press* starts Chrome's autoscroll and pastes the
				// primary selection on Linux. Neither belongs on a tab, and
				// both happen before `auxclick` would get the chance to say
				// so.
				el.addEventListener('mousedown', (event) => {
					if (event.button === 1) event.preventDefault();
				});

				tabBar.append(el);
			});

			const add = document.createElement('button');
			add.type = 'button';
			add.className = 'pg-tab-add';
			add.title = 'New script';
			add.textContent = '+';
			add.addEventListener('click', () => void newFlow());
			tabBar.append(add);

			// Now that the strip scrolls, the tab in front can be off the
			// end of it — opening one from the sidebar would otherwise
			// change the editor with nothing on the strip to show it had.
			const current = tabBar.children[session.active];
			current?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
		}

		/*
		 * The wheel scrolls the strip sideways.
		 *
		 * A tab strip only ever overflows horizontally, and a mouse only
		 * reports `deltaY` — so without this the wheel does nothing at all
		 * over the one part of the page that has somewhere to go. A
		 * trackpad's horizontal gesture already arrives as `deltaX` and is
		 * left to the browser.
		 *
		 * `passive: false` because the default has to be cancellable;
		 * `preventDefault` only when the strip can actually move, so a
		 * wheel over a strip with nothing to scroll still reaches whatever
		 * is behind it.
		 */
		tabBar.addEventListener(
			'wheel',
			(event) => {
				if (event.deltaY === 0 || event.shiftKey) return;
				const room = tabBar.scrollWidth - tabBar.clientWidth;
				if (room <= 0) return;
				// Firefox reports lines rather than pixels for a mouse wheel.
				const step = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : 1;
				const next = Math.min(room, Math.max(0, tabBar.scrollLeft + event.deltaY * step));
				if (next === tabBar.scrollLeft) return;
				tabBar.scrollLeft = next;
				event.preventDefault();
			},
			{ passive: false }
		);

		/** Put `tab` in front, opening it if it is not already a tab. */
		function openTab(tab: OpenTab) {
			closeDrawer();
			showPane('code');
			const key = tabKey(tab);
			const at = session.tabs.findIndex((t) => tabKey(t) === key);
			if (at !== -1) {
				activate(at);
				return;
			}
			persist();
			session.tabs.push(tab);
			activate(session.tabs.length - 1);
		}

		/**
		 * Put the tab at `index` in the editor.
		 *
		 * `stash` hands the editor's current text back to the tab losing
		 * focus, which is right when switching between two live tabs and
		 * wrong everywhere else: a caller that has just closed a tab, reset
		 * an example or forked one into a script has already decided what
		 * that buffer should be, and saving over it would restore exactly
		 * the text it meant to discard.
		 */
		function activate(index: number, stash = true) {
			if (stash && index === session.active && buffers.has(tabKey(session.tabs[index]!))) {
				// Already in front, and its text is already in the editor.
				view.focus();
				return;
			}
			if (stash) {
				const leaving = activeTab();
				if (leaving) buffers.set(tabKey(leaving), view.state.doc.toString());
			}

			session.active = Math.max(0, Math.min(index, session.tabs.length - 1));
			const tab = activeTab();
			if (!tab) return;

			applying = true;
			view.dispatch({
				changes: { from: 0, to: view.state.doc.length, insert: tabSource(tab) },
				selection: { anchor: 0 },
			});
			applying = false;

			renderTabs();
			renderTree();
			applyMode();
			clearOutput();
			persist();
			showCursor();
			view.focus();
		}

		async function closeTab(index: number) {
			const tab = session.tabs[index];
			if (!tab) return;
			if (!(await confirmDiscard(tab))) return;

			buffers.delete(tabKey(tab));
			dirty.delete(tabKey(tab));
			session.tabs.splice(index, 1);
			if (!session.tabs.length) {
				// Never leave an empty editor: the default example is the
				// floor, as it is on a first visit.
				session.tabs.push({ kind: 'example', id: DEFAULT_EXAMPLE.id });
				session.active = 0;
			} else if (session.active >= index) {
				session.active = Math.max(0, session.active - (session.active === index ? 0 : 1));
				session.active = Math.min(session.active, session.tabs.length - 1);
			}
			activate(session.active, false);
		}

		/** Show the actions that make sense for what is open. */
		function applyMode() {
			const tab = activeTab();
			resetBtn.hidden = tab?.kind !== 'example';
			// The banner is the whole explanation for a program that is not
			// yours, so it says which kind it is rather than leaving two
			// buttons to be worked out.
			banner.hidden = !tab || tab.kind === 'user';
			if (tab?.kind === 'example') {
				bannerText.textContent =
					'An example. Editing it never overwrites it — save a copy to keep your changes.';
			} else if (tab?.kind === 'shared') {
				bannerText.textContent = 'Opened from a shared link. Save a copy to keep it.';
			}
			runTarget.textContent = tab ? tabLabel(tab) : 'Run';
			setSaveState();
		}

		function setSaveState(state?: 'saving') {
			const tab = activeTab();
			savestate.className = 'pg-meta';
			if (!tab) {
				savestate.textContent = '';
				return;
			}
			if (state === 'saving') {
				savestate.textContent = 'saving…';
				return;
			}
			if (tab.kind === 'user') {
				savestate.textContent = persistent ? 'saved' : 'this session only';
				savestate.classList.add(persistent ? 'pg-ok' : 'pg-warn');
			} else if (dirty.has(tabKey(tab))) {
				savestate.textContent = 'unsaved';
				savestate.classList.add('pg-warn');
			} else {
				savestate.textContent = tab.kind === 'shared' ? 'from a link' : 'example';
			}
		}

		let saveTimer: number | undefined;

		/**
		 * Every edit either autosaves, or is flagged as having nowhere to go.
		 * Examples and shared programs are never written over: editing one
		 * just offers "Save as my script".
		 */
		function onEdit() {
			const tab = activeTab();
			if (!tab) return;
			// The hash describes a program that no longer matches the buffer.
			if (window.location.hash) historyReplace('');

			if (tab.kind !== 'user') {
				if (!dirty.has(tabKey(tab))) {
					dirty.add(tabKey(tab));
					renderTabs();
					setSaveState();
				}
				return;
			}

			setSaveState('saving');
			window.clearTimeout(saveTimer);
			saveTimer = window.setTimeout(() => {
				const current = activeTab();
				if (current?.kind !== 'user') return;
				if (!updateScript(current.id, view.state.doc.toString())) {
					// Deleted in another tab; fall back rather than resurrect it.
					void closeTab(session.active);
					return;
				}
				setSaveState();
			}, 400);
		}

		/** Flush a pending autosave, so an action never races the debounce. */
		function flushSave() {
			if (saveTimer === undefined) return;
			window.clearTimeout(saveTimer);
			saveTimer = undefined;
			const tab = activeTab();
			if (tab?.kind === 'user') updateScript(tab.id, view.state.doc.toString());
		}

		/** Ask before throwing away edits that are not being autosaved. */
		async function confirmDiscard(tab: OpenTab): Promise<boolean> {
			if (tab.kind === 'user' || !dirty.has(tabKey(tab))) return true;
			const answer = await openDialog({
				title: 'Discard your changes?',
				body: 'This program is not one of your scripts, so its edits are not saved. Save it as a script first to keep them.',
				confirm: 'Discard',
				danger: true,
			});
			return answer !== null;
		}

		// ---- scripts of your own ------------------------------------------------

		async function newFlow() {
			const name = await openDialog({
				title: 'New script',
				input: uniqueName('scratch.sau'),
				confirm: 'Create',
			});
			if (name === null) return;
			const script = createScript(name, STARTER);
			buffers.set(`user:${script.id}`, STARTER);
			openTab({ kind: 'user', id: script.id });
		}

		async function renameFlow(script: UserScript) {
			const name = await openDialog({
				title: 'Rename script',
				input: script.name,
				confirm: 'Rename',
			});
			if (name === null) return;
			renameScript(script.id, name || script.name);
			renderTabs();
			renderTree();
			applyMode();
		}

		async function deleteFlow(script: UserScript) {
			const answer = await openDialog({
				title: `Delete ${script.name}?`,
				body: 'This cannot be undone.',
				confirm: 'Delete',
				danger: true,
			});
			if (answer === null) return;
			window.clearTimeout(saveTimer);
			saveTimer = undefined;
			const at = session.tabs.findIndex((t) => t.kind === 'user' && t.id === script.id);
			deleteScript(script.id);
			buffers.delete(`user:${script.id}`);
			if (at !== -1) {
				session.tabs.splice(at, 1);
				if (!session.tabs.length) session.tabs.push({ kind: 'example', id: DEFAULT_EXAMPLE.id });
				session.active = Math.min(session.active, session.tabs.length - 1);
				activate(session.active, false);
			} else {
				renderTree();
			}
		}

		newBtn.addEventListener('click', () => void newFlow());

		saveAsBtn.addEventListener('click', async () => {
			const tab = activeTab();
			if (!tab || tab.kind === 'user') return;
			const suggested = tab.kind === 'shared' ? tab.id : `${tab.id}.sau`;
			const name = await openDialog({
				title: 'Save as my script',
				body: 'Saved in this browser only. Use Copy link to take it elsewhere.',
				input: uniqueName(suggested),
				confirm: 'Save',
			});
			if (name === null) return;
			const script = createScript(name, view.state.doc.toString());
			// The fork replaces the tab it came from: two tabs showing the
			// same text, one of them saving and one not, is a trap.
			dirty.delete(tabKey(tab));
			buffers.delete(tabKey(tab));
			buffers.set(`user:${script.id}`, script.source);
			session.tabs[session.active] = { kind: 'user', id: script.id };
			activate(session.active, false);
		});

		resetBtn.addEventListener('click', () => {
			const tab = activeTab();
			if (tab?.kind !== 'example') return;
			dirty.delete(tabKey(tab));
			buffers.delete(tabKey(tab));
			renderTabs();
			activate(session.active, false);
		});

		// ---- the dialog ----------------------------------------------------------

		interface DialogOptions {
			title: string;
			body?: string;
			/** Initial text. Omit for a confirmation with no field. */
			input?: string;
			confirm: string;
			danger?: boolean;
		}

		/** Resolves to the typed name, '' for a fieldless confirm, or null. */
		function openDialog(options: DialogOptions): Promise<string | null> {
			const wantsInput = options.input !== undefined;

			dialogTitle.textContent = options.title;
			dialogBody.textContent = options.body ?? '';
			dialogBody.hidden = !options.body;
			dialogField.hidden = !wantsInput;
			dialogInput.value = options.input ?? '';
			dialogInput.disabled = !wantsInput;
			dialogConfirm.textContent = options.confirm;
			dialogConfirm.classList.toggle('pg-btn-danger', !!options.danger);
			dialogConfirm.classList.toggle('pg-btn-primary', !options.danger);

			return new Promise((resolve) => {
				dialog.addEventListener(
					'close',
					() => {
						if (dialog.returnValue !== 'confirm') return resolve(null);
						resolve(wantsInput ? normaliseName(dialogInput.value) : '');
					},
					{ once: true }
				);
				dialog.returnValue = '';
				dialog.showModal();
				dialog.scrollTop = 0;
				if (wantsInput) dialogInput.select();
			});
		}

		// Cancel is a plain button rather than a second submit, so Enter in the
		// text field always means "confirm" whatever the DOM order is.
		dialogCancel.addEventListener('click', () => dialog.close(''));
		// Implicit submission would normally handle Enter, but it is easy to
		// suppress by accident (an outer keydown handler, an automated key
		// event) and a name dialog that ignores Enter feels broken. Take it
		// over explicitly, cancelling the implicit path so it fires once.
		dialogInput.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter') return;
			event.preventDefault();
			dialogConfirm.click();
		});
		// Clicking the backdrop — anywhere outside the form — cancels too.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close('');
		});

		// ---- help ------------------------------------------------------------------

		const SHORTCUTS: [string, string][] = [
			[`${MOD} ↵`, 'Run the program'],
			['Esc', 'Stop a running program'],
			['Shift Alt F', 'Format'],
			[`${MOD} Space`, 'Completions'],
			[`${MOD} F`, 'Find in the program'],
			[`${MOD} Z  /  ${MOD} Shift Z`, 'Undo / redo'],
			['Tab', 'Indent the selection'],
			[`${MOD} B`, 'Show or hide the sidebar'],
			[`${MOD} Alt N`, 'New script'],
			['?', 'This list'],
		];

		keysList.replaceChildren(
			...SHORTCUTS.flatMap(([keys, what]) => {
				const dt = document.createElement('dt');
				for (const key of keys.split(' ')) {
					if (!key) continue;
					if (key === '/') {
						dt.append(document.createTextNode(' or '));
						continue;
					}
					const kbd = document.createElement('kbd');
					kbd.textContent = key;
					dt.append(kbd);
				}
				const dd = document.createElement('dd');
				dd.textContent = what;
				return [dt, dd];
			})
		);

		/**
		 * Open the help, at the top of it.
		 *
		 * `autofocus` on the dialog is the standards-blessed way to stop the
		 * browser reaching for the first focusable descendant — the Close
		 * button, right at the bottom — and scrolling it into view. Chrome
		 * does it anyway, so the scroll is also put back explicitly. Both,
		 * because the attribute is the correct thing to say and the
		 * assignment is the thing that holds.
		 */
		function openHelp() {
			helpDialog.showModal();
			helpDialog.scrollTop = 0;
		}

		helpBtn.addEventListener('click', openHelp);
		helpClose.addEventListener('click', () => helpDialog.close());
		helpDialog.addEventListener('click', (event) => {
			if (event.target === helpDialog) helpDialog.close();
		});

		// ---- layout ------------------------------------------------------------------

		/**
		 * The arrangement actually on screen, which is the saved one only
		 * where it fits. `session.layout` is left alone so that a narrow window
		 * does not rewrite what the visitor chose.
		 */
		function activeLayout(): Session['layout'] {
			return compactScreen.matches ? 'stacked' : session.layout;
		}

		function applyLayout() {
			root.dataset.layout = activeLayout();
			splitEl.style.setProperty('--pg-split', String(session.split));
			gutterEl.setAttribute(
				'aria-orientation',
				activeLayout() === 'side-by-side' ? 'vertical' : 'horizontal'
			);
			layoutBtn.title =
				session.layout === 'side-by-side'
					? 'Stack the panes instead'
					: 'Put the panes side by side';
			layoutDivider.setAttribute('d', session.layout === 'side-by-side' ? 'M8 2.5v11' : 'M1.5 8h13');
			const showSidebar = compactScreen.matches ? drawerOpen : session.sidebar;
			root.classList.toggle('pg-no-sidebar', !showSidebar);
			sidebar.hidden = !showSidebar;
			sidebarToggle.setAttribute('aria-expanded', String(showSidebar));
			sidebarToggle.title = showSidebar ? 'Hide the sidebar' : 'Show the sidebar';
			drawerBtn.setAttribute('aria-expanded', String(showSidebar));
			scrim.hidden = !(compactScreen.matches && drawerOpen);
		}

		layoutBtn.addEventListener('click', () => {
			session.layout = session.layout === 'side-by-side' ? 'stacked' : 'side-by-side';
			applyLayout();
			persist();
		});

		function closeDrawer() {
			if (!drawerOpen) return;
			drawerOpen = false;
			applyLayout();
		}

		function toggleSidebar() {
			if (compactScreen.matches) {
				drawerOpen = !drawerOpen;
				applyLayout();
				return;
			}
			session.sidebar = !session.sidebar;
			applyLayout();
			persist();
		}

		sidebarToggle.addEventListener('click', toggleSidebar);
		drawerBtn.addEventListener('click', toggleSidebar);
		scrim.addEventListener('click', closeDrawer);

		compactScreen.addEventListener('change', () => {
			drawerOpen = false;
			applyLayout();
			syncViewport();
		});

		/** Which pane is in front. Only matters where `singlePane` matches. */
		function showPane(pane: 'code' | 'output') {
			root.dataset.view = pane;
			viewCodeBtn.setAttribute('aria-pressed', String(pane === 'code'));
			viewOutputBtn.setAttribute('aria-pressed', String(pane === 'output'));
			if (pane === 'code') view.requestMeasure();
		}

		viewCodeBtn.addEventListener('click', () => showPane('code'));
		viewOutputBtn.addEventListener('click', () => showPane('output'));

		/**
		 * The row of keys above a phone's keyboard.
		 *
		 * `mousedown` is cancelled on the row itself, because a button taking
		 * focus would blur the editor and close the keyboard these keys exist
		 * to sit on top of.
		 */
		function typeKey(text: string) {
			const bracket = insertBracket(view.state, text);
			view.dispatch(
				bracket ?? {
					...view.state.replaceSelection(text),
					scrollIntoView: true,
					userEvent: 'input.type',
				}
			);
		}

		const KEYS: [label: string, title: string, press: () => void, className?: string][] = [
			['▶', 'Run', () => void run(), 'pg-key-run'],
			['⇥', 'Indent', () => void indentMore(view)],
			...['{', '}', '(', ')', '[', ']', '"', '=', ':', '.', ',', '<', '>', '+', '-', '*', '/', '_'].map(
				(key): [string, string, () => void] => [key, `Type ${key}`, () => typeKey(key)]
			),
			['Undo', 'Undo', () => void undo(view), 'pg-key-word'],
			['Redo', 'Redo', () => void redo(view), 'pg-key-word'],
			['Done', 'Hide the keyboard', () => view.contentDOM.blur(), 'pg-key-word'],
		];

		keybar.replaceChildren(
			...KEYS.map(([label, title, press, className]) => {
				const key = document.createElement('button');
				key.type = 'button';
				key.className = `pg-key ${className ?? ''}`.trim();
				key.textContent = label;
				key.title = title;
				key.setAttribute('aria-label', title);
				key.tabIndex = -1;
				key.addEventListener('click', press);
				return key;
			})
		);
		keybar.addEventListener('mousedown', (event) => event.preventDefault());

		function syncKeybar() {
			keybar.hidden = !(coarsePointer.matches && view.hasFocus);
		}

		/**
		 * Fit the page to what the keyboard leaves.
		 *
		 * `100dvh` does not shrink for an on-screen keyboard, and iOS slides
		 * the whole page up as well, so the only honest numbers are the visual
		 * viewport's. While no keyboard is up the properties are removed and
		 * the stylesheet's `100dvh` applies. Pinch zoom also shrinks the visual
		 * viewport, which is not a keyboard and should move nothing.
		 */
		let keyboardUp = false;

		function syncViewport() {
			const viewport = window.visualViewport;
			if (!viewport) return;
			const up =
				compactScreen.matches &&
				viewport.scale < 1.01 &&
				window.innerHeight - viewport.height > 120;
			root.classList.toggle('pg-keyboard', up);
			if (up) {
				root.style.setProperty('--pg-vvh', `${viewport.height}px`);
				root.style.setProperty('--pg-vv-top', `${viewport.offsetTop}px`);
			} else {
				root.style.removeProperty('--pg-vvh');
				root.style.removeProperty('--pg-vv-top');
			}
			if (up && !keyboardUp && view.hasFocus) {
				view.dispatch({ effects: EditorView.scrollIntoView(view.state.selection.main.head) });
			}
			keyboardUp = up;
		}

		window.visualViewport?.addEventListener('resize', syncViewport);
		window.visualViewport?.addEventListener('scroll', syncViewport);

		/**
		 * Dragging the gutter.
		 *
		 * Pointer capture rather than document-level listeners: the pointer
		 * leaves the 6px gutter immediately, and without capture the drag
		 * would end the moment it did.
		 */
		gutterEl.addEventListener('pointerdown', (event) => {
			event.preventDefault();
			gutterEl.setPointerCapture(event.pointerId);
			const rect = splitEl.getBoundingClientRect();

			const move = (e: PointerEvent) => {
				const fraction =
					activeLayout() === 'side-by-side'
						? (e.clientX - rect.left) / rect.width
						: (e.clientY - rect.top) / rect.height;
				session.split = Math.min(0.8, Math.max(0.2, fraction));
				splitEl.style.setProperty('--pg-split', String(session.split));
			};
			const up = (e: PointerEvent) => {
				gutterEl.releasePointerCapture(e.pointerId);
				gutterEl.removeEventListener('pointermove', move);
				gutterEl.removeEventListener('pointerup', up);
				persist();
			};
			gutterEl.addEventListener('pointermove', move);
			gutterEl.addEventListener('pointerup', up);
		});

		// A split that can only be dragged is a split keyboard users cannot
		// move at all.
		gutterEl.addEventListener('keydown', (event) => {
			const step = event.shiftKey ? 0.1 : 0.02;
			const back = activeLayout() === 'side-by-side' ? 'ArrowLeft' : 'ArrowUp';
			const forward = activeLayout() === 'side-by-side' ? 'ArrowRight' : 'ArrowDown';
			if (event.key !== back && event.key !== forward) return;
			event.preventDefault();
			session.split = Math.min(
				0.8,
				Math.max(0.2, session.split + (event.key === forward ? step : -step))
			);
			splitEl.style.setProperty('--pg-split', String(session.split));
			persist();
		});

		// ---- sharing --------------------------------------------------------------

		/**
		 * Programs travel in the URL fragment, base64url-encoded. The fragment
		 * never reaches the server, which matters on GitHub Pages where there
		 * is no server to reach — and it keeps whatever someone typed out of
		 * access logs.
		 */
		function encode(source: string): string {
			const bytes = new TextEncoder().encode(source);
			let binary = '';
			for (const byte of bytes) binary += String.fromCharCode(byte);
			return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
		}

		function decode(encoded: string): string | null {
			try {
				const padded = encoded.replace(/-/g, '+').replace(/_/g, '/');
				const binary = atob(padded);
				const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
				return new TextDecoder().decode(bytes);
			} catch {
				return null;
			}
		}

		function historyReplace(hash: string) {
			const url = new URL(window.location.href);
			url.hash = hash;
			window.history.replaceState(null, '', url.toString());
		}

		shareBtn.addEventListener('click', async () => {
			flushSave();
			const tab = activeTab();
			// The name rides along so the recipient opens `parser.sau`, not an
			// anonymous buffer — and so "Save as my script" can suggest it.
			const name = tab && tab.kind !== 'example' ? tabLabel(tab) : null;
			const parts = [`code=${encode(view.state.doc.toString())}`];
			if (name) parts.push(`name=${encode(name)}`);
			historyReplace(parts.join('&'));

			try {
				await navigator.clipboard.writeText(window.location.href);
				flash(shareLabel, 'Copied!');
			} catch {
				// Clipboard access can be denied; the URL bar still has the link.
				flash(shareLabel, 'In the URL bar');
			}
		});

		// ---- formatting --------------------------------------------------------------

		async function format() {
			const source = view.state.doc.toString();
			formatBtn.disabled = true;
			try {
				const result = await formatSaule(source);
				if (!result.ok || result.text === undefined) {
					// Nothing is laid out from a tree that did not parse, and
					// the linter is already underlining why.
					flash(formatLabel, 'Cannot format');
					return;
				}
				if (result.text === source) {
					flash(formatLabel, 'Already tidy');
					return;
				}
				// Replace the text, not the document: a full swap would lose
				// the cursor, and undo would swallow the whole file.
				const head = view.state.selection.main.head;
				view.dispatch({
					changes: { from: 0, to: view.state.doc.length, insert: result.text },
					selection: { anchor: Math.min(head, result.text.length) },
				});
			} catch (err) {
				flash(formatLabel, err instanceof RuntimeUnavailableError ? 'Unavailable' : 'Failed');
			} finally {
				formatBtn.disabled = false;
			}
		}

		/** Say something on a button for a moment, then put its label back. */
		function flash(label: Element, text: string) {
			const was = label.textContent;
			label.textContent = text;
			label.parentElement?.classList.add('pg-flashing');
			setTimeout(() => {
				label.textContent = was;
				label.parentElement?.classList.remove('pg-flashing');
			}, 1600);
		}

		formatBtn.addEventListener('click', () => void format());

		// ---- running ------------------------------------------------------------------

		function clearOutput() {
			output.replaceChildren(dim('Press Run to execute the program.'));
			status.textContent = '';
			status.className = 'pg-status';
		}

		function dim(text: string): HTMLElement {
			const span = document.createElement('span');
			span.className = 'pg-dim';
			span.textContent = text;
			return span;
		}

		function line(text: string, className?: string): HTMLElement {
			const span = document.createElement('span');
			if (className) span.className = className;
			span.textContent = text;
			return span;
		}

		/** Render a diagnostic the way the CLI does: phase, position, message, help. */
		function renderDiagnostic(d: Diagnostic, source: string): HTMLElement {
			const wrap = document.createElement('div');
			wrap.className = d.severity === 'error' ? 'pg-error' : 'pg-warning';

			wrap.append(line(`${d.phase} ${d.severity}`, 'pg-diag-label'));
			// Some errors carry no location at all — a runtime failure with no
			// frame to blame, say — and those simply go without one.
			if (d.span) {
				const { line: ln, column } = locate(source, d.span.start);
				const jump = document.createElement('button');
				jump.type = 'button';
				jump.className = 'pg-diag-loc';
				jump.textContent = ` (line ${ln}, column ${column})`;
				jump.addEventListener('click', () => jumpTo(d.span!.start, source));
				wrap.append(jump);
			}
			wrap.append(line(': '), line(d.message));

			if (d.help) {
				wrap.append(document.createElement('br'), line(`  help: ${d.help}`, 'pg-dim'));
			}
			return wrap;
		}

		let running = false;
		/** The first run pays for fetching and initialising the wasm module. */
		let firstRun = true;

		function setRunning(active: boolean) {
			running = active;
			// Both stay in place and neither moves: a control that appears
			// only once it is needed is a control you have to find under
			// time pressure, which is exactly the wrong moment. Stop is
			// greyed out until there is something to stop, and red the
			// instant there is.
			runBtn.disabled = active;
			stopBtn.disabled = !active;
		}

		async function run() {
			if (running) return;
			setRunning(true);
			// Where only one pane fits, the result is what you pressed Run to
			// see, and the keyboard would only be covering it.
			if (singlePane.matches) {
				showPane('output');
				view.contentDOM.blur();
			}
			// The module is fetched on first use, so say so — a couple of
			// hundred milliseconds of silence otherwise looks like a hang.
			status.textContent = firstRun ? 'Starting the runtime…' : 'Running…';
			status.className = 'pg-status';
			output.replaceChildren();
			view.dispatch({ effects: setErrorLine.of(null) });

			// The source is captured rather than re-read after the run, so the
			// offsets in the diagnostics are resolved against the exact text
			// that produced them even if the editor moved on meanwhile.
			const source = view.state.doc.toString();

			try {
				const result = await runSaule(source);
				firstRun = false;
				versionMeta.textContent = getRuntimeVersion() ?? '';

				const nodes: Node[] = [];
				for (const chunk of result.output) {
					nodes.push(line(chunk.text, chunk.stream === 'stderr' ? 'pg-stderr' : undefined));
				}
				for (const d of result.diagnostics) nodes.push(renderDiagnostic(d, source));

				if (!nodes.length) nodes.push(dim('(no output)'));
				output.replaceChildren(...nodes);

				// Mark where it failed, if the failure had a place.
				const located = result.diagnostics.find((d) => d.span);
				if (located?.span) {
					const at = Math.min(
						toCharOffset(source, located.span.start),
						view.state.doc.length
					);
					view.dispatch({
						effects: setErrorLine.of(view.state.doc.lineAt(at).from),
					});
				}

				status.textContent = result.ok
					? `Finished in ${result.durationMs.toFixed(0)} ms`
					: `Failed — ${result.diagnostics.length} diagnostic(s)`;
				status.className = result.ok ? 'pg-status pg-ok' : 'pg-status pg-fail';
			} catch (err) {
				const box = document.createElement('div');
				box.className = 'pg-notice';
				if (err instanceof RunCancelledError) {
					// Stopped on purpose — by the button or the timeout. Not a
					// failure of the program, so it reads differently.
					box.append(line(err.message));
					status.textContent = 'Stopped';
				} else {
					box.append(
						line(
							err instanceof RuntimeUnavailableError
								? err.message
								: `Unexpected failure: ${err instanceof Error ? err.message : String(err)}`
						)
					);
					status.textContent = 'Runtime unavailable';
				}
				output.replaceChildren(box);
				status.className = 'pg-status pg-fail';
			} finally {
				setRunning(false);
			}
		}

		runBtn.addEventListener('click', () => void run());
		stopBtn.addEventListener('click', () => stopSaule());
		clearBtn.addEventListener('click', clearOutput);

		// ---- boot ------------------------------------------------------------------------

		/**
		 * What to open on arrival, in order of how specific the request is: a
		 * shared link, then the tabs from last time, then the first example.
		 */
		function resolveStartup() {
			const code = /[#&]code=([^&]+)/.exec(window.location.hash);
			const shared = code ? decode(code[1]!) : null;
			if (shared !== null) {
				const named = /[#&]name=([^&]+)/.exec(window.location.hash);
				const name = normaliseName(named ? (decode(named[1]!) ?? 'shared.sau') : 'shared.sau');
				// Reloading a link you copied from your own script should
				// reopen that script, not offer to save a second copy of it.
				const mine = listScripts().find((s) => s.name === name && s.source === shared);
				const tab: OpenTab = mine
					? { kind: 'user', id: mine.id }
					: { kind: 'shared', id: name, source: shared };
				buffers.set(tabKey(tab), shared);
				const at = session.tabs.findIndex((t) => tabKey(t) === tabKey(tab));
				if (at === -1) {
					session.tabs.push(tab);
					session.active = session.tabs.length - 1;
				} else {
					session.active = at;
				}
				return;
			}

			// Drop tabs for scripts deleted since, and seed each shared tab's
			// buffer from what was stored with it.
			session.tabs = session.tabs.filter((t) => t.kind !== 'user' || getScript(t.id));
			for (const tab of session.tabs) {
				if (tab.kind === 'shared' && tab.source !== undefined) {
					buffers.set(tabKey(tab), tab.source);
				}
			}
			if (!session.tabs.length) {
				session.tabs = [{ kind: 'example', id: DEFAULT_EXAMPLE.id }];
				session.active = 0;
			}
			session.active = Math.min(session.active, session.tabs.length - 1);
		}

		resolveStartup();
		applyLayout();
		renderTabs();
		renderTree();
		// `activate` would see the index as unchanged and skip the load, so
		// the first document goes in explicitly.
		applying = true;
		view.dispatch({
			changes: { from: 0, to: view.state.doc.length, insert: tabSource(activeTab()!) },
		});
		applying = false;
		applyMode();
		clearOutput();
		showCursor();
		persist();

		// ---- global keys -------------------------------------------------------------------

		document.addEventListener('keydown', (event) => {
			// Stopping a program is worth a shortcut of its own, since the
			// mouse may be nowhere near the button when a loop runs away.
			if (running && event.key === 'Escape') {
				event.preventDefault();
				stopSaule();
				return;
			}
			if (drawerOpen && event.key === 'Escape') {
				event.preventDefault();
				closeDrawer();
				drawerBtn.focus();
				return;
			}
			const mod = MAC ? event.metaKey : event.ctrlKey;
			if (mod && event.altKey && event.key.toLowerCase() === 'n') {
				event.preventDefault();
				void newFlow();
				return;
			}
			if (mod && !event.altKey && !event.shiftKey && event.key.toLowerCase() === 'b') {
				event.preventDefault();
				sidebarToggle.click();
				return;
			}
			// `?` only outside a text field, where it is a character.
			const target = event.target as HTMLElement | null;
			const typing =
				target?.closest('.cm-editor, input, textarea, [contenteditable]') !== null;
			if (event.key === '?' && !typing && !dialog.open && !helpDialog.open) {
				event.preventDefault();
				openHelp();
			}
		});

		// The editor's text belongs to its tab before the page goes away.
		window.addEventListener('beforeunload', () => {
			flushSave();
			persist();
		});
	}
</script>

<style is:global>
	@import '../styles/playground.css';
</style>
