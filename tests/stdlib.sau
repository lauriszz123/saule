class Main
  static fn main()
    println(type(42), tostring(3.5), int(3.9), float(2))
    println(Math.abs(-5), Math.min(3, 1, 7), Math.max(3, 1, 7))
    println(Math.floor(2.9), Math.ceil(2.1), Math.round(2.5), Math.sqrt(9), Math.pow(2, 3), Math.clamp(99, 0, 10), Math.sign(-7))
    println(Math.pi, Math.e)
  end
end
