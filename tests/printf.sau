-- `printf` uses the same format spec as `String.format` but writes directly
-- to stdout without a trailing newline.
class Main
  static fn main()
    printf("%s is %d\n", "Alice", 30)
    printf("%.2f\n", 3.14159)
    printf("%-5s|%5s\n", "ab", "ab")
    printf("hex=%x dec=%d\n", 255, 255)
  end
end
