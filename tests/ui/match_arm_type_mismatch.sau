-- Arms must all unify to the same type. Here one arm returns a string,
-- another returns an integer — the typechecker should reject the match.
enum Status
    Ok,
    Warn,
    Error
end

class Main
    static fn main()
        local s: Status = Status.Ok
        local value: string = match s
            case Status.Ok then "fine"
            case Status.Warn then 42
            case Status.Error then "oops"
        end
        println(value)
    end
end

