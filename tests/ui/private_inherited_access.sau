-- ERROR: private members from a parent class are NOT accessible in a child.

class Entity
  local secretId: integer

  fn init(id: integer)
    self.secretId = id
  end
end

class Player extends Entity
  fn init(id: integer)
    self.super(id)
  end

  fn leak()
    println(self.secretId)    -- ERROR: private to Entity
  end
end

class Main
  static fn main()
    local p: Player = Player(42)
    p.leak()
  end
end

