-- Every arm is guarded, so the match is not statically exhaustive even
-- though it visually covers "all" integers. The typechecker should
-- require a wildcard / unguarded fallback arm.
class Main
    static fn main()
        local n: integer = 5
        local label: string = match n
            case x when x < 0 then "negative"
            case x when x == 0 then "zero"
            case x when x > 0 then "positive"
        end
        println(label)
    end
end

