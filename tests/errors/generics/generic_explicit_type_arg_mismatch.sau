-- An explicit `<T>` at the call site *binds* the type parameter; it does not
-- merely decorate the call. `filter<string>` fixes `T := string`, so the
-- first parameter is `table<string>` and a `table<integer>` cannot fill it.
--
-- This used to typecheck and run: the parser threw the type arguments away,
-- so `T` was silently re-inferred as `integer` from the argument itself and
-- the written `string` had no effect at all.
-- Should be a compile error.

fn filter<T>(items: table<T>, predicate: fn(T) -> boolean) -> table<T>
	local result: table<T> = {}

	for item: T in items do
		if predicate(item) then
			result[#result + 1] = item
		end
	end

	return result
end

local nums: table<integer> = {1, 2, 3, 4, 5, 6}
local evens = filter<string>(nums, x => x % 2 == 0)
println(evens)
