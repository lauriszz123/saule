-- Class claims `implements Damageable` but doesn't define `damage()`.
-- Should be a (compile) error — listed as a typeck gap.
-- The runtime *does* validate this when the class is declared; this
-- file mostly exists to lock that behavior in.

interface Damageable
  fn damage(amount: integer)
  fn isAlive() -> boolean
end

class Rock implements Damageable
  -- intentionally missing both methods
  hardness: integer

  fn init(h: integer)
    self.hardness = h
  end
end

local r = Rock(7)
println(r.hardness)
