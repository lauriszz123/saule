-- Class claims `implements Damageable` but doesn't define `damage()`.
-- A compile error, from the type checker.

interface Damageable
  fn damage(amount: integer)
  fn isAlive() -> boolean
end

class Rock implements Damageable
  -- intentionally missing both methods
  hardness: integer

  fn init(h: integer)
    self.hardness = h
  end
end

local r = Rock(7)
println(r.hardness)
