-- Iterating a nullable table is a runtime blow-up waiting to happen, and
-- it used to be worse than that: the loop bindings came out untyped, so
-- every member check inside the body silently skipped (private fields
-- included). The loop must be guarded before it runs.

class Entry
  local done: boolean

  fn init()
    self.done = false
  end
end

fn decode() -> any
  return {}
end

fn main()
  local data = decode() as table<Entry>

  for _, entry in data do
    println(entry)
  end
end

main()
