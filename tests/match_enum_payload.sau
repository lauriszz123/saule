-- Match destructures enum variant payloads into bound locals.
enum Event
  Click(x: integer, y: integer),
  Key(code: string),
  Quit
end

fn describe(e: Event) -> string
  return match e
    case Event.Click(x, y) then "click at " .. x .. "," .. y

    case Event.Key(code) then "key: " .. code

    case Event.Quit then "bye"
  end
end

class Main
  static fn main()
    println(describe(Event.Click(10, 20)))
    println(describe(Event.Key("space")))
    println(describe(Event.Quit))
  end
end
