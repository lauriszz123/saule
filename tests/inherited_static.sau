-- Static fields and methods defined on a parent class should be
-- reachable via the child class name.
class Entity
  static maxHealth: integer = 100

  static fn describe() -> string
    return "entity capped at " .. tostring(self.maxHealth)
  end
end

class Player extends Entity
  name: string

  fn init(name: string)
    self.name = name
  end
end

-- inherited static field

assert(Player.maxHealth == 100)

-- inherited static method (and `self` inside it resolves to the *parent* class
-- which actually owns it — the lookup walks up the chain)

assert(Player.describe() == "entity capped at 100")

local p = Player("Lyra")
assert(p.name == "Lyra")
println("inherited static: ok")
