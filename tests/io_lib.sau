-- Io / File round-trip — write, read whole, iterate lines.

class Main
  static fn main()
    local path: string = "/tmp/saule_io_test.txt"

    -- Write
    local f: File = Io.open(path, IoMode.Write)!
    f.write("hello\n")
    f.write("world\n")
    f.write("saule\n")
    f.close()

    -- Read whole
    local g: File = Io.open(path, IoMode.Read)!
    local body: string = g.read("a")!
    println("body=[" .. body .. "]")
    g.close()

    -- Iterate via file:lines()
    local h: File = Io.open(path, IoMode.Read)!
    for line in h.lines() do
      println("line=" .. line)
    end
    h.close()

    -- Iterate via Io.lines(path)
    for line in Io.lines(path) do
      println("path-line=" .. line)
    end

    -- Append
    local a: File = Io.open(path, IoMode.Append)!
    a.write("extra\n")
    a.close()

    -- Confirm append by counting lines
    local count: integer = 0
    for line in Io.lines(path) do
      count = count + 1
    end
    println("count=" .. tostring(count))

    -- Standard streams
    Io.stdout.write("via-stdout\n")
    Io.write("via-io-write\n")
  end
end

