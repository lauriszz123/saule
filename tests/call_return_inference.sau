-- Return types of user functions now flow into bindings, arguments and
-- returns. These are all the *correct* pairings and must keep working.

fn count() -> integer
  return 42
end

fn name() -> string
  return "saule"
end

fn maybe() -> string?
  return nil
end

fn identity<T>(x: T) -> T
  return x
end

fn pair() -> (integer, integer)
  return 11, 22
end

-- Matching binding types.
local n: integer = count()
local s: string = name()
local opt: string? = maybe()

-- Generic instantiated from the argument.
local gi: integer = identity(7)
local gs: string = identity("seven")

-- Lua's multi-value adjustment: one binding takes the first value.
local first: integer = pair()
local a: integer, b: integer = pair()

-- Argument and return positions.
fn describe(text: string) -> string
  return text
end

local d: string = describe(name())

-- Genuinely dynamic values stay usable, but leaving `any` now needs an
-- explicit checked cast: a bare `table` yields `any` on read.
local doc: table = {}
doc.owner = "arthur"
local owner: string = doc.owner as string ?? ""

-- Operators infer: `#` is an integer, `-` keeps the operand type,
-- `not` is a boolean, `??` falls back to the other side.
local len: integer = #name()
local neg: float = -7.9
local flag: boolean = not true
local fallback: string = maybe() ?? "none"

println(n + first + a + b + gi + len)
println(s .. gs .. d .. owner .. fallback)
println(opt ?? "nil-ok")
println(neg)
println(flag)
