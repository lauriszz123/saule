class Box
  label: string = "something exists"
end

class Main
  static fn main()
    local name: string? = nil
    println(name ?? "Unknown")                -- "Unknown"

    local first: string? = nil
    local second: string? = nil
    println(first ?? second ?? "fallback")    -- "fallback"

    local b: Box? = nil
    println(b?.label ?? "no Box")             -- "no box"
  end
end
