-- Field writes are type-checked now; every write here is correct and must
-- keep working, from inside `init`, from a method, and from outside.

fn number() -> integer
  return 7
end

class Holder
  label: string
  count: integer
  tags: table<string>
  note: string?
  static total: integer = 0

  fn init()
    self.label = "start"
    self.count = number()
    self.tags = {"a", "b"}
    self.note = nil
  end

  fn bump()
    self.count = self.count + 1
    Holder.total = Holder.total + 1
  end
end

local h: Holder = Holder()
h.bump()
h.label = "changed"
h.note = "present"
Holder.total = 10

println(h.label .. h.count .. #h.tags .. (h.note ?? "none") .. Holder.total)
