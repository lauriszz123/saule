-- Overrides that keep the parent's contract must keep working: identical
-- signatures, covariant return types, brand-new methods, and constructors
-- (which are exempt because they are never dispatched through a parent).

class Animal
    fn init() end

    fn speak() -> string
        return "..."
    end
end

class Dog extends Animal
    fn init()
        self.super()
    end

    fn speak() -> string
        return "woof"
    end
end

class Shelter
    fn init() end

    fn adopt() -> Animal
        return Animal()
    end
end

class DogShelter extends Shelter
    local size: integer

    -- Constructors may take entirely different parameters.
    fn init(size: integer)
        self.super()
        self.size = size
    end

    -- Covariant return: `Dog` is usable everywhere `Animal` was.
    fn adopt() -> Dog
        return Dog()
    end

    -- A method the parent never declared.
    fn capacity() -> integer
        return self.size
    end
end

local d: Dog = Dog()
println(d.speak())

local s: DogShelter = DogShelter(12)
println(s.adopt().speak())
println(s.capacity())
