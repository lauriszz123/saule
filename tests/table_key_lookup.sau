class Main
	static fn main()
		local t: table<string, any> = {}
		t["alpha"] = 1
		t["beta"] = "two"
		t.gamma = true

		-- dot form and bracket form must find the same entries
		assert(t.alpha == 1)
		assert(t["alpha"] == 1)
		assert(t.beta == "two")
		assert(t["beta"] == "two")
		assert(t.gamma == true)
		assert(t["gamma"] == true)

		-- misses are nil, not errors
		assert(t.missing == nil)
		assert(t["missing"] == nil)

		-- keys that collide with other key shapes stay distinct
		local m: table<any, any> = {}
		m[1] = "int-one"
		m["1"] = "str-one"
		m[true] = "bool-true"
		assert(m[1] == "int-one")
		assert(m["1"] == "str-one")
		assert(m[true] == "bool-true")

		-- overwrite through the dot form is visible through brackets
		t.alpha = 99
		assert(t["alpha"] == 99)

		println("table keys: ok")
	end
end
