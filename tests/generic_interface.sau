-- Generic interface + interface-as-parameter-type, in one test.
--
-- `Repository<T>` is generic in its element type; `PlayerRepository`
-- declares it stores `Player` values. `dumpAll` takes the interface as
-- a parameter type, so it works against anything that satisfies it —
-- not just the concrete `PlayerRepository`.
--
-- This fixture predates generic interfaces working. It used to declare a
-- bare `interface Repository` while using `T` in its methods, and noted
-- that "the `<T>` type list is currently erased at parse time". It is not
-- erased any more: `T` has to be declared, and a method body naming an
-- undeclared one is now the `unknown type` error it should always have
-- been. Declaring `<T>` is what the file was describing all along.
interface Greetable
	fn greet()
end

interface Repository<T>
	fn save(item: T)
	fn findById(id: integer) -> T?
	fn count() -> integer
end

class Player implements Greetable
	name: string

	fn init(name: string)
		self.name = name
	end

	fn greet()
		println("hi, " .. self.name)
	end
end

class PlayerRepository implements Repository<Player>
	local items: table<Player>

	fn init()
		self.items = {}
	end

	fn save(item: Player)
		self.items[#self.items + 1] = item
	end

	fn findById(id: integer) -> Player?
		if id < 1 or id > #self.items then
			return nil
		end
		return self.items[id]
	end

	fn count() -> integer
		return #self.items
	end
end

-- An interface-typed parameter accepts any implementer.

fn greetAll(items: table<Greetable>)
	for g: Greetable in items do
		g.greet()
	end
end

local repo: PlayerRepository = PlayerRepository()
repo.save(Player("Arthur"))
repo.save(Player("Merlin"))
repo.save(Player("Lancelot"))

assert(repo.count() == 3)

local arthur: Player? = repo.findById(1)
assert(arthur != nil)
assert(arthur!.name == "Arthur")

assert(repo.findById(99) == nil)

local pretty: table<Greetable> = {Player("Galahad"), Player("Percival")}
greetAll(pretty)

println("generic interface + interface-as-param: ok")
