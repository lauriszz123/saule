-- `static local` declares a class-level value that is private to the class.
-- Inside any class method (static or instance) the member is reachable by
-- its bare name. From outside it cannot be touched — see the matching UI
-- test `static_local_private.sau` for the negative case.
class Bank
  static local secret: integer = 42

  static local fn check(n: integer) -> boolean
    return n == secret
  end

  static fn unlock(code: integer) -> string
    if check(code) then
      return "opened"
    end
    return "denied"
  end

  static fn peekSecret() -> integer
    return secret
  end
end

assert(Bank.unlock(42) == "opened")
assert(Bank.unlock(13) == "denied")
assert(Bank.peekSecret() == 42)

println("static local: ok")
