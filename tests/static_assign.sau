-- Assigning to a static by its bare name inside a method writes through to
-- the class itself, not to a scope-local copy. This is the only way to
-- mutate a `static local`, which is invisible from outside the class.

class Counter
	static n: integer = 0
	static local hidden: integer = 0

	fn init()
	end

	static fn bump()
		n = n + 1
	end

	static fn bumpHidden()
		hidden = hidden + 10
	end

	static fn readHidden() -> integer
		return hidden
	end

	-- Instance methods reach statics by bare name too.
	fn bumpFromInstance()
		n = n + 100
	end
end

-- A bare-name write from a static method is visible outside the class.
Counter.bump()
Counter.bump()
assert(Counter.n == 2)

-- ...and from an instance method.
local c: Counter = Counter()
c.bumpFromInstance()
assert(Counter.n == 102)

-- `static local` has no `Counter.hidden` spelling, so the bare-name write
-- is the only mutation path there is.
Counter.bumpHidden()
Counter.bumpHidden()
assert(Counter.readHidden() == 20)

-- An inherited method runs with the *receiver's* class as its statics
-- owner, so a method declared on `Base` executing against a `Derived`
-- instance has to walk up the chain to find `Base`'s slot — and write to
-- that one slot rather than minting a copy on `Derived`.
class Base
	static hits: integer = 0

	fn init()
	end

	fn record()
		hits = hits + 1
	end
end

class Derived extends Base
	fn init()
		self.super()
	end
end

local d: Derived = Derived()
d.record()
d.record()
assert(Base.hits == 2)

-- A local parameter still shadows a same-named static for the whole call
-- instead of writing through to the class.
class Shadow
	static value: integer = 7

	static fn withParam(value: integer) -> integer
		value = value + 1
		return value
	end
end

assert(Shadow.withParam(1) == 2)
assert(Shadow.value == 7)

println("static assign: ok")
