-- Coroutines are stackful: any function the body calls can yield, at any depth.

fn check(label: string, got: string, want: string)
  println(label .. ": " .. got)
  assert(got == want, label .. ": expected `" .. want .. "`, got `" .. got .. "`")
end

-- Yields only after the deeper calls return, so each resume continues a
-- different frame.
fn postOrder(co: Yielder<integer>, n: integer)
  if n == 0 then
    return
  end
  postOrder(co, n - 1)
  co.yield(n)
end

fn helper(co: Yielder<string>)
  co.yield("from helper")
  co.yield("helper again")
end

class Counter
  local n: integer
  fn init()
    self.n = 0
  end
  fn run(co: Yielder<integer>)
    while self.n < 3 do
      self.n = self.n + 1
      co.yield(self.n)
    end
  end
end

fn drainInts(gen: Coroutine<integer>) -> string
  local log: string = ""
  for v in gen do
    log = log .. v .. ","
  end
  return log
end

fn drainStrings(gen: Coroutine<string>) -> string
  local log: string = ""
  for v in gen do
    log = log .. v .. ","
  end
  return log
end

class Main
  static fn main()
    check("recursion", drainInts(Coroutine.create(fn(co)
      postOrder(co, 5)
    end)), "1,2,3,4,5,")

    local c: Counter = Counter()
    check("method", drainInts(Coroutine.create(fn(co)
      c.run(co)
    end)), "1,2,3,")

    check("helper", drainStrings(Coroutine.create(fn(co)
      helper(co)
    end)), "from helper,helper again,")

    check("inside try", drainStrings(Coroutine.create(fn(co)
      try
        co.yield("in try")
        throw "after resume"
      catch e: string
        co.yield("caught " .. e)
      end
    end)), "in try,caught after resume,")

    local items: table<string> = {"a", "b", "c"}
    check("for in", drainStrings(Coroutine.create(fn(co)
      for i: integer, v: string in items do
        co.yield(i .. v)
      end
    end)), "1a,2b,3c,")

    -- Deep: five hundred frames, one yield in each.
    local deep: Coroutine<integer> = Coroutine.create(fn(co)
      postOrder(co, 500)
    end)
    local count: integer = 0
    for v in deep do
      count = count + 1
    end
    check("deep", count .. "", "500")
  end
end
