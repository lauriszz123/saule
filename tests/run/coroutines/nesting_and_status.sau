-- Coroutines resume coroutines: status reads running, normal, suspended and dead correctly.

fn check(label: string, got: string, want: string)
  println(label .. ": " .. got)
  assert(got == want, label .. ": expected `" .. want .. "`, got `" .. got .. "`")
end

fn range(n: integer) -> Coroutine<integer>
  return Coroutine.create(fn(co)
    for i = 1, n do
      co.yield(i)
    end
  end)
end

fn evens(src: Coroutine<integer>) -> Coroutine<integer>
  return Coroutine.create(fn(co)
    for v in src do
      if v % 2 == 0 then
        co.yield(v)
      end
    end
  end)
end

fn squares(src: Coroutine<integer>) -> Coroutine<integer>
  return Coroutine.create(fn(co)
    for v in src do
      co.yield(v * v)
    end
  end)
end

class Main
  static fn main()
    -- `running` from inside, `normal` while waiting on one it resumed.
    local holder: table<Coroutine<string>> = {}
    local outer: Coroutine<string> = Coroutine.create(fn(co)
      local me: Coroutine<string> = holder[1]
      local inner: Coroutine<string> = Coroutine.create(fn(ico)
        ico.yield(me.status())
      end)
      local seenByInner: string = inner.resume() ?? "?"
      co.yield(me.status() .. "/" .. seenByInner .. "/" .. inner.status())
    end)
    holder[1] = outer
    check("status", (outer.resume() ?? "?") .. "/" .. outer.status(),
      "running/normal/suspended/suspended")

    -- Generators composed into a pipeline.
    local log: string = ""
    for v in squares(evens(range(10))) do
      log = log .. v .. ","
    end
    check("pipeline", log, "4,16,36,64,100,")
  end
end
