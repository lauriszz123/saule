-- Coroutines resume coroutines: status reads running, normal, suspended and dead correctly.

fn check(label: string, got: string, want: string)
  println(label .. ": " .. got)
  assert(got == want, label .. ": expected `" .. want .. "`, got `" .. got .. "`")
end

fn range(n: integer) -> any
  return Coroutine.create(fn(co: any) -> nil
    for i = 1, n do
      co.yield(i)
    end
  end)
end

fn evens(src: any) -> any
  return Coroutine.create(fn(co: any) -> nil
    local v: any? = src.resume()
    while v != nil do
      if (v as integer)! % 2 == 0 then
        co.yield(v)
      end
      v = src.resume()
    end
  end)
end

fn squares(src: any) -> any
  return Coroutine.create(fn(co: any) -> nil
    local v: any? = src.resume()
    while v != nil do
      local n: integer = (v as integer)!
      co.yield(n * n)
      v = src.resume()
    end
  end)
end

class Main
  static fn main()
    -- `running` from inside, `normal` while waiting on one it resumed.
    local holder: table<any> = {}
    local outer: any = Coroutine.create(fn(co: any) -> nil
      local me: any = holder[1]
      local inner: any = Coroutine.create(fn(ico: any) -> nil
        ico.yield(tostring(me.status()))
      end)
      local seenByInner: string = tostring(inner.resume())
      co.yield(tostring(me.status()) .. "/" .. seenByInner .. "/" .. tostring(inner.status()))
    end)
    holder[1] = outer
    check("status", tostring(outer.resume()) .. "/" .. tostring(outer.status()),
      "running/normal/suspended/suspended")

    -- Generators composed into a pipeline.
    local p: any = squares(evens(range(10)))
    local log: string = ""
    local v: any? = p.resume()
    while v != nil do
      log = log .. tostring(v) .. ","
      v = p.resume()
    end
    check("pipeline", log, "4,16,36,64,100,")
  end
end
