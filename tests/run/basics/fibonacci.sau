-- Fibonacci: a numeric `for`, parallel assignment and a `local fn`, which is
-- about as much of the language as a smoke test should need.
local fn fibonacci(n: integer) -> integer
	if n < 0 then
		return 0
	end
	local a: integer, b: integer = 0, 1

	for i: integer = 2, n do
		a, b = b, a + b
	end

	return b
end

class Main
	static fn main()
		println(fibonacci(10))
	end
end
