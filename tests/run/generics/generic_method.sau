-- Generic method on a class — `T` is declared on the method, not the class.
class Box
	label: string

	fn init(label: string)
		self.label = label
	end

	fn wrap<T>(value: T) -> string
		return String.format("%s wrapped %s", self.label, value)
	end
end

class Main
	static fn main()
		local b: Box = Box("Box")
		println(b.wrap(7))
		println(b.wrap("hi"))
	end
end
