-- An interface can extend another. The child interface implicitly demands
-- every method of the parent, plus its own. A class that implements the
-- child must satisfy both contracts.
interface Damageable
	fn damage(amount: integer)
	fn isAlive() -> boolean
end

interface Combatant extends Damageable
	fn attack(target: Combatant)
end

class Knight implements Combatant
	local health: integer

	fn init(health: integer)
		self.health = health
	end

	-- From `Damageable` —

	fn damage(amount: integer)
		self.health = self.health - amount
	end

	fn isAlive() -> boolean
		return self.health > 0
	end

	-- From `Combatant` —

	fn attack(target: Combatant)
		target.damage(10)
	end
end

local arthur: Knight = Knight(100)
local merlin: Knight = Knight(40)

arthur.attack(merlin)
arthur.attack(merlin)

assert(merlin.isAlive())
assert(arthur.isAlive())

arthur.damage(150)
assert(arthur.isAlive() == false)

println("interface composition: ok")
