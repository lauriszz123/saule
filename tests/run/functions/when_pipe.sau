-- Colon-based pipeline ("Saule style").
--
-- `when(source):stage(args)` threads `source` in as the first argument of
-- `stage(...)`. Successive `:stage(args)` calls feed each result into the
-- next stage, so the chain reads top-to-bottom even though every step is
-- an ordinary free-function call.

fn shout(msg: string) -> string
	return msg .. "!"
end

fn repeat_str(msg: string, times: integer) -> string
	local out: string = ""
	for i: integer = 1, times do
		out = out .. msg
	end
	return out
end

fn length_of(msg: string) -> integer
	return #msg
end

-- Single stage: `shout("Hello, ")` returns "Hello, !".
local greeting: string = when("Hello, "):shout()
print(greeting)

-- Multi-stage: pipes "hi" → shout → repeat_str(_, 3) → length_of.
-- Equivalent to `length_of(repeat_str(shout("hi"), 3))`.
local size: integer = when("hi"):shout():repeat_str(3):length_of()
print(size)
