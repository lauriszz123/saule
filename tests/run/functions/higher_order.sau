-- Higher-order: a function returning a function (closure over `factor`)
fn multiplier(factor: integer) -> fn(integer) -> integer
	return x => x * factor
end

class Main
	static fn main()
		local triple: fn(integer) -> integer = multiplier(3)
		local tenX: fn(integer) -> integer = multiplier(10)

		println(triple(5))  -- 15
		println(tenX(5))  -- 50
		println(triple(7))  -- 21
	end
end
