-- Several `catch` clauses, and `finally`.
--
-- Clauses are tried in source order, so the first whose type matches the
-- thrown value handles it — which is why `catch e: any` belongs last.
-- `finally` runs on every way out: normal completion, a clause that
-- handled a throw, a throw nothing handled, and a `return` / `break` /
-- `continue` from inside.

class Oops
	msg: string = "oops"
end

fn classify(which: integer) -> string
	try
		if which == 1 then
			throw "text"
		elseif which == 2 then
			throw 42
		elseif which == 3 then
			throw Oops()
		elseif which == 4 then
			-- Matched by none of the clauses above, so the `any` one takes it.
			throw 3.5
		end
		return "nothing thrown"
	catch e: string
		return "string: " .. e
	catch e: integer
		return "integer: " .. e
	catch e: Oops
		return "class: " .. e.msg
	catch e: any
		return "anything else"
	end
end

fn onEveryPath(which: integer) -> string
	try
		if which == 1 then
			throw "thrown"
		elseif which == 2 then
			return "returned from the body"
		end
		return "fell through"
	catch e: string
		return "handled"
	finally
		println("  finally(" .. which .. ")")
	end
end

fn throughALoop() -> integer
	local kept: integer = 0
	for i = 1, 3 do
		try
			if i == 2 then
				continue
			end
			if i == 3 then
				break
			end
			kept = kept + 1
		finally
			println("  loop finally " .. i)
		end
	end
	return kept
end

fn aroundALoop() -> integer
	local n: integer = 0
	try
		for i = 1, 3 do
			if i == 2 then
				break
			end
			n = n + 1
		end
	finally
		-- Once: a `try` wrapped *around* the loop is not left by the `break`.
		println("  once")
	end
	return n
end

fn propagates() -> string
	try
		try
			throw "inner"
		finally
			println("  finally before propagating")
		end
	catch e: string
		return "outer caught " .. e
	end
end

fn nested() -> string
	try
		try
			return "returned"
		finally
			println("  inner")
		end
	finally
		println("  outer")
	end
end

class Main
	static fn main()
		println(classify(0))
		println(classify(1))
		println(classify(2))
		println(classify(3))
		println(classify(4))

		println(onEveryPath(0))
		println(onEveryPath(1))
		println(onEveryPath(2))

		println("kept: " .. throughALoop())
		println("around: " .. aroundALoop())
		println(propagates())
		println(nested())

		-- A clause's binding is scoped to that clause, so the name is free
		-- to repeat.
		try
			throw 7
		catch e: string
			println("unreachable")
		catch e: integer
			println("second clause: " .. e)
		end
	end
end
