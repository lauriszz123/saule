-- A tuple variant keeps its fields in itself, and `match` reads them from
-- there. `.value` is still a table of them: made when it is first asked
-- for, the same table every time after, and what the variant carries from
-- then on, so that writing to it is seen by the next `match`.
enum Shape
	Dot(x: integer),
	Line(x: integer, y: integer),
	Box(x: integer, y: integer, w: integer, h: integer),
	Named(name: string, tags: table<string>),
	Wrapped(inner: Shape),
	Nothing
end

class Main
	-- One `match` over its argument: compiled where it is called.
	static fn size(s: Shape) -> integer
		return match s
			case Shape.Dot(x) then x
			case Shape.Line(x, y) when x > y then x - y
			case Shape.Line(x, y) then y - x
			case Shape.Box(_, _, w, h) then w * h
			case _ then 0
		end
	end

	static fn first(s: Shape) -> integer
		return match s
			case Shape.Dot(x) then x
			case Shape.Line(x, _) then x
			case Shape.Box(x, _, _, _) then x
			case _ then -1
		end
	end

	static fn main()
		local dot = Shape.Dot(7)
		local line = Shape.Line(3, 10)
		local back = Shape.Line(10, 3)
		local box = Shape.Box(1, 2, 3, 4)
		assert(Main.size(dot) == 7)
		assert(Main.size(line) == 7)
		assert(Main.size(back) == 7)
		assert(Main.size(box) == 12)
		assert(Main.size(Shape.Nothing) == 0)
		assert(Main.first(box) == 1 and Main.first(line) == 3)
		assert(Main.first(Shape.Named("a", {})) == -1)

		-- Beside another operand, which is read where it is: the call
		-- runs nothing that could change it.
		local total = 0
		local all: table<Shape> = {dot, line, back, box, Shape.Nothing}
		for pass = 1, 3 do
			for i = 1, #all do
				total = total + Main.size(all[i]!)
			end
		end
		assert(total == 3 * (7 + 7 + 7 + 12))
		total = total * 2 - Main.first(dot)
		assert(total == 6 * 33 - 7)

		-- Fields that are not numbers, and a variant in a variant.
		local named = Shape.Named("door", {"red", "tall"})
		local described = match named
			case Shape.Named(name, tags) then name .. ":" .. tags[2]!
			case _ then "?"
		end
		assert(described == "door:tall")
		local deep = Shape.Wrapped(Shape.Wrapped(box))
		local inner = match deep
			case Shape.Wrapped(a) then match a
				case Shape.Wrapped(b) then Main.size(b)
				case _ then -1
			end
			case _ then -2
		end
		assert(inner == 12)

		-- `.value`: a table of the fields, and one table.
		local v = line.value
		assert(#v == 2 and v[1] == 3 and v[2] == 10)
		assert(#box.value == 4 and box.value[4] == 4)
		assert(dot.value[1] == 7)
		-- Written to, it is what the variant carries.
		v[1] = 100
		assert(line.value[1] == 100)
		assert(Main.size(line) == 90)
		assert(Main.first(line) == 100)
		-- A variant nobody asked the table of is untouched by that.
		assert(Main.size(back) == 7)

		-- Many of them made and dropped.
		local sum = 0
		for i = 1, 2000 do
			local s = Shape.Named("n" .. i, {"t"})
			local w = Shape.Wrapped(Shape.Line(i, i + 1))
			sum = sum + match w
				case Shape.Wrapped(a) then Main.size(a)
				case _ then 0
			end
			sum = sum + match s
				case Shape.Named(name, _) then #name
				case _ then 0
			end
		end
		assert(sum == 2000 + 9 * 2 + 90 * 3 + 900 * 4 + 1001 * 5)
		println("ok")
	end
end
