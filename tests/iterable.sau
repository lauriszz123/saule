interface Iterable<T>
    fn hasNext() -> boolean
    fn next() -> T
end

class Test implements Iterable<integer>
  local items: table<string, integer>

  fn init()
  end

  fn hasNext() -> boolean
  end

  fn next() -> integer
  end
end

class Main
  static fn main()
    local test: Test = Test()
  end
end
