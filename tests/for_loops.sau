class Main
  static fn main()
    for i: integer = 1, 10 do
      print(" 1: ", i)
    end
    println()

    -- with step

    for i: integer = 0, 100, 5 do
      print(" 2: ", i)
    end
    println()

    -- counting down

    for i: integer = 10, 1, -1 do
      print(" 3: ", i)
    end
    println()
  end
end
