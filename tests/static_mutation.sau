-- Static field mutation persists across all instances
class Player
  static maxHealth: integer = 100

  local name: string

  fn init(name: string)
    self.name = name
  end

  static fn getMaxHealth() -> integer
    return maxHealth
  end
end

class Main
  static fn main()
    println(Player.maxHealth)  -- 100
    println(Player.getMaxHealth())  -- 100

    Player.maxHealth = 200

    println(Player.maxHealth)  -- 200
    println(Player.getMaxHealth())  -- 200
  end
end
