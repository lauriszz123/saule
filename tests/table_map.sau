-- table<K, V> is a hashmap: arbitrary key type, value type enforced.
class Main
	static fn main()
		local ages: table<string, integer> = {}

		ages["alice"] = 30
		ages["bob"] = 25
		ages["charlie"] = 41

		println("alice=", ages["alice"])
		println("bob=", ages["bob"])

		-- missing key reads as nil

		println("missing=", ages["nobody"])

		-- iterate as (key, value) pairs

		for k, v in ages do
			println(k, " -> ", v)
		end

		-- numeric-keyed map

		local lookup: table<integer, string> = {}
		lookup[100] = "hundred"
		lookup[200] = "two-hundred"
		println(lookup[100], " / ", lookup[200])
	end
end
