-- Multi-value iteration via `Iterable2<K, V>`. The closure returns two values
-- per step (and `nil, nil` to terminate). The loop binds `name, level`
-- positionally.
class PlayerList implements Iterable2<string, integer>
  local names:  table<integer, string>
  local levels: table<integer, integer>
  local count:  integer

  fn init()
    self.names  = {}
    self.levels = {}
    self.count  = 0
  end

  fn add(name: string, level: integer)
    self.count = self.count + 1
    self.names[self.count]  = name
    self.levels[self.count] = level
  end

  fn iter() -> fn(): (string?, integer?)
    local i: integer     = 0
    local total: integer = self.count
    local ns: table<integer, string>  = self.names
    local ls: table<integer, integer> = self.levels
    return fn => ()
      i = i + 1
      if i > total then return nil, nil end
      return ns[i], ls[i]
    end
  end
end

class Main
  static fn main()
    local players: PlayerList = PlayerList()
    players.add("alice", 10)
    players.add("bob",    7)
    players.add("carol",  3)

    for name, lvl in players do
      println(name, " -> ", lvl)
    end
  end
end



