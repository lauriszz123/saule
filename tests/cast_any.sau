-- `as` is the checked escape from `any`. It yields `T?` — the value when
-- it really is a `T`, `nil` otherwise — so failure has to be handled.
class Animal
end

class Dog extends Animal
	fn speak() -> string
		return "woof"
	end
end

fn describe(y: any) -> string
	match type(y)
		case "integer" then
			return "int " .. tostring(y as integer ?? 0)
		case "string" then
			return "str " .. (y as string ?? "?")
		case _ then
			return "other"
	end
end

class Main
	static fn main()
		println(describe(42))  -- int 42
		println(describe("hi"))  -- str hi
		println(describe(3.5))  -- other

		-- A failing cast is `nil`, not a throw.
		local wrong: any = "not a number"
		println(wrong as integer ?? -1)  -- -1

		-- `!` turns it back into a throw when you know better.
		local boxed: any = 42
		local n: integer = (boxed as integer)!
		println(n)  -- 42

		-- Class casts respect inheritance.
		local pet: any = Dog()
		println(pet as Animal != nil)  -- true
		println(pet as Dog != nil)  -- true

		-- table<T> is checked elementwise, so the element type is honest.
		local nums: any = {1, 2, 3}
		println(nums as table<integer> != nil)  -- true
		println(nums as table<string> != nil)  -- false
	end
end
