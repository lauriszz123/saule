-- try / catch / throw
class Player
	local health: integer

	fn init(health: integer)
		self.health = health
	end

	fn damage(amount: integer)
		if amount < 0 then
			throw "Damage cannot be negative"
		end

		self.health = self.health - amount
	end
end

class Main
	static fn main()
		try
			local p: Player = Player(100)
			p.damage(-10)
			println("should not print")
		catch e: string
			println("Caught: " .. e)
		end

		-- catch block runs as if try returned normally

		println("after try/catch")
	end
end
