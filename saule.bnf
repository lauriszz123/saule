program         = { statement } ;

statement       = variable_decl
                | function_decl
                | class_decl
                | interface_decl
                | enum_decl
                | import_stmt
                | export_stmt
                | assignment
                | expr_stmt
                | if_stmt
                | while_stmt
                | for_stmt
                | foreach_stmt
                | repeat_stmt
                | try_stmt
                | return_stmt
                | break_stmt
                | continue_stmt
                | block ;

block           = "{" { statement } "}" ;

variable_decl   = "local" identifier ":" type "=" expression ";" ;

assignment      = identifier "=" expression ";" ;

function_decl   = "fn" identifier "(" [ param_list ] ")" [ "->" type ] block ;

param_list      = param { "," param } ;
param           = identifier ":" type [ "=" expression ] ;

class_decl      = "class" identifier [ "extends" identifier ] block ;

interface_decl  = "interface" identifier [ "extends" identifier_list ] block ;
identifier_list = identifier { "," identifier } ;

enum_decl       = "enum" identifier "{" enum_member { "," enum_member } "}" ;
enum_member     = identifier [ "=" expression ] ;

import_stmt     = "import" string_lit [ "as" identifier ] ";" ;
export_stmt     = "export" ( function_decl | class_decl | interface_decl | enum_decl ) ;

expr_stmt       = expression ";" ;

if_stmt         = "if" "(" expression ")" block [ "else" block ] ;
while_stmt      = "while" "(" expression ")" block ;
for_stmt        = "for" "(" variable_decl expression ";" expression ")" block ;
foreach_stmt    = "for" "(" identifier "in" expression ")" block ;
repeat_stmt     = "repeat" block "until" "(" expression ")" ";" ;

try_stmt        = "try" block "catch" "(" identifier ")" block ;

return_stmt     = "return" [ expression_list ] ";" ;
break_stmt      = "break" ";" ;
continue_stmt   = "continue" ";" ;

expression_list = expression { "," expression } ;

expression      = assignment_expr ;

assignment_expr = null_coalesce_expr [ "=" assignment_expr ] ;

null_coalesce_expr = null_safe_expr { "??" null_safe_expr } ;

null_safe_expr  = or_expr { "?." or_expr } ;

or_expr         = and_expr { "||" and_expr } ;
and_expr        = equality_expr { "&&" equality_expr } ;
equality_expr   = relational_expr { ( "==" | "!=" ) relational_expr } ;
relational_expr = additive_expr { ( "<" | ">" | "<=" | ">=" ) additive_expr } ;
additive_expr   = multiplicative_expr { ( "+" | "-" ) multiplicative_expr } ;
multiplicative_expr = unary_expr { ( "*" | "/" | "%" ) unary_expr } ;

unary_expr      = [ "!" | "-" ] primary_expr ;

primary_expr    = literal
                | identifier
                | function_call
                | lambda_expr
                | "(" expression ")"
                | member_access
                | index_access ;

function_call   = identifier "(" [ argument_list ] ")" ;
argument_list   = expression { "," expression } ;

lambda_expr     = "(" [ param_list ] ")" "=>" ( expression | block ) ;

member_access   = primary_expr "." identifier ;
index_access    = primary_expr "[" expression "]" ;

literal         = int_lit | float_lit | bool_lit | string_lit | nil_lit ;

type            = base_type [ "?" ] ;
base_type       = "int" | "float" | "bool" | "string" | "function"
                | "table" "<" type ">"
                | "userdata" | "thread"
                | identifier ;

identifier      = letter { letter | digit | "_" } ;
int_lit         = digit { digit } ;
float_lit       = digit { digit } "." digit { digit } ;
bool_lit        = "true" | "false" ;
string_lit      = '"' { character } '"' ;
nil_lit         = "nil" ;

letter          = "A".."Z" | "a".."z" ;
digit           = "0".."9" ;
character       = ? any character except " ? ;

(* Comments are Lua-style and are skipped by the lexer (not part of the grammar): *)
(*   line_comment  = "--" { ? any character except newline ? } ;                  *)
(*   block_comment = "--[[" { ? any character ? } "]]" ;                          *)

