{
  "name": "saule",
  "displayName": "Saule",
  "description": "Language support for the Saule programming language: syntax highlighting plus a full language server (diagnostics, hover, go-to-definition, references, document symbols, inlay hints, signature help, and formatting).",
  "version": "26.1.0",
  "publisher": "saule",
  "license": "MIT",
  "engines": { "vscode": "^1.91.0" },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "keywords": ["saule", "sau", "language server", "lsp"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:saule",
    "workspaceContains:**/*.sau",
    "workspaceContains:**/saule.config"
  ],
  "contributes": {
    "languages": [
      {
        "id": "saule",
        "aliases": ["Saule", "saule"],
        "extensions": [".sau"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "saule",
        "scopeName": "source.saule",
        "path": "./syntaxes/saule.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Saule",
      "properties": {
        "saule.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `saule-lsp` executable. When empty, the extension honours the `SAULE_LSP_PATH` environment variable, then `#saule.toolchainDir#`, then walks up from each workspace folder looking for `target/release` and `target/debug`, and finally falls back to `saule-lsp` on your `PATH`.",
          "scope": "machine-overridable"
        },
        "saule.cli.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `saule` executable used by the **Saule: Run File** and **Saule: Run Project** commands. Resolved the same way as `#saule.server.path#`, honouring the `SAULE_PATH` environment variable.",
          "scope": "machine-overridable"
        },
        "saule.toolchainDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Directory containing the Saule toolchain binaries (`saule`, `saule-lsp`). Used when no explicit path is set for a binary.",
          "scope": "machine-overridable"
        },
        "saule.server.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional command-line arguments passed to the saule-lsp server on startup."
        },
        "saule.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the Saule language server."
        }
      }
    },
    "commands": [
      {
        "command": "saule.restartServer",
        "title": "Restart Language Server",
        "category": "Saule"
      },
      {
        "command": "saule.showServerOutput",
        "title": "Show Language Server Output",
        "category": "Saule"
      },
      {
        "command": "saule.runFile",
        "title": "Run File",
        "category": "Saule"
      },
      {
        "command": "saule.runProject",
        "title": "Run Project",
        "category": "Saule"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "saule.runFile",
          "when": "editorLangId == saule"
        }
      ],
      "editor/context": [
        {
          "command": "saule.runFile",
          "when": "editorLangId == saule",
          "group": "navigation@1"
        }
      ]
    },
    "configurationDefaults": {
      "[saule]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnType": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && tsc -p ./tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.91.0",
    "typescript": "^6.0.3"
  }
}
