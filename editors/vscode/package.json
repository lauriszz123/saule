{
  "name": "saule",
  "displayName": "Saule",
  "description": "Language support for the Saule programming language: syntax highlighting plus a full language server (diagnostics, hover, go-to-definition, references, document symbols, inlay hints, signature help, and formatting).",
  "version": "26.1.0",
  "publisher": "saule",
  "license": "MIT",
  "engines": { "vscode": "^1.91.0" },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "keywords": ["saule", "sau", "language server", "lsp"],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:saule",
    "workspaceContains:**/*.sau",
    "workspaceContains:**/saule.config"
  ],
  "contributes": {
    "languages": [
      {
        "id": "saule",
        "aliases": ["Saule", "saule"],
        "extensions": [".sau"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "saule",
        "scopeName": "source.saule",
        "path": "./syntaxes/saule.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Saule",
      "properties": {
        "saule.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `saule-lsp` executable. When empty, the extension searches the workspace's `target/release` and `target/debug` folders, then falls back to `saule-lsp` on your `PATH`.",
          "scope": "machine-overridable"
        },
        "saule.server.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional command-line arguments passed to the saule-lsp server on startup."
        },
        "saule.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the Saule language server."
        }
      }
    },
    "commands": [
      {
        "command": "saule.restartServer",
        "title": "Restart Language Server",
        "category": "Saule"
      },
      {
        "command": "saule.showServerOutput",
        "title": "Show Language Server Output",
        "category": "Saule"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.91.0",
    "typescript": "^6.0.3"
  }
}
