{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]"]
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(class|interface|enum|fn|if|else|for|while|repeat|do|try|catch)\\b.*$|.*\\bthen\\s*$|.*\\bdo\\s*$|.*\\{\\s*$",
    "decreaseIndentPattern": "^\\s*(end|else|until|catch|\\})\\b"
  }
}
