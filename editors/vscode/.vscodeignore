# Source + build tooling not needed inside the packaged .vsix.
#
# NOTE: do NOT exclude node_modules — `vscode-languageclient` is a runtime
# dependency and must ship in the .vsix. vsce already prunes devDependencies
# automatically, so only production deps are bundled.
.vscode/**
src/**
tsconfig.json
.gitignore
package-lock.json
**/*.map
**/*.ts
!out/**/*.js
