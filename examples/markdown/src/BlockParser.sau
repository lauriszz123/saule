local fn indentOf(line: string)
    local width = 0

    for ch in String.iter(line) do
        if ch == ' ' then
            width = width + 1
        elseif ch == '\t' then
            width = width + 4
        else
            break
        end
    end

    return width
end

local fn runLength(s: string, ch: string)
    local n = 0

    for c in String.iter(s) do
        if c != ch then
            break
        end

        n += 1
    end

    return n
end

export class BlockParser
    fn init()
    end
end
