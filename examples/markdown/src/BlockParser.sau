import * from LineScanner
import * from Slugger
import * from Ast

local fn indentOf(line: string)
    local width = 0

    for ch in String.iter(line) do
        if ch == ' ' then
            width = width + 1
        elseif ch == '\t' then
            width = width + 4
        else
            break
        end
    end

    return width
end

local fn runLength(s: string, ch: string)
    local n = 0

    for c in String.iter(s) do
        if c != ch then
            break
        end

        n += 1
    end

    return n
end

local fn atxLevel(line: string)
    local t = String.trimStart(line)
    local n = runLength(t, '#')

    local rest = String.sub(t, n + 1)

    if n < 1 or String.starts(rest, ' ') then
        return n
    end

    return 0
end

local fn fenceCharOf(line: string)
    local t = String.trimStart(line)

    if String.starts(t, '```') then
        return '`'
    end

    if String.starts(t, '~~~') then
        return '~'
    end

    return nil
end

export class BlockParser
    local scanner: LineScanner
    local slugger: Slugger
    local refs: table<HeadingRef>
    local docTitle: string?

    fn init(scanner: LineScanner, slugger: Slugger)
        self.scanner = scanner
        self.slugger = slugger
        self.refs = {}
    end

    fn headings()
        return self.refs
    end

    fn title()
        return self.docTitle
    end

    fn run()
        local blocks: table<Block> = {}

        while not self.scanner.eof() do
            self.scanner.skipBlank()

            if self.scanner.eof() then
                break
            end

            Table.insert(blocks, self.nextBlock())
        end

        return blocks
    end

    local fn starterKind()
        local line = self.scanner.peek()

        if line == nil then
            return ''
        end

        if fenceCharOf(line) != nil then
            return 'fence'
        end

        if atxLevel(line) > 0 then
            return 'heading'
        end

        return ''
    end

    local fn nextBlock()
        if self.starterKind() == 'heading' then
            return self.heading()
        end

        return self.paragraph()
    end

    local fn recordHeading(level: integer, text: string)
        local slug = self.slugger.slug(text)

        Table.insert(self.refs, HeadingRef(level, slug, text))

        if level == 1 and self.docTitle == nil then
            self.docTitle = text
        end

        return Block.Heading(level, slug, {Inline.Text(text)})
    end

    local fn heading()
        local t = String.trimStart(self.scanner.next() ?? '')
        local level = runLength(t, '#')
        local text = String.trim(String.sub(t, level + 1))

        return self.recordHeading(level, text)
    end

    local fn paragraph()
        local lines: table<string> = {}

        while not self.scanner.eof() do
            local line = String.trim(self.scanner.peek() ?? '')

            if line == '' then
                break
            end

            if #lines > 0 and self.starterKind() != '' then
                break
            end

            self.scanner.next()

            Table.insert(lines, line)
        end

        return Block.Paragraph({Inline.Text(String.join('\n', lines))})
    end
end
