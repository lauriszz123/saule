import * from Ast
import * from Parser

local fn flag(b: boolean?) -> string
    if b == nil then
        return '-'
    end

    if b! then
        return 'yes'
    end

    return 'no'
end

local fn dump(blocks: table<Block>, depth: integer = 0)
    local pad: string = String.rep(" ", depth)
    for block in blocks do
        match block
            case Block.Heading(level, slug, children) then println(
                pad .. "Heading h" .. level .. " #" .. slug .. " inlines=" .. #children
            )

            case Block.Paragraph(children) then println(pad .. "Paragraph inlines=" .. #children)

            case Block.Code(src, language) then println(
                pad .. "Code(" .. ((language ?? '-') .. ") " .. #String.split(src, "\n") .. " lines")
            )

            case Block.Quote(children) then
                println(pad .. "Quote")
                dump(children, depth + 2)

            case Block.List(ordered, start, tight, items) then
                println(
                    pad .. "List ordered=" .. ((ordered and "yes" or "no") .. " start=" .. start .. " tight=" .. ((tight and "yes" or "no") .. " items=" .. #items))
                )
                for item in items do
                end

            case Block.Table(align, head, rows) then println(
                pad .. "Table cols=" .. #head .. " rows=" .. #rows
            )

            case Block.Rule then println(pad .. "Rule")
        end
    end
end

class Main
    static fn main()
        local path = Os.args()[1] ?? "../../md-viewer/docs/README.md"
        local file = Io.open(path, IoMode.Read)
        local content = file?.read('a')
        file?.close()

        if content != nil then
            local doc = Markdown.parse(content)
            dump(doc.getBlocks())
        else
            println("No content...")
        end
    end
end
