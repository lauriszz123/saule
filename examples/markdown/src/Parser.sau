import * from Ast
import * from LineScanner
import * from Slugger
import * from BlockParser

export class Markdown
    static fn parse(source: string) -> Document
        local slugger = Slugger()
        local parser = BlockParser(LineScanner(source), slugger)
        local blocks = parser.run()

        return Document(blocks, parser.headings(), parser.title())
    end
end
