import * from Ast
import * from LineScanner

export class Markdown
    static fn parse(source: string) -> Document
        local blocks: table<Block> = {}
        local scanner = LineScanner(source)

        while not scanner.eof() do
            local blanks = scanner.skipBlank()
            local line = scanner.next()
            if line != nil then
                Table.insert(blocks, Block.Paragraph({Inline.Text(String.trim(line))}))
            end
        end

        return Document(blocks, {})
    end
end
