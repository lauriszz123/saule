import * from Geometry
import * from Color
import * from TextStyle
import * from ThemeData
import * from Framework
import * from Layout

-- ============================================================================
-- Theme
-- ============================================================================
--
-- An ambient bundle of colours, text styles and metrics that every widget below
-- a `Theme` can read without being handed it.
--
-- Flutter does this with a generic `InheritedWidget`, and `Theme.of(context)`
-- is a typed lookup by runtime type. Saule has no downcasts, so a *generic*
-- version is out of reach — but a concrete one is not. The `Theme` widget
-- stores its data in element scratch on the way down, and `of` walks up the
-- element chain reading it. Copy the pattern for any other ambient value your
-- app needs; it is about twenty lines.

-- One shared default, so an unthemed app doesn't allocate a `ThemeData` per
-- lookup. `Theme.of` is called from every themed widget's build.
local defaults: table = {}

local fn fallback() -> ThemeData
	if defaults.value == nil then
		defaults.value = ThemeData()
	end

	return defaults.value
end

-- Publish a theme to everything below.
--
--     runApp(Theme(data: ThemeData.light(), child: MyApp()))
--
-- Themes nest: an inner one shadows the outer for its own subtree, which is how
-- a single panel gets a different accent without a separate widget tree.
export class Theme extends StatelessWidget
	data: ThemeData
	child: Widget?

	fn init(data: ThemeData? = nil, child: Widget? = nil, key: string? = nil)
		self.super(key)

		self.data = data ?? ThemeData()
		self.child = child
	end

	-- The nearest theme above `context`, or the default when there is none, so
	-- a widget used outside any `Theme` still renders.
	static fn of(context: BuildContext) -> ThemeData
		local node: Element? = context.element()
		local walking: boolean = true

		while walking do
			local current: Element? = node

			if current == nil then
				walking = false
			else
				local found = current!.data.theme

				if found != nil then
					return found
				end

				node = current!.parent
			end
		end

		return fallback()
	end

	fn build(context: BuildContext) -> Widget
		-- Written before the child is built, which is the whole trick: this
		-- element's scratch is already populated by the time anything below it
		-- calls `Theme.of`.
		context.data().theme = self.data

		return self.child ?? SizedBox()
	end
end
