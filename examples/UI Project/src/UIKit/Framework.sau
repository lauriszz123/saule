import * from engine
import * from Geometry
import * from Color
import * from ThemeData
import * from Events

-- ============================================================================
-- The view framework
-- ============================================================================
--
-- Two trees, the same way Flutter does it:
--
--   View   immutable description of what the UI should look like. Cheap to
--            throw away and rebuild on every frame.
--   Element  the persistent instance of a view at one position in the tree.
--            It owns everything mutable: the child list, the laid-out size and
--            offset, any `State`, and a scratch table for the view's own
--            per-instance bookkeeping.
--
-- Flutter has a third tree (`RenderObject`) that owns layout and painting.
-- Saule has no downcasts, so a `PaddingRenderObject` could never read the
-- `Padding` that configured it — every render class would be stuck with a
-- `View`-typed field it cannot inspect. Instead the *behaviour* lives on the
-- view as `layout` / `paint` / `handleEvent` methods that take the `Element`
-- holding the mutable state. Views stay immutable, elements stay generic,
-- and no cast is ever needed.
--
-- Everything mutually recursive lives in this one file because Saule forbids
-- circular imports.

-- ----------------------------------------------------------------------------
-- Pointer input
-- ----------------------------------------------------------------------------

export enum PointerKind
	Down,
	Up,
	Move,

	-- The wheel turned. Routed like a press — to the front-most view under
	-- the cursor, which lets nested scroll views work — and `scrollX` /
	-- `scrollY` carry the movement.
	Scroll
end

-- Which cursor the pointer should show this frame.
--
-- Views ask rather than set, because several of them are under the pointer at
-- once and only the innermost should win. Move events are dispatched
-- depth-first with the front-most sibling first, so the *first* request in a
-- frame is the innermost topmost one — which is why this keeps the first and
-- ignores the rest.
export class Cursors
	static local requested: string = ""
	static local applied: string = ""

	static fn request(cursor: string) -> nil
		if #Cursors.requested == 0 then
			Cursors.requested = cursor
		end
	end

	-- What was requested this frame, for tests and diagnostics.
	static fn wanted() -> string
		if #Cursors.requested == 0 then
			return "arrow"
		end

		return Cursors.requested
	end

	-- Called by the frame loop before routing the pointer.
	static fn beginFrame() -> nil
		Cursors.requested = ""
	end

	-- Called after routing. The engine call only happens on a change: setting
	-- the same cursor sixty times a second is a syscall per frame for nothing.
	static fn apply() -> nil
		local wanted: string = Cursors.requested

		if #wanted == 0 then
			wanted = "arrow"
		end

		if wanted != Cursors.applied then
			Cursors.applied = wanted
			Mouse.setCursor(wanted)
		end
	end
end

-- A repaint that no rebuild asks for.
--
-- The frame loop only repaints when something is dirty, which covers every
-- change that goes through `setState`. A few things animate inside `paint`
-- itself off the wall clock — a blinking caret, an indeterminate progress bar —
-- and nothing marks those dirty. They call `request` while painting, and that
-- is what brings the next frame around.
export class Repaint
	static local requested: boolean = false
	static local deadline: float = -1.0

	-- Repaint on the very next frame. For something that moves continuously,
	-- like an indeterminate progress bar.
	static fn request() -> nil
		Repaint.requested = true
	end

	-- Repaint once the clock reaches `at`, whenever that is. Several callers
	-- can ask and the earliest wins.
	--
	-- This is what a slow, stepped animation wants. A caret blinking twice a
	-- second only looks different on the two flips; asking for a frame at the
	-- next flip costs two repaints a second instead of sixty that draw the
	-- identical caret.
	static fn requestAt(at: float) -> nil
		if Repaint.deadline < 0.0 or at < Repaint.deadline then
			Repaint.deadline = at
		end
	end

	-- Consume whatever is due; the frame loop calls this once per frame.
	static fn take() -> boolean
		local wanted: boolean = Repaint.requested
		Repaint.requested = false

		local at: float = Repaint.deadline

		if at >= 0.0 and Timer.getTime() >= at then
			Repaint.deadline = -1.0
			wanted = true
		end

		return wanted
	end
end

-- How much work the last layout pass actually did.
--
-- `ran` counts elements that re-ran their layout; `skipped` counts those that
-- reused a cached size. On a settled screen almost everything should be
-- skipped — if `ran` stays high frame after frame, something is marking itself
-- dirty every frame.
export class LayoutStats
	static ran: integer = 0
	static skipped: integer = 0

	static fn reset() -> nil
		LayoutStats.ran = 0
		LayoutStats.skipped = 0
	end

	static fn describe() -> string
		return String.format("layout: %d ran, %d skipped", LayoutStats.ran, LayoutStats.skipped)
	end
end

-- Identity search over an element list. Instances compare by reference, which
-- is what makes an element usable as a stable key across frames.
local fn contains(list: table<Element>, element: Element) -> boolean
	for candidate: Element in list do
		if candidate == element then
			return true
		end
	end

	return false
end

export class PointerEvent
	kind: PointerKind

	-- Window coordinates. Each element converts these to its own local space
	-- before handing them to the view.
	x: float
	y: float

	-- Wheel movement for a `Scroll` event, zero otherwise. Positive `scrollY`
	-- is a scroll up, away from the user.
	scrollX: float
	scrollY: float

	-- Which button a `Down` or `Up` belongs to: 1 left, 2 right, 3 middle.
	-- `Move` and `Scroll` carry 0 — they belong to no button.
	button: integer

	fn init(
		kind: PointerKind,
		x: float,
		y: float,
		scrollX: float = 0.0,
		scrollY: float = 0.0,
		button: integer = 1
	)
		self.kind = kind
		self.x = x
		self.y = y
		self.scrollX = scrollX
		self.scrollY = scrollY
		self.button = button
	end

	-- The two the UI cares about. Middle-click is delivered but unnamed.
	fn isPrimary() -> boolean
		return self.button == 1
	end

	fn isSecondary() -> boolean
		return self.button == 2
	end
end

-- ----------------------------------------------------------------------------
-- Keyboard input
-- ----------------------------------------------------------------------------

export enum KeyEventKind

	-- A key went down. Repeats arrive as further `Down` events while the key
	-- is held, provided `runApp` enabled key repeat.
	Down,
	Up,

	-- Text was typed. This is layout- and modifier-aware, so shift+a arrives
	-- as "A" — never assemble text out of `Down` events.
	Text
end

export class KeyEvent
	kind: KeyEventKind

	-- Engine key name ("a", "backspace", "left", …). Empty for `Text`.
	key: string

	-- The characters typed. Empty for `Down` and `Up`.
	text: string

	shift: boolean
	ctrl: boolean
	alt: boolean

	-- The Command / Windows / Super key.
	meta: boolean

	fn init(
		kind: KeyEventKind,
		key: string = "",
		text: string = "",
		shift: boolean = false,
		ctrl: boolean = false,
		alt: boolean = false,
		meta: boolean = false
	)
		self.kind = kind
		self.key = key
		self.text = text
		self.shift = shift
		self.ctrl = ctrl
		self.alt = alt
		self.meta = meta
	end

	-- "The shortcut modifier", whichever one this platform uses: Command on
	-- macOS, Control everywhere else.
	--
	-- Every editing shortcut asks this rather than `ctrl`, because asking
	-- `ctrl` directly means copy and paste do not exist on a Mac: Cmd+C never
	-- sets `ctrl`, and Ctrl+C is not what anyone presses there. Both are
	-- accepted — a shortcut that still works when you guess wrong is not a bug
	-- worth fixing.
	fn command() -> boolean
		return self.ctrl or self.meta
	end
end

-- ----------------------------------------------------------------------------
-- Focus
-- ----------------------------------------------------------------------------

-- A handle on one focusable position in the tree, so code that is nowhere near
-- that position can still move focus to it:
--
--     local field: FocusNode = FocusNode()
--     ...
--     Focus(node: field, child: ...)
--     Button(label: "Edit", onPressed: fn() field.requestFocus() end)
--
-- Create it once and keep it — a node built fresh on every rebuild works, but
-- only for the rebuild it came from. Stash it in element scratch or a `State`.
export class FocusNode
	local manager: FocusManager?
	local element: Element?

	fn init()
		self.manager = nil
		self.element = nil
	end

	-- Called by the focus manager once per frame for every mounted node.
	fn bind(manager: FocusManager, element: Element) -> nil
		self.manager = manager
		self.element = element
	end

	fn hasFocus() -> boolean
		local manager: FocusManager? = self.manager
		local element: Element? = self.element

		if manager == nil or element == nil then
			return false
		end

		return manager!.isFocused(element!)
	end

	fn requestFocus() -> nil
		local manager: FocusManager? = self.manager
		local element: Element? = self.element

		if manager != nil and element != nil then
			manager!.setFocus(element)
		end
	end

	fn unfocus() -> nil
		if self.hasFocus() then
			local manager: FocusManager? = self.manager
			if manager != nil then
				manager!.setFocus(nil)
			end
		end
	end
end

-- What a view returns from `focusData()` to say "I can hold focus".
-- Returning nil means the view is skipped by focus and keyboard routing —
-- that is also how a disabled control opts out.
export class FocusData
	-- Optional handle for programmatic focus. Focus tracking itself uses the
	-- element, which is stable across rebuilds, so a node is never required.
	node: FocusNode?

	-- Take focus when nothing else holds it.
	autofocus: boolean

	-- Turn on text input while focused. Only a text editor wants this.
	wantsText: boolean

	-- Also receive keys that the focus chain ignored — including when nothing
	-- is focused at all. This is what makes a screen-level shortcut handler
	-- work without it having to own focus.
	global: boolean

	-- Whether Tab can land here. A pure listener sets this false so traversal
	-- doesn't park focus somewhere invisible.
	tabStop: boolean

	-- Confine focus to this subtree while it is mounted. A dialog sets this so
	-- Tab can't walk into the screen behind it.
	modal: boolean

	fn init(
		node: FocusNode? = nil,
		autofocus: boolean = false,
		wantsText: boolean = false,
		global: boolean = false,
		tabStop: boolean = true,
		modal: boolean = false
	)
		self.node = node
		self.autofocus = autofocus
		self.wantsText = wantsText
		self.global = global
		self.tabStop = tabStop
		self.modal = modal
	end
end

-- Tracks which element holds focus and routes key events to it.
--
-- Unlike pointer events, which go wherever the cursor is, key events go to the
-- focused element and then bubble up through its ancestors — so a shortcut
-- handler wrapped around a subtree sees whatever the focused control ignored.
export class FocusManager
	local focused: Element?

	-- Focusable elements in tree order, rebuilt once per frame. Tab traversal
	-- and focus validation both read it.
	local order: table<Element>

	-- `scopes[i]` is the innermost modal ancestor of `order[i]`, or nil when it
	-- isn't inside one. While any modal is mounted, everything outside the
	-- topmost one is off limits — that is what stops Tab walking out of a dialog
	-- into the screen behind it.
	local scopes: table<Element?>
	local activeScope: Element?

	fn init()
		self.focused = nil
		self.order = {}
		self.scopes = {}
		self.activeScope = nil
	end

	fn focusedElement() -> Element?
		return self.focused
	end

	fn isFocused(element: Element) -> boolean
		return self.focused == element
	end

	-- Re-derive the traversal order from the live tree. Run this after builds
	-- have settled and before routing keys: it binds every mounted node, drops
	-- focus that was rebuilt away, and applies `autofocus`.
	fn refresh(root: Element) -> nil
		self.order = {}
		self.scopes = {}
		self.collect(root, nil)

		-- The topmost modal wins: the last one collected is the one on top,
		-- because entries are collected in paint order.
		self.activeScope = nil

		local i: integer = 1

		while i <= #self.order do
			local data: FocusData? = self.order[i].view.focusData()

			if data != nil then
				if data!.modal then
					self.activeScope = self.order[i]
				end

				local node: FocusNode? = data!.node

				if node != nil then
					node!.bind(self, self.order[i])
				end
			end

			i = i + 1
		end

		local current: Element? = self.focused

		if current != nil and not self.inScope(current!) then
			self.setFocus(nil)
		end

		if self.focused == nil then
			self.applyAutofocus()
		end
	end

	-- Whether `element` is reachable given the modal in force, and still
	-- mounted at all.
	local fn inScope(element: Element) -> boolean
		local i: integer = 1

		while i <= #self.order do
			if self.order[i] == element then
				if self.activeScope == nil then
					return true
				end

				-- Inside the modal itself, or anywhere beneath it.
				return self.scopes[i] == self.activeScope or element == self.activeScope!
			end

			i = i + 1
		end

		return false
	end

	fn setFocus(element: Element?) -> nil
		local previous: Element? = self.focused

		if previous == element then
			return
		end

		self.focused = element

		if previous != nil then
			previous!.view.focusChanged(previous!, false)
		end

		if element != nil then
			element!.view.focusChanged(element!, true)
		end

		-- Text input is only worth capturing while an editor holds focus.
		Keyboard.setTextInput(self.wantsText())
	end

	fn unfocus() -> nil
		self.setFocus(nil)
	end

	-- Tab / shift-Tab traversal, wrapping at both ends.
	fn focusNext() -> nil
		self.move(1)
	end

	fn focusPrevious() -> nil
		self.move(-1)
	end

	-- True when the focused element wants typed text delivered.
	fn wantsText() -> boolean
		local element: Element? = self.focused

		if element == nil then
			return false
		end

		local data: FocusData? = element!.view.focusData()

		if data == nil then
			return false
		end

		return data!.wantsText
	end

	-- Deliver `event` to the focused element, then to each ancestor in turn,
	-- then to any global listener the walk didn't already cover.
	--
	-- The second pass is what keeps a screen-level shortcut alive when focus is
	-- elsewhere — or nowhere, which is the state right after an `unfocus()`.
	fn dispatchKey(root: Element, event: KeyEvent) -> boolean
		local chain: table<Element> = {}

		-- With nothing focused, keys go to the innermost modal if there is one,
		-- and to the root otherwise. Without the modal step a dialog whose
		-- content holds no focus — a menu, an alert with no buttons — could not
		-- even see its own Escape key.
		local current: Element? = self.focused ?? (self.activeScope ?? root)
		local walking: boolean = true

		-- Walk focused → root. The nil check is on a copy of `current`: a
		-- `while current != nil` guard narrows the binding, and then the
		-- reassignment at the bottom of the loop no longer typechecks.
		while walking do
			local target: Element? = current

			if target == nil then
				walking = false
			else
				chain[#chain + 1] = target!

				if target!.view.handleKey(target!, event) then
					return true
				end

				current = target!.parent
			end
		end

		local i: integer = 1

		while i <= #self.order do
			local element: Element = self.order[i]
			local data: FocusData? = element.view.focusData()

			-- A global listener behind a modal is out of reach too, or Escape
			-- would close the screen under the dialog.
			if data != nil and data!.global and self.reachable(i) and not contains(chain, element) then
				if element.view.handleKey(element, event) then
					return true
				end
			end

			i = i + 1
		end

		return false
	end

	local fn collect(element: Element, scope: Element?) -> nil
		local data: FocusData? = element.view.focusData()
		local inner: Element? = scope

		if data != nil then
			self.order[#self.order + 1] = element
			self.scopes[#self.order] = scope

			-- A modal becomes the scope for everything inside it, but is itself
			-- recorded against the scope it sits in.
			if data!.modal then
				inner = element
			end
		end

		local i: integer = 1

		while i <= element.childCount() do
			local child: Element? = element.childAt(i)

			if child != nil then
				self.collect(child!, inner)
			end

			i = i + 1
		end
	end

	-- Whether `order[index]` may take focus or receive keys right now.
	local fn reachable(index: integer) -> boolean
		if self.activeScope == nil then
			return true
		end

		return self.scopes[index] == self.activeScope or self.order[index] == self.activeScope!
	end

	local fn move(step: integer) -> nil
		-- Traversal only visits tab stops; a global listener is reachable by
		-- keys but not by Tab.
		local stops: table<Element> = {}
		local i: integer = 1

		while i <= #self.order do
			local element: Element = self.order[i]
			local data: FocusData? = element.view.focusData()

			if data != nil and data!.tabStop and self.reachable(i) then
				stops[#stops + 1] = element
			end

			i = i + 1
		end

		if #stops == 0 then
			return
		end

		-- Index 0 means "nothing focused", so stepping forward lands on the
		-- first entry and stepping back lands on the last.
		local index: integer = 0
		i = 1

		while i <= #stops do
			if stops[i] == self.focused then
				index = i
			end

			i = i + 1
		end

		local target: integer = index + step

		if target < 1 then
			target = #stops
		end

		if target > #stops then
			target = 1
		end

		self.setFocus(stops[target])
	end

	local fn applyAutofocus() -> nil
		local i: integer = 1

		while i <= #self.order do
			local data: FocusData? = self.order[i].view.focusData()

			if data != nil and data!.autofocus and self.reachable(i) then
				self.setFocus(self.order[i])

				return
			end

			i = i + 1
		end
	end
end

-- ----------------------------------------------------------------------------
-- Parent data
-- ----------------------------------------------------------------------------

-- What a `Positioned` tells its enclosing `ZStack`. This is Flutter's
-- `ParentData`, narrowed to the one case that needs it. It lives here rather
-- than next to `ZStack` so the base `View` can declare the hook that returns
-- it without importing the layout views back.
export class ZStackData
	left: float?
	top: float?
	right: float?
	bottom: float?
	width: float?
	height: float?

	fn init(
		left: float? = nil,
		top: float? = nil,
		right: float? = nil,
		bottom: float? = nil,
		width: float? = nil,
		height: float? = nil
	)
		self.left = left
		self.top = top
		self.right = right
		self.bottom = bottom
		self.width = width
		self.height = height
	end
end

-- ----------------------------------------------------------------------------
-- View
-- ----------------------------------------------------------------------------

-- The base class of everything you can put on screen.
--
-- A view is a *description*, not a live object: build one, hand it over, and
-- forget about it. Never store mutable state on a view — put it in a `State`
-- or in the element scratch (`context.data()`).
--
-- Subclasses override two groups of hooks:
--
--   composition   `body` (one subtree) or `childViews` (a fixed list)
--   rendering     `layout`, `paint`, `handleEvent`
--
-- The defaults implement "I am a transparent wrapper around a single child",
-- which is exactly what a `View` needs, so composite views only
-- ever override `body`.
export class View
	-- Identity across rebuilds. Two views reconcile onto the same element
	-- only when their class *and* key match.
	key: string?

	fn init(key: string? = nil)
		self.key = key

		-- Announce itself to whichever content block is open, if any. This is
		-- what lets children be written as bare statements — see `ViewBuilder`.
		ViewBuilder.emit(self)
	end

	-- Composite views describe themselves in terms of other views.
	-- Returning nil means "I am a render view, ask `childViews` instead".
	fn body(context: BuildContext) -> View?
		return nil
	end

	-- Children of a render view, in paint order: first is painted first and
	-- therefore sits at the back.
	fn childViews() -> table<View>
		return {}
	end

	-- Stateful views return a fresh state object here.
	fn createState() -> State?
		return nil
	end

	-- --- layout ------------------------------------------------------------
	--
	-- Measure this view under `constraints`, lay out its children, give each
	-- child an `offset` relative to this view's top-left corner, and return
	-- the size chosen. A child's own size is whatever its `layout` returned.
	fn layout(el: Element, constraints: Constraints) -> Size
		local child: Element? = el.childAt(1)

		if child == nil then
			return constraints.constrain(Size.zero())
		else
			local size: Size = child.layout(constraints)
			child.offset = Offset.zero()

			return size
		end
	end

	-- --- paint ---------------------------------------------------------------
	--
	-- `x` / `y` are this view's absolute top-left in window coordinates; its
	-- size is `el.size`. Draw yourself, then paint your children.
	fn paint(el: Element, x: float, y: float) -> nil
		el.paintChildren(x, y)
	end

	-- --- input ---------------------------------------------------------------
	--
	-- `x` / `y` are local to this view (negative or past `el.size` when the
	-- pointer is outside, which is what `inside` reports). Return true from a
	-- `Down` to claim the event and stop it reaching views behind you.
	--
	-- `Move` and `Up` are broadcast to the whole tree regardless of position,
	-- so a view can also notice that the pointer *left* it.
	fn handleEvent(el: Element, event: PointerEvent, x: float, y: float, inside: boolean) -> boolean
		return false
	end

	-- --- lifetime ------------------------------------------------------------

	-- This view's position is going away: the element is being unmounted and
	-- will never tick, build or paint again.
	--
	-- Anything a view opened that outlives its own subtree has to be closed
	-- here. An overlay layer is the case that matters — a tooltip, a dropdown,
	-- a picker — because those are held at the *root*, not under the view that
	-- opened them, so unmounting the opener leaves the layer on screen with
	-- nothing left to close it. `State` has `dispose` for the same job; this is
	-- the half a plain view was missing.
	fn unmounted(el: Element) -> nil
	end

	-- --- frame clock ---------------------------------------------------------

	-- Called once per frame with the elapsed seconds, before layout.
	--
	-- This is how a *stateless* view animates: advance whatever you own and
	-- call `el.markNeedsBuild()` on the frames where something actually changed.
	-- A `State` has its own `tick` for the same purpose.
	fn tick(el: Element, dt: float) -> nil
	end

	-- --- focus and keyboard --------------------------------------------------

	-- Non-nil makes this view focusable. Key events go to the focused
	-- element first and bubble up from there, so `handleKey` also fires on
	-- ancestors of whatever holds focus.
	fn focusData() -> FocusData?
		return nil
	end

	-- Return true to claim the event and stop it bubbling further up.
	fn handleKey(el: Element, event: KeyEvent) -> boolean
		return false
	end

	-- Focus arrived or left. Repaint-worthy state belongs in `el.data`.
	fn focusChanged(el: Element, focused: boolean) -> nil
	end

	-- --- parent data ---------------------------------------------------------

	-- Non-zero makes an enclosing `HStack` / `VStack` share its free space with
	-- this child instead of asking for the child's natural size.
	fn flexFactor() -> integer
		return 0
	end

	-- Non-nil makes an enclosing `ZStack` place this child explicitly.
	fn zStackData() -> ZStackData?
		return nil
	end

	-- --- modifiers -----------------------------------------------------------
	--
	-- Each of these returns *a new view wrapping this one*, so they chain:
	--
	--     Text("Saved")
	--         .padding(10.0)
	--         .background(Colors.success, radius: 6.0)
	--         .onTapGesture() do
	--             dismiss()
	--         end
	--
	-- Written as nesting, that same tree reads inside-out — the `Text` you care
	-- about is buried four constructors deep. Reading order and paint order
	-- disagree, and the closing parentheses pile up at the bottom.
	--
	-- Every one of them goes through `ViewModifiers` rather than naming
	-- `Padding` / `Box` / `GestureArea` directly. Those live in files that
	-- import *this* one, and Saule forbids circular imports, so the wrappers
	-- arrive as an installed implementation instead. See `Modifiers.sau`.

	-- Inset on every edge by `amount`, or by `insets` when the edges differ.
	fn padding(amount: float = 8.0, insets: EdgeInsets? = nil) -> View
		return Modifiers.get().padding(self, insets ?? EdgeInsets.all(amount))
	end

	-- Paint a filled, optionally rounded and outlined rectangle behind this
	-- view. The size is unchanged: a background wraps, it does not pad.
	fn background(
		color: Color? = nil,
		radius: float = 0.0,
		border: Color? = nil,
		borderWidth: float = 1.0
	) -> View
		return Modifiers.get().background(self, color, radius, border, borderWidth)
	end

	-- Just the outline, for when the fill would come from somewhere else.
	fn border(color: Color, width: float = 1.0, radius: float = 0.0) -> View
		return Modifiers.get().background(self, nil, radius, color, width)
	end

	-- Pin or bound an axis. An argument left nil is passed through untouched.
	--
	--     .frame(width: 120.0)          -- exactly this wide
	--     .frame(maxWidth: 380.0)       -- this wide at most, shrink-wrap below
	--
	-- Both groups at once nests the two, tight inside bounded, which is the
	-- order that leaves the bound able to win.
	fn frame(
		width: float? = nil,
		height: float? = nil,
		minWidth: float? = nil,
		maxWidth: float? = nil,
		minHeight: float? = nil,
		maxHeight: float? = nil
	) -> View
		local bounded: boolean = minWidth != nil
			or maxWidth != nil
			or minHeight != nil
			or maxHeight != nil

		-- Every branch ends in a `return`. A call on an interface-typed
		-- receiver types in return position but not as the right-hand side of
		-- an assignment, so the two cases are spelled out rather than composed
		-- through a mutable local.
		if not bounded then
			return Modifiers.get().frame(self, width, height)
		end

		if width == nil and height == nil then
			return Modifiers.get().limits(self, minWidth, maxWidth, minHeight, maxHeight)
		end

		-- Both: tight inside bounded, which is the order that leaves the bound
		-- able to win.
		return Modifiers.get().limits(
			Modifiers.get().frame(self, width, height),
			minWidth,
			maxWidth,
			minHeight,
			maxHeight
		)
	end

	-- Take a share of the leftover space in the enclosing stack instead of the
	-- natural size. Two siblings with weights 1 and 2 split it one-third /
	-- two-thirds.
	fn expanded(weight: integer = 1) -> View
		return Modifiers.get().expand(self, weight)
	end

	-- Place this view inside whatever space it is given.
	fn aligned(alignment: Alignment) -> View
		return Modifiers.get().align(self, alignment)
	end

	fn centered() -> View
		return Modifiers.get().align(self, Alignment.center())
	end

	-- Confine everything this subtree paints to its own rectangle.
	fn clipped() -> View
		return Modifiers.get().clip(self)
	end

	-- Fade the subtree as one image. Costs an offscreen buffer — fade groups,
	-- not leaves.
	fn opacity(value: float) -> View
		return Modifiers.get().opacity(self, value)
	end

	-- `fn()`. Left button.
	fn onTapGesture(action: function) -> View
		return Modifiers.get().onTap(self, action, false)
	end

	-- `fn()`. Right button — pair it with `showMenu`.
	fn onSecondaryTapGesture(action: function) -> View
		return Modifiers.get().onTap(self, action, true)
	end

	-- `fn(inside: boolean)`, on entry and on exit.
	fn onHover(action: function) -> View
		return Modifiers.get().onHover(self, action)
	end

	-- A label after a hover delay. SwiftUI spells this one `help`, and so do we.
	fn help(message: string) -> View
		return Modifiers.get().tooltip(self, message)
	end

	-- Ask for a cursor while the pointer is over this subtree. The innermost
	-- request in a frame wins.
	fn cursor(name: string) -> View
		return Modifiers.get().cursor(self, name)
	end
end

-- ----------------------------------------------------------------------------
-- The modifier registry
-- ----------------------------------------------------------------------------

-- What `View`'s modifiers are implemented in terms of.
--
-- This exists purely to break an import cycle. `View.padding` wants to build a
-- `Padding`, but `Padding` is declared in `Layout.sau`, which imports this
-- file — and Saule rejects circular imports outright rather than resolving
-- them lazily. So the direction is inverted: this file declares the *shape* of
-- the wrappers, and `Modifiers.sau` — which sits above every widget file and
-- can therefore name all of them — supplies the implementation.
--
-- Every method takes the view being wrapped as its first argument and returns
-- the wrapper, which keeps the whole interface free of any state.
export interface ViewModifiers
	fn padding(child: View, insets: EdgeInsets) -> View
	fn background(
		child: View,
		color: Color?,
		radius: float,
		border: Color?,
		borderWidth: float
	) -> View
	fn frame(child: View, width: float?, height: float?) -> View
	fn limits(
		child: View,
		minWidth: float?,
		maxWidth: float?,
		minHeight: float?,
		maxHeight: float?
	) -> View
	fn expand(child: View, weight: integer) -> View
	fn align(child: View, alignment: Alignment) -> View
	fn clip(child: View) -> View
	fn opacity(child: View, value: float) -> View
	fn onTap(child: View, action: function, secondary: boolean) -> View
	fn onHover(child: View, action: function) -> View
	fn tooltip(child: View, message: string) -> View
	fn cursor(child: View, name: string) -> View

	-- What a single-child block wraps several collected views in.
	fn stack(children: table<View>) -> View
end

-- Holds the one installed implementation.
--
-- `Modifiers.sau` installs itself with a top-level call, which runs when the
-- module is imported — and `UIKit/init.sau` imports it last. So anything that
-- reached a `View` at all went through the barrel, and the implementation is
-- in place long before the first frame.
export class Modifiers
	static local impl: ViewModifiers? = nil

	static fn install(modifiers: ViewModifiers) -> nil
		Modifiers.impl = modifiers
	end

	static fn get() -> ViewModifiers
		local impl: ViewModifiers? = Modifiers.impl

		if impl == nil then
			throw "view modifiers are not installed — import UIKit, not Framework on its own"
		end

		return impl!
	end
end

-- ----------------------------------------------------------------------------
-- ViewBuilder
-- ----------------------------------------------------------------------------
--
-- Children are written as plain statements inside a trailing block:
--
--     VStack(spacing: 8.0) do
--         Text("one")
--         Text("two").padding(4.0)
--     end
--
-- No table, no `return`, no commas — which is the whole point. SwiftUI gets
-- this from a result builder, a compiler feature that rewrites the block into
-- nested calls. Saule has no such thing, so this does the same job at runtime.
--
-- Three rules:
--
--   1. `View.init` **emits** every view it constructs into the innermost open
--      frame. A statement like `Text("one")` therefore records itself even
--      though its value is discarded.
--   2. Anything that takes a view as a child **claims** it back out of that
--      frame — it is somebody's child now, not a sibling. Every modifier wraps
--      in a `SingleChildView`, so `Text("x").padding(4.0)` emits twice and
--      claims once, leaving just the `Padding`.
--   3. A container **opens** a frame, runs the block, and **closes** it. What
--      the frame collected, in statement order, is its children.
--
-- The invariant rule 2 rests on: a view that ends up inside another view must
-- be claimed, or it shows up twice — once as a child and once as a sibling.
-- That is why every `View`-typed field in this kit is assigned through
-- `claimed` / `claimedAll` rather than directly.
--
-- The costs, stated plainly:
--
--   * It is dynamic, so a block that constructs a view and never uses it still
--     adds it. Every builder DSL of this shape behaves that way.
--   * A `throw` out of the middle of a block leaves its frame open, so the
--     build phase resets the stack before each rebuild.
export class ViewBuilder
	static local frames: table<table<View>> = {}

	-- Start collecting. Always paired with `close`.
	static fn open() -> nil
		ViewBuilder.frames[#ViewBuilder.frames + 1] = {}
	end

	-- Finish collecting and hand back what the block produced, in order.
	static fn close() -> table<View>
		local depth: integer = #ViewBuilder.frames

		if depth == 0 then
			return {}
		end

		local frame: table<View> = ViewBuilder.frames[depth]
		Table.remove(ViewBuilder.frames, depth)

		return frame
	end

	-- Called by `View.init` for every view ever constructed. Outside a block
	-- there is no open frame and this does nothing, which is what lets views
	-- built in a helper or held in a local behave like ordinary values.
	static fn emit(view: View) -> nil
		local depth: integer = #ViewBuilder.frames

		if depth == 0 then
			return
		end

		local frame: table<View> = ViewBuilder.frames[depth]
		frame[#frame + 1] = view
	end

	-- The other half: this view is now a child, so it stops being a sibling.
	--
	-- Every open frame is searched, innermost first — not just the top one.
	-- A helper called from inside a block builds its views while *that* block
	-- is open, but the container consuming them is often opened afterwards:
	--
	--     HStack() do              -- frame A opens
	--         self.chatList()      -- rows are built here, into frame A
	--     end                      -- …but the List that takes them opens
	--                              --   frame B first, and claiming only B
	--                              --   would leave every row in A as well
	--
	-- That is exactly how a list ends up drawn twice, once properly and once
	-- as loose siblings of whatever contains it.
	--
	-- Each frame is scanned from the end, because the nearest match is the one
	-- just wrapped, and views compare by identity — two `Text("hi")`s are
	-- different views, and claiming one must not remove the other.
	static fn claim(view: View?) -> nil
		local depth: integer = #ViewBuilder.frames

		if view == nil then
			return
		end

		while depth >= 1 do
			local frame: table<View> = ViewBuilder.frames[depth]
			local i: integer = #frame

			while i >= 1 do
				if frame[i] == view! then
					Table.remove(frame, i)

					return
				end

				i = i - 1
			end

			depth = depth - 1
		end
	end

	-- Abandon every open frame, so a block that threw cannot leak into the
	-- next rebuild.
	static fn reset() -> nil
		ViewBuilder.frames = {}
	end
end

-- Put an already-built view into the block you are inside.
--
--     local grid: View = TableView(columns: cols, rows: rows)
--
--     ScrollView() do
--         show(grid)
--     end
--
-- A block collects views *constructed inside it*, because that is the only
-- moment there is to notice them. A bare `grid` on its own line is not even a
-- statement, and a view built earlier never announced itself here — so without
-- this it would sit outside the block instead of in it, and the mistake would
-- be silent. `show` is the call that says "this one, here".
--
-- It claims first, so passing a view that *was* built in this block moves it to
-- this position rather than listing it twice.
export fn show(view: View) -> View
	ViewBuilder.claim(view)
	ViewBuilder.emit(view)

	return view
end

-- Take a view as a child: claim it, then hand it straight back.
--
--     self.child = claimed(child)
export fn claimed(child: View?) -> View?
	ViewBuilder.claim(child)

	return child
end

-- The same for a list of children.
export fn claimedAll(children: table<View>) -> table<View>
	for child: View in children do
		ViewBuilder.claim(child)
	end

	return children
end

-- The children a container was given, whichever way they arrived.
--
-- `children:` is still there for the case a block cannot express — a list
-- assembled in a loop, or one that came from somewhere else. The block wins if
-- somebody passes both.
export fn childrenOf(children: table<View>, content: (fn() -> nil)?) -> table<View>
	if content == nil then
		return claimedAll(children)
	end

	-- Bound to a typed local first: calling through the nullable directly
	-- leaves the result untyped, and Saule checks every position.
	local build: fn() -> nil = content!

	ViewBuilder.open()
	build()

	return ViewBuilder.close()
end

-- The same, for the wrappers that hold a single child.
--
-- A block that produced several views gets a `VStack` around them, the way
-- `ScrollView { … }` does in SwiftUI. The stack comes from the modifier
-- registry, because `VStack` lives in a file that imports this one.
export fn childOf(child: View?, content: (fn() -> nil)?) -> View?
	if content == nil then
		return claimed(child)
	end

	local collected: table<View> = childrenOf({}, content)

	if #collected == 0 then
		return nil
	end

	if #collected == 1 then
		return collected[1]
	end

	-- The stack is built *after* the frame closed, so it lands in the enclosing
	-- frame like any other view and has to be claimed straight back out.
	return claimed(Modifiers.get().stack(collected))
end

-- Base for the many render views that wrap exactly one optional child. It
-- only exists to spare every one of them the same `childViews` boilerplate.
export class SingleChildView extends View
	child: View?

	fn init(child: View? = nil, key: string? = nil)
		self.super(key)

		-- Every modifier wraps in one of these, so this single `claimed` is
		-- what keeps `Text("x").padding(4.0)` from leaving the `Text` behind
		-- as a sibling of its own `Padding`.
		self.child = claimed(child)
	end

	fn childViews() -> table<View>
		local child: View? = self.child

		if child == nil then
			return {}
		else
			return {child}
		end
	end
end

-- A view whose subtree depends on state that outlives a rebuild. Override
-- `createState`; the returned `State` object survives as long as the element.
export class StatefulView extends View
	fn init(key: string? = nil)
		self.super(key)
	end
end

-- ----------------------------------------------------------------------------
-- State
-- ----------------------------------------------------------------------------

-- The mutable half of a `StatefulView`, kept alive by the element across
-- rebuilds. Change fields inside `setState` so the framework knows to rebuild.
--
-- Note on configuration: `view` is typed `View` and Saule cannot downcast,
-- so a state cannot read its own view's fields through it. Pass whatever the
-- state needs into the constructor from `createState()` instead:
--
--     fn createState() -> State?
--         return CounterState(self.start)
--     end
--
-- For small interaction state (hover, pressed) prefer the element scratch on
-- `BuildContext.data()` — see `Button`.
export class State
	-- The configuration currently driving this state.
	view: View?

	local element: Element?

	fn init()
		self.view = nil
		self.element = nil
	end

	-- Called once by the framework right after the state is created, before
	-- the first build.
	fn attach(element: Element, view: View) -> nil
		self.element = element
		self.view = view
	end

	fn updateConfig(view: View) -> nil
		self.view = view
	end

	-- --- lifecycle hooks -----------------------------------------------------

	fn initState() -> nil
	end

	fn didUpdateView(oldWidget: View) -> nil
	end

	fn dispose() -> nil
	end

	-- Called once per frame with the elapsed seconds. Drive animations from
	-- here and call `setState` when a value changes.
	fn tick(dt: float) -> nil
	end

	fn body(context: BuildContext) -> View
		throw "State.body must be overridden"
	end

	-- --- framework interface -------------------------------------------------

	-- Run `update`, then mark this state's element for rebuild.
	fn setState(update: function) -> nil
		update()

		local el: Element? = self.element

		if el == nil then
			return
		end

		el.markNeedsBuild()

		-- And every overlay layer, because a layer's builder is an arbitrary
		-- closure that can read this state — a settings *route* showing these
		-- very fields, say. Routes and dialogs hang off the root as siblings of
		-- the tree, not as descendants, so marking this element does not reach
		-- them: the toggle you just flipped would keep drawing its old value
		-- until something else happened to rebuild the overlay.
		--
		-- Rebuilding all of them is blunt. There is no dependency tracking to
		-- be more precise with, and a layer's build is cheap next to being
		-- wrong; `AnimatedBuilder` and the scroll views already rebuild on
		-- their own clocks anyway.
		local owner: BuildOwner? = el.owner

		if owner != nil then
			owner!.overlay().markDirty()
		end
	end

	fn context() -> BuildContext?
		local el: Element? = self.element

		if el == nil then
			return nil
		else
			return el.context()
		end
	end

	fn isMounted() -> boolean
		local el: Element? = self.element

		if el == nil then
			return false
		else
			return el.isMounted()
		end
	end
end

-- ----------------------------------------------------------------------------
-- Element data
-- ----------------------------------------------------------------------------

-- The per-element state the framework itself owns.
--
-- These used to be string keys in an untyped `table`. That cost more than it
-- looked like: every read came back `any`, so `hovered` had to be compared
-- against `true` to become a boolean again; `data.hoverd` was as legal as
-- `data.hovered` and failed by silently never highlighting; and the editor
-- could not complete or document either one, because there was nothing to
-- complete — a `table` has no members to know about.
--
-- They are the same handful of flags in every control — `hovered` alone is
-- read in twenty-nine places — so they are declared once, here, and typed.
--
-- View-specific state does *not* belong here. Give the view a `State`
-- subclass (`Counter` / `CounterState` is the worked example) and keep it
-- there, where it gets the same typing and the same documentation.
export class ElementData
	-- The pointer is inside this element's box, tracked by `GestureArea`.
	hovered: boolean

	-- The pointer is inside, tracked by `CursorArea`. Deliberately separate
	-- from `hovered`: the two nest, and each needs its own edge detection, so
	-- a region's `onExit` must not be cancelled by a detector beneath it that
	-- is still reporting a hover.
	over: boolean

	-- A press started here and has not been released or cancelled.
	pressed: boolean

	-- A drag started here. Sliders and scrollbars keep following the pointer
	-- after it leaves their box, which is what separates this from `pressed`.
	dragging: boolean

	-- This position holds focus. Written by `Focus`, read by whatever paints
	-- the focus ring.
	focused: boolean

	-- The focus node for this position, created on demand by `nodeFor`. Nil
	-- until something focusable is built here.
	node: FocusNode?

	-- Double-tap detection: when the last tap landed, and where. `tapTime` is
	-- nil when there is no tap to pair with — either none yet, or the last one
	-- already completed a double.
	tapTime: float?
	tapX: float
	tapY: float

	-- The theme a `Theme` view installed at this position, which
	-- `Theme.of` finds by walking up from a context. Nil at every position
	-- that isn't a `Theme`.
	theme: ThemeData?

	-- Everything a view keeps that the framework knows nothing about:
	-- `TextField`'s caret, `Paint`'s cached canvas, `Scroll`'s controller.
	--
	-- Untyped, so a read is `any` and needs `as` to become anything else —
	-- which is the point. This is the pile that has not been given a `State`
	-- class yet, and it is meant to shrink to nothing rather than grow.
	scratch: table

	fn init()
		self.hovered = false
		self.over = false
		self.pressed = false
		self.dragging = false
		self.focused = false
		self.node = nil
		self.tapTime = nil
		self.tapX = 0.0
		self.tapY = 0.0
		self.theme = nil
		self.scratch = {}
	end
end

-- Shared scaffolding: every control needs the same focus node kept on the
-- element and the same "Space or Enter activates" rule, so that lives here
-- rather than being restated six times below. Exported because anything else
-- writing a focusable control wants exactly this.
export fn nodeFor(data: ElementData) -> FocusNode
	local existing: FocusNode? = data.node

	if existing != nil then
		return existing!
	end

	local new: FocusNode = FocusNode()
	data.node = new
	return new
end

export fn isActivator(event: KeyEvent) -> boolean
	return event.key == "return" or event.key == "space"
end

-- ----------------------------------------------------------------------------
-- Overlay
-- ----------------------------------------------------------------------------

-- One layer floating above the app.
--
-- Everything a view cannot do inside its own box — dialogs, dropdowns,
-- tooltips, toasts, drag ghosts — is done by putting an entry in the overlay.
-- Entries live at the root of the tree, so they paint above everything and are
-- hit-tested before it, no matter how deep the view that opened them sits.
--
-- The content is a `builder` (`fn() -> View`) rather than a fixed view, so
-- an entry re-reads whatever it closes over each time it rebuilds.
export class OverlayEntry
	builder: function

	-- Whether this layer is opaque to input: it swallows presses and the wheel
	-- that its own content did not claim, and confines focus to itself.
	--
	-- Off by default, because most layers should *not* do that. A toast has to
	-- let you carry on working underneath it, and a dialog or a menu brings its
	-- own `ModalBarrier` — which also decides what clicking outside means.
	-- A full-window route has neither, and covering the screen visually is not
	-- the same as covering it for the pointer: without this, a click on a blank
	-- part of a route lands on whatever the screen below happens to have there.
	opaque: boolean

	-- Identity for reconciliation. Entries come and go from the middle of the
	-- list, and without a key the element for entry 2 would be handed entry 3's
	-- view when 2 is removed — quietly wrecking the state inside it.
	local id: string

	static local nextId: integer = 1

	fn init(builder: function, opaque: boolean = false)
		self.builder = builder
		self.opaque = opaque
		self.id = "overlay#" .. OverlayEntry.nextId

		OverlayEntry.nextId = OverlayEntry.nextId + 1
	end

	fn key() -> string
		return self.id
	end

	fn content() -> View
		return self.builder()
	end
end

-- Wraps each entry so the entry's key rides on a view the framework controls.
-- The built content belongs to the caller and may be any view at all, so its
-- key is not ours to set.
export class OverlaySlot extends SingleChildView
	-- See `OverlayEntry.opaque`.
	opaque: boolean

	fn init(child: View? = nil, key: string? = nil, opaque: boolean = false)
		self.super(child, key)

		self.opaque = opaque
	end

	-- Focus is confined to an opaque layer, so Tab cannot walk into the screen
	-- behind it. Not a tab stop itself — it is a container, and traversal
	-- parking on it would land focus on nothing visible.
	fn focusData() -> FocusData?
		if not self.opaque then
			return nil
		end

		return FocusData(nil, false, false, false, false, true)
	end

	-- The layer's own views are dispatched first, so anything arriving here
	-- landed on a blank part of *this* layer. Absorb it rather than letting it
	-- fall through to the screen below.
	--
	-- `Move` and `Up` deliberately pass through: both are broadcast to the
	-- whole tree, and that broadcast is how a view under here learns the
	-- pointer left it. Swallowing them would strand it mid-hover. This is the
	-- same split `ModalBarrier` makes.
	fn handleEvent(el: Element, event: PointerEvent, x: float, y: float, inside: boolean) -> boolean
		if not self.opaque or not inside then
			return false
		end

		return event.kind == PointerKind.Down or event.kind == PointerKind.Scroll
	end
end

-- The overlay's entry list, owned by [`BuildOwner`].
--
--     local entry: OverlayEntry = OverlayEntry(fn()
--         return Center(child: myDialog)
--     end)
--     owner.overlay().insert(entry)
--     ...
--     owner.overlay().remove(entry)
--
-- Reach it from a view with `context.owner()?.overlay()`.
export class OverlayManager
	local entries: table<OverlayEntry>
	local host: Element?
	local dirty: boolean

	fn init()
		self.entries = {}
		self.host = nil
		self.dirty = false
	end

	-- The host element registers itself every frame. Knowing it lets a change
	-- mark the overlay dirty *immediately*, so a layer opened or closed midway
	-- through a frame is on screen at the end of that same frame rather than
	-- the next one.
	fn attachHost(element: Element) -> nil
		self.host = element

		if self.dirty then
			self.dirty = false
			element.markNeedsBuild()
		end
	end

	-- Add an entry on top of the others. Returns it, so the caller can hold on
	-- to it for removal.
	fn insert(entry: OverlayEntry) -> OverlayEntry
		if self.indexOf(entry) == 0 then
			self.entries[#self.entries + 1] = entry
			self.notify()
		end

		return entry
	end

	fn remove(entry: OverlayEntry) -> nil
		local at: integer = self.indexOf(entry)

		if at == 0 then
			return
		end

		Table.remove(self.entries, at)
		self.notify()
	end

	-- Mark the host for rebuild, or remember to do it once the host appears —
	-- an entry can be inserted before the first frame has run.
	local fn notify() -> nil
		local host: Element? = self.host

		if host == nil then
			self.dirty = true
		else
			host!.markNeedsBuild()
		end
	end

	fn contains(entry: OverlayEntry) -> boolean
		return self.indexOf(entry) != 0
	end

	fn clear() -> nil
		if #self.entries == 0 then
			return
		end

		self.entries = {}
		self.notify()
	end

	fn count() -> integer
		return #self.entries
	end

	fn entryAt(index: integer) -> OverlayEntry?
		if index < 1 or index > #self.entries then
			return nil
		end

		return self.entries[index]
	end

	-- The topmost entry, or nil when the overlay is empty.
	fn top() -> OverlayEntry?
		return self.entryAt(#self.entries)
	end

	-- Force the overlay to rebuild — call it when an entry's *content* changed
	-- without the entry list changing.
	fn markDirty() -> nil
		self.notify()
	end

	local fn indexOf(entry: OverlayEntry) -> integer
		local i: integer = 1

		while i <= #self.entries do
			if self.entries[i] == entry then
				return i
			end

			i = i + 1
		end

		return 0
	end
end

-- The root wrapper `runApp` installs: the app, then every overlay entry.
--
-- Order does all the work. Entries are laid out after the app, so they paint
-- over it; `Element.dispatch` walks children back to front, so they are also
-- hit-tested first. Nothing about painting or input needed special cases.
export class OverlayHost extends View
	root: View
	overlay: OverlayManager

	fn init(root: View, overlay: OverlayManager, key: string? = nil)
		self.super(key)

		self.root = root
		self.overlay = overlay
	end

	fn childViews() -> table<View>
		local out: table<View> = {self.root}
		local i: integer = 1

		while i <= self.overlay.count() do
			local entry: OverlayEntry? = self.overlay.entryAt(i)

			if entry != nil then
				out[#out + 1] = OverlaySlot(entry!.content(), entry!.key(), entry!.opaque)
			end

			i = i + 1
		end

		return out
	end

	-- Re-register every frame: the element is recreated whenever the host is
	-- rebuilt, and the manager needs the live one to mark it dirty.
	fn tick(el: Element, dt: float) -> nil
		self.overlay.attachHost(el)
	end

	-- Every layer gets the full window, so an entry positions its content with
	-- `Center`, `Align`, or a `ZStack` of `Positioned` children.
	fn layout(el: Element, constraints: Constraints) -> Size
		local size: Size = constraints.biggest()
		local layer: Constraints = Constraints.tight(size)
		local i: integer = 1

		while i <= el.childCount() do
			local child: Element? = el.childAt(i)

			if child != nil then
				child!.layout(layer)
				child!.offset = Offset.zero()
			end

			i = i + 1
		end

		return size
	end
end

-- A stack of full-screen routes, built on the overlay.
--
--     owner.navigator().push(fn()
--         return SettingsScreen()
--     end)
--     owner.navigator().pop()
--
-- A route is just an overlay entry that covers the window, so give it an opaque
-- background unless you want the screen below showing through.
export class Navigator
	local overlay: OverlayManager
	local routes: table<OverlayEntry>

	fn init(overlay: OverlayManager)
		self.overlay = overlay
		self.routes = {}
	end

	fn push(builder: function) -> OverlayEntry
		-- Opaque: a route covers the window, so it has to cover it for the
		-- pointer and for focus too, not merely for paint.
		local entry: OverlayEntry = OverlayEntry(builder, true)
		self.routes[#self.routes + 1] = entry
		self.overlay.insert(entry)

		return entry
	end

	fn pop() -> nil
		if #self.routes == 0 then
			return
		end

		local top: OverlayEntry = self.routes[#self.routes]
		Table.remove(self.routes, #self.routes)
		self.overlay.remove(top)
	end

	-- Swap the top route without growing the stack.
	fn replace(builder: function) -> OverlayEntry
		self.pop()

		return self.push(builder)
	end

	fn popToRoot() -> nil
		while #self.routes > 0 do
			self.pop()
		end
	end

	fn depth() -> integer
		return #self.routes
	end

	fn canPop() -> boolean
		return #self.routes > 0
	end
end

-- ----------------------------------------------------------------------------
-- BuildContext
-- ----------------------------------------------------------------------------

-- A handle to the element currently being built. Handed to every `body`.
export class BuildContext
	local node: Element

	fn init(element: Element)
		self.node = element
	end

	-- Size assigned by the last layout pass. Zero before the first frame.
	fn size() -> Size
		return self.node.size
	end

	-- State that belongs to this position in the tree and survives rebuilds.
	--
	-- The framework's own flags (`hovered`, `pressed`, `focused`, …) are typed
	-- fields on it; anything the view itself keeps goes in `.scratch` until
	-- it earns a `State` class. Reach for a `StatefulView` once that state is
	-- more than a couple of booleans.
	fn data() -> ElementData
		return self.node.data
	end

	-- Rebuild the subtree rooted here before the next frame is painted.
	fn markNeedsBuild() -> nil
		self.node.markNeedsBuild()
	end

	-- `@State`, as close as Saule gets.
	--
	--     local count: Binding = context.state("count", 0)
	--     ...
	--     Button(label: "+") do count.set(count.int() + 1) end
	--
	-- The value lives in the element's scratch, so it survives every rebuild at
	-- this position, and `set` marks the element dirty — which is the half a
	-- plain scratch write always forgets. SwiftUI gets the same effect from a
	-- property wrapper plus a dependency graph; this is the honest version for
	-- a language with neither.
	--
	-- Reach for a `StatefulView` and a `State` subclass instead when the state
	-- needs lifecycle hooks (`initState`, `dispose`, `tick`) or when there is
	-- enough of it to deserve typed fields.
	fn state(name: string, initial: any) -> Binding
		local bag: table = self.data().scratch

		if bag[name] == nil then
			bag[name] = initial
		end

		return Binding(bag, name, self)
	end

	-- The route stack, when this view is mounted under one. Every screen needs
	-- it to push and pop, and reaching it through `owner()` at each call site
	-- meant the same three-line nil dance everywhere.
	fn navigator() -> Navigator?
		local owner: BuildOwner? = self.owner()

		if owner == nil then
			return nil
		end

		return owner!.navigator()
	end

	fn owner() -> BuildOwner?
		return self.node.owner
	end

	-- The element this context speaks for.
	--
	-- The escape hatch for *inherited values*: walk up `parent`, reading each
	-- element's `data`, and you have an ambient value visible to a whole
	-- subtree without threading it through constructors. `Theme` is built this
	-- way, and anything else that wants the same shape can copy it — Saule
	-- can't downcast, so a generic `InheritedWidget<T>` is out of reach, but a
	-- concrete one costs a dozen lines.
	fn element() -> Element
		return self.node
	end
end

-- One named slot of a view's own state, and the rebuild that writing it needs.
--
-- Handed out by `BuildContext.state`. The typed readers are what a language
-- without generics can offer over an untyped bag: each one recovers the value
-- and falls back if the slot somehow holds something else, so a bad write
-- reverts rather than crashing a frame.
export class Binding
	local bag: table
	local name: string
	local context: BuildContext

	fn init(bag: table, name: string, context: BuildContext)
		self.bag = bag
		self.name = name
		self.context = context
	end

	fn int(fallback: integer = 0) -> integer
		return self.bag[self.name] as integer ?? fallback
	end

	fn number(fallback: float = 0.0) -> float
		return self.bag[self.name] as float ?? fallback
	end

	fn text(fallback: string = "") -> string
		return self.bag[self.name] as string ?? fallback
	end

	fn flag(fallback: boolean = false) -> boolean
		return self.bag[self.name] as boolean ?? fallback
	end

	-- The untyped slot, for values with no reader of their own (a `Date`, an
	-- enum). Cast it at the call site.
	fn value() -> any
		return self.bag[self.name]
	end

	-- Write, and schedule the rebuild that makes the write visible.
	fn set(next: any) -> nil
		self.bag[self.name] = next
		self.context.markNeedsBuild()
	end
end

-- ----------------------------------------------------------------------------
-- Element
-- ----------------------------------------------------------------------------

-- One live position in the tree. Elements are created by the framework, never
-- by user code; views receive theirs as the first argument to `layout`,
-- `paint` and `handleEvent`.
export class Element
	-- The view currently describing this position. Swapped on every
	-- reconcile, so never cache it across frames.
	view: View

	parent: Element?
	owner: BuildOwner?

	-- Written by the parent during layout. `offset` is relative to the
	-- parent's top-left corner.
	size: Size
	offset: Offset

	-- Per-element state: the framework's own typed flags, plus the untyped
	-- `scratch` for whatever the view here keeps. See `BuildContext.data()`.
	data: ElementData

	local kids: table<Element>
	local state: State?
	local ctx: BuildContext?
	local dirty: boolean
	local mounted: boolean

	-- Relayout boundary: the constraints this element was last laid out under,
	-- and whether anything since then could have changed the result.
	local lastConstraints: Constraints?
	local staleLayout: boolean

	fn init(view: View)
		self.view = view
		self.parent = nil
		self.owner = nil
		self.size = Size.zero()
		self.offset = Offset.zero()
		self.data = ElementData()
		self.kids = {}
		self.state = nil
		self.ctx = nil
		self.dirty = true
		self.mounted = false
		self.lastConstraints = nil
		self.staleLayout = true
	end

	-- --- lifecycle -----------------------------------------------------------

	fn mount(parent: Element?, owner: BuildOwner?) -> nil
		self.parent = parent
		self.owner = owner
		self.mounted = true

		local created: State? = self.view.createState()
		if created != nil then
			self.state = created
			created.attach(self, self.view)
			created.initState()
		end

		self.rebuild()
	end

	fn unmount() -> nil
		for child: Element in self.kids do
			child.unmount()
		end

		self.kids = {}

		-- Children first, then this one: a view cleaning up after itself should
		-- be able to assume its subtree is already gone.
		self.view.unmounted(self)

		local s: State? = self.state
		if s != nil then
			s.dispose()
		end

		self.state = nil
		self.mounted = false
	end

	-- Adopt a new configuration of the same view class.
	fn update(newWidget: View) -> nil
		local old: View = self.view
		self.view = newWidget

		local s: State? = self.state
		if s != nil then
			s.updateConfig(newWidget)
			s.didUpdateView(old)
		end

		-- A new configuration can lay out differently, even when the tree shape
		-- is identical.
		self.markNeedsLayout()
		self.rebuild()
	end

	fn markNeedsBuild() -> nil
		-- A rebuild can change sizes, so it invalidates layout too. Doing this
		-- unconditionally — even when already dirty — keeps the two flags from
		-- drifting apart if layout ran in between.
		self.markNeedsLayout()

		if self.dirty then
			return
		end

		self.dirty = true

		local o: BuildOwner? = self.owner
		if o != nil then
			o.scheduleBuild(self)
		end
	end

	-- Invalidate this element's cached layout, and every ancestor's — a child
	-- that changes size changes its parent's, all the way up.
	--
	-- The walk stops at the first element already marked, so a busy subtree
	-- costs one short hop rather than a full climb per change.
	fn markNeedsLayout() -> nil
		local node: Element? = self
		local walking: boolean = true

		while walking do
			local current: Element? = node

			if current == nil then
				walking = false
			elseif current!.staleLayout then
				walking = false
			else
				current!.staleLayout = true
				node = current!.parent
			end
		end
	end

	fn needsBuild() -> boolean
		return self.dirty
	end

	fn isMounted() -> boolean
		return self.mounted
	end

	fn context() -> BuildContext
		local existing: BuildContext? = self.ctx

		if existing != nil then
			return existing!
		end

		local created: BuildContext = BuildContext(self)
		self.ctx = created

		return created
	end

	-- --- build ---------------------------------------------------------------

	-- Re-describe this position and reconcile the child elements against it.
	fn rebuild() -> nil
		-- A `throw` out of the middle of a content block leaves its frame open.
		-- Nothing is collecting between rebuilds, so dropping the stack here
		-- costs nothing and keeps one failed build from corrupting the next.
		ViewBuilder.reset()

		self.dirty = false
		self.kids = Element.reconcile(self, self.kids, self.describeChildren(), self.owner)
	end

	local fn describeChildren() -> table<View>
		local s: State? = self.state

		if s != nil then
			return {s.body(self.context())}
		end

		local built: View? = self.view.body(self.context())

		if built != nil then
			return {built}
		end

		return self.view.childViews()
	end

	-- Two views describe the same position — and therefore keep the same
	-- element, its state and its scratch — when their class and key agree.
	static fn canUpdate(a: View, b: View) -> boolean
		return type(a) == type(b) and a.key == b.key
	end

	-- Match `news` against `olds`, reusing an element where `canUpdate` allows,
	-- mounting a fresh one where it doesn't, and unmounting whatever is left
	-- over.
	--
	-- A *keyed* view is matched against its key anywhere in the old list, so
	-- reordering a list carries each child's element — and therefore its state,
	-- scratch and scroll position — along with it. Unkeyed views are matched
	-- by position, which is what makes a plain list of children cheap.
	static fn reconcile(parent: Element, olds: table<Element>, news: table<View>, owner: BuildOwner?) -> table<Element>
		local out: table<Element> = {}

		-- Old elements still available for reuse; a slot is cleared as soon as
		-- something claims it.
		local pool: table<Element?> = {}
		local i: integer = 1

		while i <= #olds do
			pool[i] = olds[i]
			i = i + 1
		end

		i = 1

		while i <= #news do
			local view: View = news[i]
			local slot: integer = Element.claimSlot(pool, #olds, view, i)
			local reused: Element? = nil

			if slot > 0 then
				local old: Element? = pool[slot]

				if old != nil then
					pool[slot] = nil
					old!.update(view)
					reused = old
				end
			end

			if reused == nil then
				local fresh: Element = Element(view)
				fresh.mount(parent, owner)
				out[#out + 1] = fresh
			else
				out[#out + 1] = reused!
			end

			i = i + 1
		end

		-- Anything the new list didn't claim is gone.
		local j: integer = 1

		while j <= #olds do
			local leftover: Element? = pool[j]

			if leftover != nil then
				leftover!.unmount()
			end

			j = j + 1
		end

		return out
	end

	-- Which pool slot `view` should reuse, or 0 for "none — build fresh".
	--
	-- Keyed views search the whole pool; unkeyed ones only consider the slot
	-- they sit in, and only if that slot's old view is unkeyed too. Without
	-- that second condition an unkeyed view could steal a keyed element and
	-- undo the reordering the key exists to express.
	-- `count` is passed explicitly because clearing a claimed slot leaves a nil
	-- hole, and `#` over a table with holes is not something to lean on.
	static local fn claimSlot(pool: table<Element?>, count: integer, view: View, index: integer) -> integer
		if view.key != nil then
			local i: integer = 1

			while i <= count do
				local candidate: Element? = pool[i]

				if candidate != nil and Element.canUpdate(candidate!.view, view) then
					return i
				end

				i = i + 1
			end

			return 0
		end

		local atIndex: Element? = pool[index]

		if atIndex != nil and Element.canUpdate(atIndex!.view, view) then
			return index
		end

		return 0
	end

	-- --- children ------------------------------------------------------------

	fn childCount() -> integer
		return #self.kids
	end

	fn childAt(index: integer) -> Element?
		if index < 1 or index > #self.kids then
			return nil
		end

		return self.kids[index]
	end

	-- --- frame ---------------------------------------------------------------

	-- Lay this element out, or reuse last frame's result.
	--
	-- The cache hits when the constraints are identical *and* nothing in this
	-- subtree has been marked dirty since — which is the relayout boundary. A
	-- static screen lays out once and then costs a comparison per frame; a
	-- change re-runs only the chain from the changed element to the root, and
	-- its untouched siblings hit the cache in turn.
	--
	-- The contract this depends on: anything that can change layout must mark
	-- some element dirty. Rebuilds do it automatically; a render view that
	-- mutates its own scratch (a scroll offset, a drag) has to call
	-- `el.markNeedsLayout()` itself.
	fn layout(constraints: Constraints) -> Size
		local cached: Constraints? = self.lastConstraints

		if not self.staleLayout and cached != nil and cached!.sameAs(constraints) then
			LayoutStats.skipped = LayoutStats.skipped + 1

			return self.size
		end

		LayoutStats.ran = LayoutStats.ran + 1

		self.size = self.view.layout(self, constraints)
		self.lastConstraints = constraints
		self.staleLayout = false

		return self.size
	end

	-- Force the next layout to run even if the constraints match. Render views
	-- that keep layout-affecting state in `el.data` call this when it changes.
	fn invalidateLayout() -> nil
		self.markNeedsLayout()
	end

	-- `x` / `y` are the *parent's* absolute origin; this element's own origin
	-- adds its offset on top.
	fn paint(x: float, y: float) -> nil
		self.view.paint(self, x + self.offset.dx, y + self.offset.dy)
	end

	fn paintChildren(x: float, y: float) -> nil
		for child: Element in self.kids do
			child.paint(x, y)
		end
	end

	fn tick(dt: float) -> nil
		self.view.tick(self, dt)

		local s: State? = self.state
		if s != nil then
			s.tick(dt)
		end

		for child: Element in self.kids do
			child.tick(dt)
		end
	end

	-- Route a pointer event. `x` / `y` are the parent's absolute origin.
	-- Returns true when the event was claimed.
	fn dispatch(event: PointerEvent, x: float, y: float) -> boolean
		local ax: float = x + self.offset.dx
		local ay: float = y + self.offset.dy
		local lx: float = event.x - ax
		local ly: float = event.y - ay
		local inside: boolean = lx >= 0.0 and ly >= 0.0 and lx < self.size.width and ly < self.size.height

		if event.kind == PointerKind.Down or event.kind == PointerKind.Scroll then
			-- A press or a wheel turn is a real hit test: outside means not for
			-- us, and the front-most child that claims it ends the walk. That
			-- ordering is what makes an inner scroll view consume the wheel
			-- before the page behind it sees it.
			if not inside then
				return false
			end

			local i: integer = #self.kids
			while i >= 1 do
				if self.kids[i].dispatch(event, ax, ay) then
					return true
				end

				i = i - 1
			end

			return self.view.handleEvent(self, event, lx, ly, true)
		end

		-- Move and Up reach everyone: that is how a view learns the pointer
		-- left it, or that a press it was tracking ended somewhere else.
		local i: integer = #self.kids
		while i >= 1 do
			self.kids[i].dispatch(event, ax, ay)
			i = i - 1
		end

		self.view.handleEvent(self, event, lx, ly, inside)

		return false
	end

	-- --- debugging -----------------------------------------------------------

	fn debugDump(depth: integer) -> nil
		println(
			String.rep("  ", depth) .. String.format(
				"%s  size=%.0fx%.0f offset=%.0f,%.0f",
				type(self.view),
				self.size.width,
				self.size.height,
				self.offset.dx,
				self.offset.dy
			)
		)

		for child: Element in self.kids do
			child.debugDump(depth + 1)
		end
	end
end

-- ----------------------------------------------------------------------------
-- BuildOwner
-- ----------------------------------------------------------------------------

-- Owns the root element and the list of elements waiting to rebuild.
export class BuildOwner
	local dirty: table<Element>
	local root: Element?
	local focusManager: FocusManager
	local overlayManager: OverlayManager
	local navigatorInstance: Navigator

	fn init()
		self.dirty = {}
		self.root = nil
		self.focusManager = FocusManager()
		self.overlayManager = OverlayManager()
		self.navigatorInstance = Navigator(self.overlayManager)
	end

	fn focus() -> FocusManager
		return self.focusManager
	end

	-- Layers above the app: dialogs, menus, tooltips.
	fn overlay() -> OverlayManager
		return self.overlayManager
	end

	-- Full-screen routes, stacked on the same overlay.
	fn navigator() -> Navigator
		return self.navigatorInstance
	end

	fn attachRoot(view: View) -> Element
		local element: Element = Element(view)
		self.root = element
		element.mount(nil, self)

		return element
	end

	fn rootElement() -> Element?
		return self.root
	end

	fn scheduleBuild(element: Element) -> nil
		self.dirty[#self.dirty + 1] = element
	end

	-- Whether anything is waiting to rebuild. Every visual change routes
	-- through `markNeedsBuild`, so this is the frame loop's signal that the
	-- screen is out of date and has to be painted again.
	fn hasPendingWork() -> boolean
		return #self.dirty > 0
	end

	-- Rebuild everything that asked for it. A build may itself call
	-- `setState`, so drain repeatedly — with a cap, because a state that
	-- always dirties itself would otherwise spin forever.
	fn flush() -> nil
		local passes: integer = 0

		while #self.dirty > 0 and passes < 32 do
			local batch: table<Element> = self.dirty
			self.dirty = {}

			for element: Element in batch do
				if element.isMounted() and element.needsBuild() then
					element.rebuild()
				end
			end

			passes = passes + 1
		end
	end
end

-- ----------------------------------------------------------------------------
-- Running an app
-- ----------------------------------------------------------------------------

-- Route one event into the tree.
--
-- Pointer motion is deliberately absent: the frame loop resolves hover once per
-- frame from the latest position, because a view wants to know where the
-- pointer ended up, not every step it took getting there.
--
-- Tab is handled last, and only if nothing claimed it: a view that wants
-- literal tabs just returns true from `handleKey`.
-- Is Command (macOS) / Windows / Super held?
--
-- Polled rather than taken off the event: the engine's key events carry shift,
-- ctrl and alt only, so this is the one modifier that has to be read at level.
local fn metaDown() -> boolean
	return Keyboard.isAnyDown({"lgui", "rgui"})
end

local fn dispatchEvent(focus: FocusManager, root: Element, event: Event) -> nil
	match event
		case Event.MousePressed(x, y, button) then
			root.dispatch(
				PointerEvent(
					PointerKind.Down,
					Display.toLogical(x),
					Display.toLogical(y),
					0.0,
					0.0,
					button
				),
				0.0,
				0.0
			)

		case Event.MouseReleased(x, y, button) then
			root.dispatch(
				PointerEvent(
					PointerKind.Up,
					Display.toLogical(x),
					Display.toLogical(y),
					0.0,
					0.0,
					button
				),
				0.0,
				0.0
			)

		case Event.WheelMoved(dx, dy) then
			-- The wheel carries no position of its own, so it is routed to
			-- whatever is under the pointer right now — which is what makes
			-- nested scroll views work.
			local rawX: float, rawY: float = Mouse.getPos()

			root.dispatch(
				PointerEvent(
					PointerKind.Scroll,
					Display.toLogical(rawX),
					Display.toLogical(rawY),
					dx,
					dy
				),
				0.0,
				0.0
			)

		case Event.KeyPressed(key, shift, ctrl, alt) then
			local handled: boolean =
				focus.dispatchKey(
					root,
					KeyEvent(KeyEventKind.Down, key, "", shift, ctrl, alt, metaDown())
				)

			if not handled and key == "tab" then
				if shift then
					focus.focusPrevious()
				else
					focus.focusNext()
				end
			end

		case Event.KeyReleased(key, shift, ctrl, alt) then
			focus.dispatchKey(root, KeyEvent(KeyEventKind.Up, key, "", shift, ctrl, alt, metaDown()))

		-- Typed text is separate from key presses: it is already modifier- and
		-- layout-corrected, and one keypress can produce several characters.
		-- The event carries no modifiers of its own, so they are read at level
		-- — which is what a handler wants anyway ("was ctrl held as I typed").
		case Event.TextInput(typed) then
			focus.dispatchKey(
				root,
				KeyEvent(
					KeyEventKind.Text,
					"",
					typed,
					Keyboard.isAnyDown({"lshift", "rshift"}),
					Keyboard.isAnyDown({"lctrl", "rctrl"}),
					Keyboard.isAnyDown({"lalt", "ralt"}),
					metaDown()
				)
			)

		case _ then nil
	end
end

-- Open a window and drive `root` until it closes.
--
--     runApp(MyApp(), width: 900, height: 600, title: "Demo")
--
-- One frame is: tick animations, flush pending rebuilds, lay the tree out
-- against the window size, refresh focus, route the mouse and the keyboard,
-- flush again (a handler may have called `setState`), then paint.
--
-- `keyRepeat` is on by default because it is what editing keys want: hold
-- backspace and it keeps deleting. Turn it off for a game-style app that reads
-- held keys itself.
export fn runApp(
	root: View,
	width: integer = 800,
	height: integer = 600,
	title: string = "Saule",
	background: Color? = nil,
	keyRepeat: boolean = true
) -> nil
	Window.create(width, height, title)
	Keyboard.setKeyRepeat(keyRepeat)
	Keyboard.setTextInput(false)

	local owner: BuildOwner = BuildOwner()
	local focus: FocusManager = owner.focus()

	-- Everything runs under the overlay host, so a dialog opened from anywhere
	-- in the tree has somewhere to go.
	local rootElement: Element = owner.attachRoot(OverlayHost(root, owner.overlay()))
	local clear: Color = background ?? Colors.surface

	-- Repainting is the expensive half of a frame, and most frames change
	-- nothing: the pointer sits still, no animation is running, and the tree
	-- would be redrawn pixel for pixel identically. `needsPaint` gates that
	-- work. It starts true so the first frame always draws.
	local needsPaint: boolean = true

	while Window.isOpen() do
		local events: table<Event> = pollEvents()

		-- Both of these can change while running: the window is resizable, and
		-- moving it to another monitor can change the density.
		Display.setScale(Window.getScale())

		rootElement.tick(Timer.getDelta())

		-- An animation ticking marks its element dirty, so asking before the
		-- flush is what catches it — afterwards the list is empty again.
		if owner.hasPendingWork() then
			needsPaint = true
		end

		owner.flush()

		-- A resize hands back a fresh, blank framebuffer, so there is nothing
		-- left to keep and the frame has to be redrawn.
		for event: Event in events do
			match event
				case Event.Resized(_, _) then needsPaint = true

				case _ then nil
			end
		end

		local windowWidth: integer, windowHeight: integer = Window.getSize()
		local logical: Size = Size(
			Display.toLogical(float(windowWidth)),
			Display.toLogical(float(windowHeight))
		)

		rootElement.offset = Offset.zero()
		rootElement.layout(Constraints.tight(logical))

		-- Nothing arrived and nothing was already dirty, so no hit test can have
		-- changed its answer and no handler has anything to run. Skipping the
		-- focus walk and the hover pass is most of what an idle frame saves.
		if #events > 0 or needsPaint then
			-- Focus order follows the tree, so it has to be re-derived after the
			-- rebuilds above and before anything is routed.
			focus.refresh(rootElement)

			-- Hover is resolved once, from where the pointer is now. It runs
			-- even on a frame with no motion, because a scrolled list or a
			-- panel that grew moves views under a stationary pointer.
			--
			-- Pointer coordinates arrive in physical pixels; the tree is laid
			-- out in logical ones, so they have to be converted or every hit
			-- test is off by the scale factor.
			local rawX: float, rawY: float = Mouse.getPos()

			-- Cursor requests are gathered during the move pass and applied
			-- after, so the innermost view under the pointer wins.
			Cursors.beginFrame()
			rootElement.dispatch(
				PointerEvent(PointerKind.Move, Display.toLogical(rawX), Display.toLogical(rawY)),
				0.0,
				0.0
			)
			Cursors.apply()

			-- Then everything else, in the order it actually happened. Buttons,
			-- wheel and keys are interleaved exactly as the OS delivered them,
			-- which the old per-frame edge queries could not express.
			for event: Event in events do
				dispatchEvent(focus, rootElement, event)
			end
		end

		-- A handler may have called `setState`; rebuild before painting so the
		-- click is visible on this frame rather than the next one.
		if owner.hasPendingWork() then
			needsPaint = true
		end

		owner.flush()

		-- Then lay out *again*, because that rebuild can have replaced whole
		-- subtrees — a hover that gives a view a background changes its child's
		-- class, and the fresh elements have no size yet. Painting them
		-- unmeasured drew their contents at the parent's origin for one frame,
		-- which looked like the text jittering to the top-left before settling.
		--
		-- Relayout boundaries make this nearly free: with nothing dirty it is one
		-- comparison at the root.
		rootElement.layout(Constraints.tight(logical))

		-- A caret or an indeterminate bar animates inside `paint` off the
		-- clock, with no rebuild behind it. The previous frame's paint is what
		-- asks for this one.
		if Repaint.take() then
			needsPaint = true
		end

		if needsPaint then
			Graphics.clear(clear.r, clear.g, clear.b)

			-- One transform turns the whole logical tree into physical pixels.
			Graphics.push()
			Graphics.scale(Display.scale(), Display.scale())
			rootElement.paint(0.0, 0.0)
			Graphics.pop()

			needsPaint = false
		end

		-- Always present, even on a skipped frame: the framebuffer still holds
		-- the last one, and this is the loop's only pacing point — without it
		-- an idle app would spin as fast as the CPU allows.
		Graphics.present()
	end
end
