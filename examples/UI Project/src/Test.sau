import * from engine
import * from UIKit
import * from Shared
import * from Counter

-- The gallery as a pushable route: the panel below, plus the back arrow every
-- route gets. `PanelView` itself stays route-agnostic, so it is still usable
-- as a plain view.
export class GalleryScreen extends View
	fn init(key: string? = nil)
		self.super(key)
	end

	fn body(context: BuildContext) -> View
		return RouteScreen(title: "Widget gallery") do
			PanelView()
		end
	end
end

-- The panel itself: pure description, rebuilt whenever something above it
-- changes, and free of any layout arithmetic.
export class PanelView extends View
  fn init(key: string? = nil)
    self.super(key)
  end

  fn body(context: BuildContext) -> View
    local scratch: table = context.data().scratch

    if scratch.name == nil then
      scratch.name = ""
    end

    local name: string = scratch.name as string ?? ""
    local greeting: string = "Hello, stranger."

    if #name > 0 then
      greeting = "Hello, " .. name .. "."
    end

    -- Wrapping the panel means this listener sees every key the focused
    -- control ignored — that is all a screen-level shortcut needs.
    local panel: View = VStack(alignment: StackAlignment.Fill, spacing: 14.0) do
      Text("Saule UIKit").font(24.0).foregroundStyle(Colors.text)

      Text(
        "Tab moves focus and Enter presses. Ctrl+S saves, Esc unfocuses. " .. "In the field: shift+arrows select, Ctrl+A/C/X/V work, and " .. "clicking or dragging moves the caret. This paragraph wraps " .. "itself to whatever width the panel happens to be."
      ).foregroundStyle(Colors.textMuted)

      TextField(
        placeholder: "Your name",
        autofocus: true,
        onChanged: fn(text: string)
          scratch.name = text
          context.markNeedsBuild()
        end
      ) do (text: string)
        println("submitted: " .. text)
      end

      Text(greeting).font(18.0).foregroundStyle(Colors.text)

      Counter(label: "Taps", start: 3)

      self.settings(context, scratch)

      -- The canvas takes the slack, so the actions below it stay pinned to
      -- the bottom of the panel however tall the window is.
      self.canvas(context, scratch).expanded()

      self.actions(context)
    end

    -- Read bottom-up, the chain is the tree: pad the stack, put a rounded
    -- surface behind it, then hold the whole thing off the window edge.
    return KeyboardListener(
      onKeyDown: fn(event: KeyEvent)
        return self.shortcut(context, event)
      end,
      child: panel
        .padding(20.0)
        .background(Colors.surfaceLight, radius: 10.0, border: Colors.border)
        .padding(24.0)
    )
  end

  -- Screen-level keys. Returning false lets anything else keep bubbling.
  local fn shortcut(context: BuildContext, event: KeyEvent) -> boolean
    if event.key == "escape" then
      local owner: BuildOwner? = context.owner()

      if owner != nil then
        owner!.focus().unfocus()
      end

      return true
    end

    if event.ctrl and event.key == "s" then
      showToast(context, "Saved")

      return true
    end

    return false
  end

  -- The standard controls, all reading the ambient theme and all keyboard
  -- operable. Their values live in the panel's element scratch, which is what
  -- lets this stay a `View`.
  -- A chip per tag. `FlowStack` breaks them onto a new line as the panel narrows,
  -- which an `HStack` cannot do.
  local fn tags(theme: ThemeData) -> table<View>
    local names: table<string> = {
      "design",
      "layout",
      "keyboard",
      "overlay",
      "scrolling",
      "animation",
      "theming",
    }
    local chips: table<View> = {}

    for name: string in names do
      chips[#chips + 1] = Text(name, style: theme.caption)
        .padding(insets: EdgeInsets.symmetric(horizontal: 10.0, vertical: 3.0))
        .background(theme.surface, radius: 10.0, border: theme.border)
    end

    return chips
  end

  local fn settings(context: BuildContext, scratch: table) -> View
    local theme: ThemeData = Theme.of(context)

    if scratch.notify == nil then
      scratch.notify = true
      scratch.sound = false
      scratch.volume = 0.6
      scratch.region = "Lithuania"
      scratch.due = Date.today()
    end

    -- The scratch is an untyped bag, so each setting is recovered once here
    -- and read from a typed local below. The fallbacks repeat the seeds above
    -- so a slot holding something unexpected reverts rather than crashes.
    local notify: boolean = scratch.notify as boolean ?? true
    local sound: boolean = scratch.sound as boolean ?? false
    local volume: float = scratch.volume as float ?? 0.6
    local region: string = scratch.region as string ?? "Lithuania"
    local due: Date = scratch.due as Date ?? Date.today()

    local rebuild: function = fn()
      context.markNeedsBuild()
    end

    return VStack(alignment: StackAlignment.Fill, spacing: 10.0) do
      HStack(spacing: 18.0) do
        Checkbox(value: notify, label: "Notify me") do (next: boolean)
          scratch.notify = next
          rebuild()
        end

        Toggle(value: sound, label: "Sound") do (next: boolean)
          scratch.sound = next
          rebuild()
        end

        Spacer()

        DateField(value: due, width: 190.0) do (picked: Date)
          scratch.due = picked
          rebuild()
        end

        Picker(
          value: region,
          options: {"Lithuania", "Latvia", "Estonia", "Poland"},
          width: 160.0
        ) do (next: string)
          scratch.region = next
          rebuild()
        end
      end

      -- The chips are built in a loop, so they arrive as `children:`. That
      -- door stays open precisely for lists a block cannot spell out.
      FlowStack(spacing: 6.0, runSpacing: 6.0, children: self.tags(theme))

      Divider()

      HStack(spacing: 12.0) do
        Slider(value: volume) do (next: float)
          scratch.volume = next
          rebuild()
        end.expanded()

        ProgressView(value: volume).aligned(Alignment.centerLeft()).frame(width: 120.0)
      end
    end
  end

  -- Three panes behind a tab strip: a scrollable list, a live Canvas
  -- surface, and the multi-line editor. Only the selected one is built.
  local fn canvas(context: BuildContext, scratch: table) -> View
    if scratch.tab == nil then
      scratch.tab = 1
      scratch.notes = "Type here.\nEnter makes a new line, Ctrl+Z undoes, " .. "Ctrl+arrows move by word, and a double-click selects one."
    end

    -- Recovered from the untyped scratch once, as with the settings above.
    local tab: integer = scratch.tab as integer ?? 1
    local notes: string = scratch.notes as string ?? ""

    local gap: EdgeInsets = EdgeInsets.only(top: 10.0)

    -- `onChanged` is passed by name, which frees the trailing block for the
    -- panes — that is the whole trailing-block rule in one call.
    return TabView(
      tabs: {"List", "Canvas", "Notes"},
      index: tab,
      onChanged: fn(next: integer)
        scratch.tab = next
        context.markNeedsBuild()
      end
    ) do
      self.rows(context).padding(insets: gap)

      BouncingBall()
        .clipped()
        .background(Colors.surface, radius: 8.0)
        .padding(insets: gap)

      TextEditor(value: notes, placeholder: "Notes", minLines: 5) do (text: string)
        scratch.notes = text
      end.padding(insets: gap)
    end
  end

  -- Twenty rows in a box that fits about six: scroll it with the wheel. Each
  -- row is keyed, so reordering the list would carry the elements with it.
  local fn rows(context: BuildContext) -> View
    local items: table<View> = {}

    for i: integer = 1, 20 do
      local shade: Color = Colors.surface

      if i % 2 == 0 then
        shade = Colors.surfaceLight
      end

      -- The key stays on the `Box`, not on a modifier: identity belongs to
      -- the view the list reconciles, and that is the outermost one.
      items[#items + 1] = Box(
        key: "row" .. i,
        color: shade,
        padding: EdgeInsets.symmetric(horizontal: 10.0, vertical: 6.0),
        child: Text("item " .. i, style: TextStyle(color: Colors.textMuted))
      )
    end

    return GestureArea(
      child: List(children: items, spacing: 2.0)
        .clipped()
        .background(Colors.surface, radius: 8.0),
      onSecondaryTap: fn()
        -- At the pointer, which is where a context menu belongs.
        --
        -- The tap coordinates `onSecondaryTapAt` reports are local to
        -- the detector that received them, and turning those into
        -- window coordinates needs *that* element — not this build
        -- context, which belongs to the whole panel several levels up.
        -- Adding the panel's origin to a list-local point put the menu
        -- near the top of the panel instead of under the cursor.
        local at: Offset = pointerPosition()

        showMenu(
          context,
          at.dx,
          at.dy,
          items: {
            MenuItem("Open", fn()
              showToast(context, "Open")
            end),
            MenuItem("Rename", enabled: true) do
              showToast(context, "Rename")
            end,
            MenuItem("Delete") do
              showToast(context, "Delete")
            end,
          }
        )
      end
    )
  end

  -- `Spacer` eats the slack, so the two buttons after it sit on the right.
  -- The last three open things that live *above* the panel: a menu, a modal
  -- dialog, and a tooltip.
  local fn actions(context: BuildContext) -> View
    return HStack(spacing: 10.0) do
      IconButton(icon: Icons.moreVert, tooltip: "Menu") do
        self.openMenu(context)
      end

      Text("right-click the list too").foregroundStyle(Colors.textMuted)

      Spacer()

      Button(label: "Delete", color: Colors.danger) do
        self.confirmDelete(context)
      end

      Button(label: "Save", color: Colors.success) do
        showToast(context, "Saved")
      end.help("Ctrl+S also saves")
    end
  end

  -- A menu at the cursor. `showMenu` keeps it on screen near the edges.
  local fn openMenu(context: BuildContext) -> nil
    -- `Mouse.getPos` alone is physical pixels, so this drifted from the
    -- cursor on a scaled display; `pointerPosition` converts.
    local at: Offset = pointerPosition()

    showMenu(
      context,
      at.dx,
      at.dy,
      items: {
        MenuItem("Duplicate") do
          println("duplicate")
        end,
        MenuItem("Export") do
          println("export")
        end,
        MenuItem("Unavailable", enabled: false),
      }
    )
  end

  -- A modal: focus moves inside it, Tab cannot leave, Esc or the barrier
  -- closes it.
  local fn confirmDelete(context: BuildContext) -> nil
    local handle: OverlayHandle? = nil

    -- `showDialog` wants a view back, so this block does return one — the
    -- content blocks *inside* it are the statement-shaped kind.
    handle = showDialog(context) do
      return VStack(alignment: StackAlignment.Fill, sizing: StackSize.Fit, spacing: 14.0) do
        Text("Delete this panel?").font(18.0).foregroundStyle(Colors.text)

        Text(
          "Nothing is actually deleted — this is here to show a modal " .. "trapping focus and swallowing clicks behind it."
        ).foregroundStyle(Colors.textMuted)

        HStack(spacing: 10.0) do
          Spacer()

          Button(label: "Cancel", color: Colors.surface) do
            handle?.dismiss()
          end

          Button(label: "Delete", color: Colors.danger, autofocus: true) do
            println("deleted")
            handle?.dismiss()
          end
        end
      end
    end
  end
end

-- A tiny simulation, drawn with `Canvas`'s sibling: a render view that
-- owns per-frame state.
--
-- This is the games pattern. `tick` advances the ball and `paint` draws it, both
-- once per frame — and neither touches the build system, so there is no rebuild
-- at all. Simulation state lives in element scratch, which survives rebuilds of
-- everything around it.
export class BouncingBall extends View
  radius: float
  color: Color?

  fn init(radius: float = 12.0, color: Color? = nil, key: string? = nil)
    self.super(key)

    self.radius = radius
    self.color = color
  end

  fn layout(el: Element, constraints: Constraints) -> Size
    return constraints.biggest()
  end

  fn tick(el: Element, dt: float) -> nil
    local scratch: table = el.data.scratch

    if scratch.x == nil then
      scratch.x = self.radius
      scratch.y = self.radius
      scratch.dx = 190.0
      scratch.dy = 145.0
    end

    -- Nothing to bounce off until the first layout has run.
    if el.size.width <= 0.0 or el.size.height <= 0.0 then
      return
    end

    local dx: float = scratch.dx as float ?? 0.0
    local dy: float = scratch.dy as float ?? 0.0
    local x: float = (scratch.x as float ?? 0.0) + dx * dt
    local y: float = (scratch.y as float ?? 0.0) + dy * dt

    if x < self.radius then
      x = self.radius
      dx = -dx
    elseif x > el.size.width - self.radius then
      x = el.size.width - self.radius
      dx = -dx
    end

    if y < self.radius then
      y = self.radius
      dy = -dy
    elseif y > el.size.height - self.radius then
      y = el.size.height - self.radius
      dy = -dy
    end

    scratch.x = x
    scratch.y = y
    scratch.dx = dx
    scratch.dy = dy
  end

  fn paint(el: Element, x: float, y: float) -> nil
    local scratch: table = el.data.scratch

    if scratch.x == nil then
      return
    end

    local ballX: float = scratch.x as float ?? 0.0
    local ballY: float = scratch.y as float ?? 0.0

    -- A trail, to make it obvious this is running every frame.
    local trail: Color = (self.color ?? Colors.warning).withAlpha(0.25)
    trail.apply()
    Graphics.circle("fill", x + ballX, y + ballY, self.radius * 1.8)

    local fill: Color = self.color ?? Colors.warning
    fill.apply()
    Graphics.circle("fill", x + ballX, y + ballY, self.radius)

    -- Through a style rather than `Graphics.print` directly: the style binds
    -- a font, and drawing raw text would inherit whatever face was last set.
    TextStyle(color: Colors.textMuted).draw("tick + paint, no rebuilds", x + 8.0, y + 8.0)
  end
end
