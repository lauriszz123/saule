import * from "uikit"
import * from Home

-- The app itself: what window it opens, and what goes in it.
--
-- Everything below the `Theme` reads its palette through `Theme.of(context)` —
-- swap it for `ThemeData.light()` to see it.
export class DemoApp extends App
	fn body() -> Scene
		local theme = ThemeData.light()
		return WindowGroup(title: "Saule UIKit", width: 1200, height: 800) do
			Theme(data: theme) do
				HomeScreen()
			end
		end
	end
end

-- `Main.main` is the entry Saule calls; everything about the app is declared
-- on `DemoApp`, not spelled out here.
class Main
	static fn main()
		DemoApp().run()
	end
end
