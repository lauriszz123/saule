import * from "uikit"

-- A counter, written the way SwiftUI writes one.
--
-- `context.state` is this kit's `@State`: a named slot in the element's own
-- scratch that survives every rebuild at this position, and a `set` that marks
-- the element dirty so the write actually shows. No `StatefulView`, no `State`
-- subclass, no `createState` — for a single integer, none of that earns its
-- keep. Reach for `StatefulView` when the state needs `initState`, `tick` or
-- `dispose`, or when there is enough of it to deserve typed fields.
export class Counter extends View
	label: string
	start: integer

	fn init(label: string = "Count", start: integer = 0, key: string? = nil)
		self.super(key)

		self.label = label
		self.start = start
	end

	fn body(context: BuildContext) -> View
		local count: Binding = context.state("count", self.start)

		return HStack(sizing: StackSize.Fit, spacing: 8.0) do
			Button(label: "-") do
				count.set(count.int() - 1)
			end

			Text(self.label .. ": " .. count.int())
				.foregroundStyle(Colors.text)
				.centered()
				.frame(width: 120.0)

			Button(label: "+") do
				count.set(count.int() + 1)
			end
		end
	end
end
