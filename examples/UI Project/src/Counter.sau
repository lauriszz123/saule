import * from UIKit

-- A stateful counter.
--
-- Saule has no downcasts, so a `State` cannot read fields off `self.widget`
-- (it is typed `Widget`). Hand the state whatever configuration it needs from
-- `createState()` instead — explicit, and it type-checks.
export class Counter extends StatefulWidget
	label: string
	start: integer

	fn init(label: string = "Count", start: integer = 0, key: string? = nil)
		self.super(key)

		self.label = label
		self.start = start
	end

	fn createState() -> State?
		return CounterState(self.label, self.start)
	end
end

class CounterState extends State
	local label: string
	local count: integer

	fn init(label: string, start: integer)
		self.super()

		self.label = label
		self.count = start
	end

	local fn bump(by: integer) -> nil
		self.setState(fn()
			self.count = self.count + by
		end)
	end

	fn build(context: BuildContext) -> Widget
		return Row(
			children: {
				Button(label: "-", onPressed: fn()
					self.bump(-1)
				end),
				Container(
					width: 120.0,
					alignment: Alignment.center(),
					child: Text(self.label .. ": " .. self.count, style: TextStyle(color: Colors.text))
				),
				Button(label: "+", onPressed: fn()
					self.bump(1)
				end),
			},
			mainAxisSize: MainAxisSize.Min,
			spacing: 8.0
		)
	end
end
