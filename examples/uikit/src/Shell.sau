import * from engine
import * from Geometry
import * from Color
import * from TextStyle
import * from Framework
import * from Layout
import * from Paint
import * from Gesture
import * from Overlay
import * from ThemeData
import * from Theme

-- ============================================================================
-- Page structure
-- ============================================================================
--
-- The frame around an app: a bar at the top, the body, an optional strip at the
-- bottom, and the small pieces that go with them.

-- A hairline. Themed, so it matches whatever surface it sits on.
--
-- `indent` and `endIndent` inset the line without moving the space it occupies,
-- which is how a divider lines up with text rather than the container's edge.
export class Divider extends View
	thickness: float
	color: Color?
	indent: float
	endIndent: float

	fn init(
		thickness: float = 1.0,
		color: Color? = nil,
		indent: float = 0.0,
		endIndent: float = 0.0,
		key: string? = nil
	)
		self.super(key)

		self.thickness = thickness
		self.color = color
		self.indent = indent
		self.endIndent = endIndent
	end

	fn body(context: BuildContext) -> View
		local theme: ThemeData = Theme.of(context)

		return Box(height: self.thickness, color: self.color ?? theme.border).padding(
			insets: EdgeInsets.only(left: self.indent, right: self.endIndent)
		)
	end
end

-- The same, turned ninety degrees — a separator between columns.
export class VerticalDivider extends View
	thickness: float
	color: Color?
	indent: float
	endIndent: float

	fn init(
		thickness: float = 1.0,
		color: Color? = nil,
		indent: float = 0.0,
		endIndent: float = 0.0,
		key: string? = nil
	)
		self.super(key)

		self.thickness = thickness
		self.color = color
		self.indent = indent
		self.endIndent = endIndent
	end

	fn body(context: BuildContext) -> View
		local theme: ThemeData = Theme.of(context)

		return Box(width: self.thickness, color: self.color ?? theme.border).padding(
			insets: EdgeInsets.only(top: self.indent, bottom: self.endIndent)
		)
	end
end

-- A title bar: an optional leading view, a title, and trailing actions.
--
--     Toolbar(title: "Inbox", actions: {refreshButton, menuButton})
export class Toolbar extends View
	title: string
	leading: View?
	actions: table<View>
	height: float
	background: Color?

	fn init(
		title: string = "",
		leading: View? = nil,
		actions: table<View> = {},
		height: float = 52.0,
		background: Color? = nil,
		key: string? = nil
	)
		self.super(key)

		self.title = title
		self.leading = claimed(leading)
		self.actions = claimedAll(actions)
		self.height = height
		self.background = background
	end

	fn body(context: BuildContext) -> View
		local theme: ThemeData = Theme.of(context)
		local row: table<View> = {}

		local leading: View? = self.leading

		if leading != nil then
			row[#row + 1] = leading!
			row[#row + 1] = Frame(width: 10.0)
		end

		row[#row + 1] = Text(self.title, style: theme.title, softWrap: false, maxLines: 1)
			.aligned(Alignment.centerLeft())
			.expanded()

		for action: View in self.actions do
			row[#row + 1] = action
		end

		return VStack(alignment: StackAlignment.Fill, sizing: StackSize.Fit) do
			HStack(spacing: 8.0, children: row)
				.padding(insets: EdgeInsets.symmetric(horizontal: 16.0))
				.background(self.background ?? theme.surfaceLight)
				.frame(height: self.height)

			Divider()
		end
	end
end

-- The page frame: toolbar, content, optional footer, on a themed background.
--
--     Screen(toolbar: Toolbar(title: "Inbox"), footer: statusStrip) do
--         messageList
--     end
--
-- The content gets whatever height is left, so it is the thing that scrolls.
--
-- The block fills `content`; the bar and the strip stay named, because a block
-- can only mean one of the three. The slot is `content` rather than `body`
-- because `body` is the method every view overrides to describe itself, and a
-- field of that name would sit right next to the method that reads it.
export class Screen extends View
	toolbar: View?
	content: View?
	footer: View?
	background: Color?
	padding: EdgeInsets?

	fn init(
		content: View? = nil,
		toolbar: View? = nil,
		footer: View? = nil,
		background: Color? = nil,
		padding: EdgeInsets? = nil,
		key: string? = nil,
		builder: (fn() -> nil)? = nil
	)
		self.super(key)

		self.content = childOf(content, builder)
		self.toolbar = claimed(toolbar)
		self.footer = claimed(footer)
		self.background = background
		self.padding = padding
	end

	fn body(context: BuildContext) -> View
		local theme: ThemeData = Theme.of(context)
		local rows: table<View> = {}

		local bar: View? = self.toolbar

		if bar != nil then
			rows[#rows + 1] = bar!
		end

		local middle: View = self.content ?? Frame()
		local padding: EdgeInsets? = self.padding

		if padding != nil then
			middle = middle.padding(insets: padding)
		end

		rows[#rows + 1] = middle.expanded()

		local footer: View? = self.footer

		if footer != nil then
			rows[#rows + 1] = Divider()
			rows[#rows + 1] = footer!
		end

		return VStack(alignment: StackAlignment.Fill, children: rows).background(
			self.background ?? theme.background
		)
	end
end
