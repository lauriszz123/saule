import * from engine
import * from Geometry
import * from Color
import * from Framework
import * from Layout
import * from Paint
import * from Gesture
import * from Tween
import * from Animation

-- ============================================================================
-- Scrolling
-- ============================================================================
--
-- A scroll view is three things stacked up: an unbounded constraint on the
-- scroll axis so the child can be as long as it likes, a clip at the viewport
-- edge, and a negative offset on the child. The wheel adjusts the offset; the
-- rest falls out of the layout system.

export enum ScrollAxis
	Vertical,
	Horizontal
end

-- Where a scroll view is scrolled to, and the only mutable part of scrolling.
--
-- Hold one yourself when you need to read or drive the position (jump to top,
-- sync two views); otherwise let `ScrollView` keep its own in
-- element scratch.
export class ScrollController
	-- Pixels scrolled from the start. Always in `0 .. maxOffset`.
	offset: float

	-- Where the offset is heading. The same as `offset` unless a glide is
	-- running, and what a wheel notch moves — so three quick notches add up
	-- instead of each one restarting from wherever the last had eased to.
	target: float

	-- Set by the last layout: how far this view *can* scroll.
	maxOffset: float

	local dirty: boolean
	local glide: Tracker

	fn init(offset: float = 0.0)
		self.offset = offset
		self.target = offset
		self.maxOffset = 0.0
		self.dirty = false
		self.glide = Tracker(value: offset, duration: 0.18, easing: EasingTypes.OutCubic)
	end

	fn jumpTo(offset: float) -> nil
		self.setOffset(offset)
	end

	fn scrollBy(delta: float) -> nil
		self.setOffset(self.offset + delta)
	end

	-- Wheel scrolling: move the *target* and let `settle` catch the offset up.
	--
	-- Dragging a scrollbar goes through `setOffset` instead, which snaps —
	-- easing towards a thumb the pointer is already holding is just lag.
	fn glideBy(delta: float) -> boolean
		local aim: float = atLeastZero(atMost(self.target + delta, self.maxOffset))

		if aim == self.target then
			return false
		end

		self.target = aim
		self.glide.target(aim)
		self.dirty = true

		return true
	end

	-- Advance a running glide. True when the offset moved, which is the signal
	-- the scroll view uses to lay itself out again.
	fn settle(dt: float) -> boolean
		if not self.glide.step(dt) then
			return false
		end

		self.offset = atLeastZero(atMost(self.glide.current, self.maxOffset))
		self.dirty = true

		return true
	end

	-- Clamp into range and report whether anything actually moved — that is
	-- what a scroll view returns to the pointer system to say "I used the
	-- wheel", so a view already at its end lets the parent scroll instead.
	fn setOffset(offset: float) -> boolean
		local clamped: float = atLeastZero(atMost(offset, self.maxOffset))

		if clamped == self.offset then
			-- Still cancel a glide heading somewhere else: a drag that lands on
			-- the offset a wheel notch was already easing towards must stop it,
			-- or the view keeps moving under a stationary thumb.
			self.target = clamped
			self.glide.snap(clamped)

			return false
		end

		self.offset = clamped
		self.target = clamped
		self.glide.snap(clamped)
		self.dirty = true

		return true
	end

	-- Called by layout once the content size is known. Re-clamps, because the
	-- content may have shrunk since the last frame.
	fn setExtent(maxOffset: float) -> nil
		self.maxOffset = atLeastZero(maxOffset)
		self.offset = atLeastZero(atMost(self.offset, self.maxOffset))

		-- A glide aimed past the new end would keep pulling the offset back
		-- out of range, so it is re-aimed rather than left running.
		local capped: float = atLeastZero(atMost(self.target, self.maxOffset))

		if capped != self.target then
			self.target = capped
			self.glide.snap(self.offset)
		end
	end

	fn atStart() -> boolean
		return self.offset <= 0.0
	end

	fn atEnd() -> boolean
		return self.offset >= self.maxOffset
	end

	-- Fraction of the way down, 0 to 1. Zero when there is nothing to scroll.
	fn progress() -> float
		if self.maxOffset <= 0.0 then
			return 0.0
		end

		return self.offset / self.maxOffset
	end

	fn takeDirty() -> boolean
		local was: boolean = self.dirty
		self.dirty = false

		return was
	end
end

-- The controller a scroll view keeps on its element, mirroring `nodeFor`.
--
-- A controller is this view's own state rather than anything the framework
-- knows about, so it lives in the untyped `scratch` — which means the one `as`
-- that recovers it belongs here, not at each of the call sites. A slot holding
-- anything else is replaced rather than crashed on.
export fn controllerFor(data: ElementData) -> ScrollController
	local existing: ScrollController? = data.scratch.controller as ScrollController

	if existing != nil then
		return existing!
	end

	local made: ScrollController = ScrollController()
	data.scratch.controller = made

	return made
end

-- The viewport: clips to its own box and draws the child shifted by the
-- controller's offset. `ScrollView` wraps this with the wheel
-- handling; use it directly only if you are routing scrolling yourself.
export class Viewport extends SingleChildView
	axis: ScrollAxis
	controller: ScrollController

	fn init(
		child: View? = nil,
		axis: ScrollAxis = ScrollAxis.Vertical,
		controller: ScrollController? = nil,
		key: string? = nil
	)
		self.super(child, key)

		self.axis = axis
		self.controller = controller ?? ScrollController()
	end

	fn layout(el: Element, constraints: Constraints) -> Size
		local vertical: boolean = self.axis == ScrollAxis.Vertical
		local child: Element? = el.childAt(1)

		-- The viewport itself fills what it is given; unbounded on the scroll
		-- axis means "shrink-wrap", which is what a scroll view inside a column
		-- of unknown height does.
		local size: Size = constraints.biggest()

		if child == nil then
			return size
		end

		-- Unbound the scroll axis so the child reports its natural extent, and
		-- keep the cross axis tight so content still fills the width.
		local inner: Constraints = Constraints(
			constraints.minWidth,
			constraints.maxWidth,
			0.0,
			Math.huge
		)

		if not vertical then
			inner = Constraints(0.0, Math.huge, constraints.minHeight, constraints.maxHeight)
		end

		local content: Size = child!.layout(inner)

		if vertical then
			self.controller.setExtent(content.height - size.height)
			child!.offset = Offset(0.0, -self.controller.offset)
		else
			self.controller.setExtent(content.width - size.width)
			child!.offset = Offset(-self.controller.offset, 0.0)
		end

		return size
	end

	fn paint(el: Element, x: float, y: float) -> nil
		-- Clip at the viewport edge; the child is already offset out of view.
		local sx: float, sy: float, sw: float, sh: float = Graphics.getScissor()

		Graphics.intersectScissor(x, y, el.size.width, el.size.height)
		el.paintChildren(x, y)
		Graphics.setScissor(sx, sy, sw, sh)
	end
end

-- A scrollable region.
--
--     ScrollView(child: VStack(children: manyRows))
--
-- The wheel scrolls it while the pointer is inside, and it only claims the
-- wheel when it can actually move — so a list nested inside another one hands
-- scrolling back to its parent once it hits an end, the way every real UI does.
--
-- Nothing about it is stateful from the outside: the offset lives in element
-- scratch, so it survives rebuilds without a `State` object.
export class ScrollView extends View
	child: View?
	axis: ScrollAxis
	controller: ScrollController?

	-- Pixels moved per wheel notch.
	step: float

	-- Draw a thin indicator when there is something to scroll.
	showBar: boolean
	barColor: Color?

	fn init(
		child: View? = nil,
		axis: ScrollAxis = ScrollAxis.Vertical,
		controller: ScrollController? = nil,
		step: float = 48.0,
		showBar: boolean = true,
		barColor: Color? = nil,
		key: string? = nil,
		content: (fn() -> nil)? = nil
	)
		self.super(key)

		self.child = childOf(child, content)
		self.axis = axis
		self.controller = controller
		self.step = step
		self.showBar = showBar
		self.barColor = barColor
	end

	-- Carries a wheel glide forward, and picks up any other move the offset
	-- made. The offset is read during layout, so the view has to be rebuilt for
	-- a new one to show — which is why this marks itself dirty rather than
	-- asking for a repaint.
	fn tick(el: Element, dt: float) -> nil
		local supplied: ScrollController? = self.controller
		local controller: ScrollController = controllerFor(el.data)

		if supplied != nil then
			controller = supplied!
		end

		local moved: boolean = controller.settle(dt)

		-- Dragging the scrollbar thumb, or a `jumpTo` from anywhere else, moves
		-- the offset without going through the wheel handler. The scrollbar can
		-- only invalidate *itself*, and it is a sibling of the viewport that
		-- actually places the content — so marking its own layout dirty moved
		-- nothing. Noticing the controller here is what makes a drag work.
		if controller.takeDirty() then
			moved = true
		end

		if moved then
			el.markNeedsBuild()
		end
	end

	fn body(context: BuildContext) -> View
		local data: ElementData = context.data()

		-- An explicit controller wins; otherwise keep one per element so the
		-- position outlives every rebuild.
		local supplied: ScrollController? = self.controller

		local controller: ScrollController = controllerFor(data)

		if supplied != nil then
			controller = supplied!
		end

		local vertical: boolean = self.axis == ScrollAxis.Vertical

		local viewport: View = Viewport(child: self.child, axis: self.axis, controller: controller)

		if self.showBar then
			viewport = ZStack(
				children: {
					viewport,
					ScrollBar(controller: controller, axis: self.axis, thumbColor: self.barColor),
				}
			)
		end

		return GestureArea(
			child: viewport,
			onScroll: fn(dx: float, dy: float)
				-- Wheel up is positive, and scrolling up means a smaller offset.
				local delta: float = -dy

				if not vertical then
					delta = -dx

					-- A horizontal view is usually driven by a vertical wheel,
					-- so fall back to it when there is no sideways movement.
					if delta == 0.0 then
						delta = -dy
					end
				end

				if delta == 0.0 then
					return false
				end

				controller.glideBy(delta * self.step)

				-- Only claim the wheel if the offset actually moved; at either
				-- end, an enclosing scroll view should get it instead.
				if controller.takeDirty() then
					context.markNeedsBuild()

					return true
				end

				return false
			end
		)
	end
end

-- The scrollbar drawn over a scroll view: drag the thumb, click the track to
-- page, hover to fatten it. It paints nothing and takes no input when the
-- content fits.
--
-- It covers the whole viewport so it can sit on top of the content, but only
-- *claims* presses inside the bar strip along the edge — otherwise it would eat
-- every click meant for the list underneath.
export class ScrollBar extends View
	controller: ScrollController
	axis: ScrollAxis
	color: Color?
	thumbColor: Color?
	thickness: float

	-- How wide the grabbable strip is, as opposed to the drawn thumb.
	grabWidth: float

	fn init(
		controller: ScrollController,
		axis: ScrollAxis = ScrollAxis.Vertical,
		color: Color? = nil,
		thumbColor: Color? = nil,
		thickness: float = 4.0,
		grabWidth: float = 14.0,
		key: string? = nil
	)
		self.super(key)

		self.controller = controller
		self.axis = axis
		self.color = color
		self.thumbColor = thumbColor
		self.thickness = thickness
		self.grabWidth = grabWidth
	end

	fn layout(el: Element, constraints: Constraints) -> Size
		return constraints.biggest()
	end

	-- --- geometry ------------------------------------------------------------
	--
	-- One place computes the thumb, and paint and input both read it — so what
	-- you see is exactly what you can grab.

	local fn vertical() -> boolean
		return self.axis == ScrollAxis.Vertical
	end

	-- Length of the viewport along the scroll axis.
	local fn extent(el: Element) -> float
		if self.vertical() then
			return el.size.height
		end

		return el.size.width
	end

	-- Thumb length: the visible fraction of the content, with a floor so it
	-- stays grabbable on very long content.
	local fn thumbLength(el: Element) -> float
		local viewport: float = self.extent(el)
		local content: float = viewport + self.controller.maxOffset

		if content <= 0.0 then
			return viewport
		end

		return atLeast(viewport * viewport / content, 24.0)
	end

	local fn travel(el: Element) -> float
		return atLeastZero(self.extent(el) - self.thumbLength(el))
	end

	local fn thumbStart(el: Element) -> float
		return self.travel(el) * self.controller.progress()
	end

	-- Whether a local point is inside the strip along the bar's edge.
	local fn inStrip(el: Element, x: float, y: float) -> boolean
		if self.vertical() then
			return x >= el.size.width - self.grabWidth and x <= el.size.width
		end

		return y >= el.size.height - self.grabWidth and y <= el.size.height
	end

	local fn alongOf(x: float, y: float) -> float
		if self.vertical() then
			return y
		end

		return x
	end

	-- --- input ---------------------------------------------------------------

	fn handleEvent(el: Element, event: PointerEvent, x: float, y: float, inside: boolean) -> boolean
		if self.controller.maxOffset <= 0.0 then
			return false
		end

		if event.kind == PointerKind.Move then
			if el.data.dragging then
				-- Dragging continues even once the pointer wanders off the bar.
				self.dragTo(el, self.alongOf(x, y))

				return false
			end

			local over: boolean = inside and self.inStrip(el, x, y)

			if over != el.data.hovered then
				el.data.hovered = over

				-- Nothing else on this frame is dirty — the pointer moving does
				-- not by itself repaint anything — so the bar has to ask, or it
				-- keeps drawing at its old width until something unrelated
				-- happens to trigger a frame.
				Repaint.request()
			end

			return false
		end

		if event.kind == PointerKind.Up then
			if el.data.dragging then
				Repaint.request()
			end

			el.data.dragging = false

			return false
		end

		if event.kind != PointerKind.Down then
			return false
		end

		if not inside or not self.inStrip(el, x, y) then
			return false
		end

		local along: float = self.alongOf(x, y)
		local start: float = self.thumbStart(el)
		local length: float = self.thumbLength(el)

		if along >= start and along <= start + length then
			-- Grabbed the thumb: remember where, so it doesn't jump.
			el.data.dragging = true
			el.data.scratch.grab = along - start

			Repaint.request()

			-- Clicked the track: page toward the click.
		else
			local page: float = self.extent(el)

			-- Glided, not jumped: a page is a long way to move, and landing
			-- somewhere new without seeing the travel loses your place.
			if along < start then
				self.controller.glideBy(-page)
			else
				self.controller.glideBy(page)
			end

			-- Moving the offset changes where the viewport puts its child, and
			-- nothing rebuilt, so the cached layout has to be thrown away.
			el.markNeedsLayout()
		end

		return true
	end

	local fn dragTo(el: Element, along: float) -> nil
		local travel: float = self.travel(el)

		if travel <= 0.0 then
			return
		end

		local grab: float = el.data.scratch.grab as float ?? 0.0

		local fraction: float = atLeastZero(atMost((along - grab) / travel, 1.0))
		self.controller.jumpTo(fraction * self.controller.maxOffset)
		el.markNeedsLayout()
	end

	-- --- paint ---------------------------------------------------------------

	-- Whether the bar is in use, as a 0..1 value. Both `tick` and `paint` go
	-- through here so they can never disagree about the width being drawn.
	local fn activeMotion(el: Element) -> AnimationController
		return motionOn(
			el.data.scratch,
			"active",
			el.data.hovered or el.data.dragging,
			0.13,
			EasingTypes.OutCubic
		)
	end

	fn tick(el: Element, dt: float) -> nil
		if self.controller.maxOffset <= 0.0 then
			return
		end

		if self.activeMotion(el).step(dt) then
			Repaint.request()
		end
	end

	fn paint(el: Element, x: float, y: float) -> nil
		if self.controller.maxOffset <= 0.0 then
			return
		end

		-- The bar grows and brightens on the same value, so a pointer arriving
		-- at the edge is met by the bar coming to meet it.
		local active: float = self.activeMotion(el).value
		local thickness: float = self.thickness + 3.0 * active

		local thumb: Color = self.thumbColor ?? Colors.border.lerp(Colors.textMuted, active)

		local length: float = self.thumbLength(el)
		local along: float = self.thumbStart(el)

		-- The track only shows while the bar is in use, so it stays quiet.
		local rail: Color? = self.color

		if rail == nil and active > 0.0 then
			rail = Colors.surface.withAlpha(active)
		end

		if self.vertical() then
			local left: float = x + el.size.width - thickness - 2.0

			if rail != nil then
				rail!.apply()
				Graphics.rectangle("fill", left, y, thickness, el.size.height, 2.0, 2.0)
			end

			thumb.apply()
			Graphics.rectangle("fill", left, y + along, thickness, length, 2.0, 2.0)
		else
			local top: float = y + el.size.height - thickness - 2.0

			if rail != nil then
				rail!.apply()
				Graphics.rectangle("fill", x, top, el.size.width, thickness, 2.0, 2.0)
			end

			thumb.apply()
			Graphics.rectangle("fill", x + along, top, length, thickness, 2.0, 2.0)
		end
	end
end

-- A scrolling list of children — `ScrollView` wrapped around a
-- `VStack` (or `HStack`), which is the shape almost every list wants.
--
-- Every child is built up front, so this is for tens of rows, not thousands.
export class List extends View
	children: table<View>
	axis: ScrollAxis
	controller: ScrollController?
	spacing: float
	padding: EdgeInsets?
	step: float
	showBar: boolean

	fn init(
		children: table<View> = {},
		axis: ScrollAxis = ScrollAxis.Vertical,
		controller: ScrollController? = nil,
		spacing: float = 0.0,
		padding: EdgeInsets? = nil,
		step: float = 48.0,
		showBar: boolean = true,
		key: string? = nil,
		content: (fn() -> nil)? = nil
	)
		self.super(key)

		self.children = childrenOf(children, content)
		self.axis = axis
		self.controller = controller
		self.spacing = spacing
		self.padding = padding
		self.step = step
		self.showBar = showBar
	end

	fn body(context: BuildContext) -> View
		local content: View = VStack(
			children: self.children,
			alignment: StackAlignment.Fill,
			sizing: StackSize.Fit,
			spacing: self.spacing
		)

		if self.axis == ScrollAxis.Horizontal then
			content = HStack(
				children: self.children,
				alignment: StackAlignment.Center,
				sizing: StackSize.Fit,
				spacing: self.spacing
			)
		end

		local padding: EdgeInsets? = self.padding

		if padding != nil then
			content = content.padding(insets: padding)
		end

		return ScrollView(
			child: content,
			axis: self.axis,
			controller: self.controller,
			step: self.step,
			showBar: self.showBar
		)
	end
end
