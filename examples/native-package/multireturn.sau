-- Multi-return from a native package: `Util.divmod` returns two values that
-- Saule spreads across separate bindings, just like a Saule multi-return fn.
import Util from "engine"

class Main
	static fn main()
		local q, r = Util.divmod(16, 5)
		println("q = ", q)  -- 3
		println("r = ", r)  -- 2

		-- In single-value context only the first value is taken.
		local justQ = Util.divmod(20, 6)
		println("justQ = ", justQ)  -- 3
	end
end
