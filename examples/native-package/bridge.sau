import Util from "engine"

-- Build a table on the host, sum it, map it, and read keys, all across the
-- native .so boundary using the STable / SFunction bridge.
class Main
  static fn main()
    local nums: table = {10, 20, 30, 40}

    println("sum     = ", Util.sum(nums))

    local doubled = Util.map(nums, x => x * 2)
    println("doubled = ", doubled[1], ", ", doubled[2], ", ", doubled[3], ", ", doubled[4])

    local r = Util.range(5)
    println("range   = ", r[1], "..", r[5], " (len ", #r, ")")

    local k = Util.keys(nums)
    println("keys    = ", #k, " keys")
  end
end
