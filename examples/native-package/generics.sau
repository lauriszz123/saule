import Util from "engine"

-- The generic Util.* signatures thread the table's element type through, so
-- find returns `T?`, filter/reverse/concat/slice return `table<T>`, reduce
-- returns the accumulator type, and contains/indexOf require a matching key.
class Main
  static fn main()
    local nums = Util.range(6)  -- table<integer>

    -- find returns integer? — coalesce to a plain integer.
    local firstBig: integer? = Util.find(nums, x => x > 4)
    println("find       = ", firstBig)

    -- reduce returns the accumulator's type (integer here).
    local total = Util.reduce(nums, (acc: integer, x: integer) => acc + x, 0)
    println("reduce     = ", total)

    -- filter keeps table<integer>.
    local evens = Util.filter(nums, x => x % 2 == 0)
    println("filter     = ", evens[1], ", ", evens[2], ", ", evens[3])

    println("contains 4 = ", Util.contains(nums, 4))
    println("indexOf 5  = ", Util.indexOf(nums, 5))
  end
end
