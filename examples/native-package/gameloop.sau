-- A minimal game loop driven from Saule.
--
-- Saule owns the loop; each iteration calls into the native `engine` package
-- to pump events, read the frame delta, and draw. Because our ABI only
-- marshals primitives (no function callbacks), this Saule-driven shape is the
-- natural fit — contrast love2d's callback-driven `love.update`/`love.draw`.
--
-- Build & install the package first (see README.md), then:
--   saule run examples/native-package/gameloop.sau

import Graphics, Window, Timer from "engine"

class Main
    static fn main()
        Window.create(800, 600, "Saule — game loop")

        -- Simple moving-circle state.
        local x: float = 100.0
        local y: float = 300.0
        local speed: float = 200.0    -- pixels per second
        local frames: integer = 0

        while Window.isOpen() do
            -- 1. Input / OS events.
            Window.pollEvents()

            -- 2. Update using the real frame delta.
            local dt: float = Timer.getDelta()
            x = x + speed * dt
            if x > 700.0 then
                x = 700.0
                speed = -speed
            end
            if x < 100.0 then
                x = 100.0
                speed = -speed
            end

            -- 3. Draw.
            Graphics.clear(0.1, 0.1, 0.12)
            Graphics.setColor(1.0, 0.8, 0.2)
            Graphics.circle("fill", x, y, 32.0)
            Graphics.setColor(0.3, 0.7, 1.0)
            Graphics.rectangle("line", 10.0, 10.0, 120.0, 40.0)
            Graphics.present()

            frames = frames + 1
        end

        printf("ran %d frames over %.3fs\n", frames, Timer.getTime())
    end
end
