-- Images, spritesheets, the wheel, and the cursor.
--
-- Images and canvases share one handle registry, so a loaded PNG works
-- everywhere a canvas does: `Graphics.draw` composites it, `Graphics.drawFrame`
-- picks one cell out of it, `Graphics.imageSize` measures it, and
-- `Graphics.setCanvas` can even draw *into* it.
--
-- Build & install the package first (see README.md), then:
--   saule run examples/native-package/images.sau path/to/sheet.png
import * from engine

class Main
	static fn main()
		-- The sheet is expected to be a grid of 16x16 cells; pass your own on the
		-- command line. Without one the example still runs and just draws the
		-- generated canvas.
		local args: table<string> = Os.args()
		local path: string? = nil

		if #args > 0 then
			path = args[1]
		end

		Window.create(720, 420, title: "Saule Images Example")

		-- A canvas is an image you draw yourself. Handy as a pre-rendered
		-- background: paint it once, then blit it every frame.
		local backdrop: integer = Graphics.newCanvas(180, 120)
		Graphics.setCanvas(backdrop)
		for i: integer = 0, 11 do
			Graphics.setColor(0.15 + float(i) * 0.05, 0.2, 0.45, 1.0)
			Graphics.rectangle("fill", float(i) * 15.0, 0.0, 15.0, 120.0)
		end
		Graphics.setCanvas()

		-- Loading is not cached by the engine, so do it once, outside the loop.
		local sheet: integer = 0
		local sheetWidth: integer = 0
		local sheetHeight: integer = 0

		if path != nil then
			sheet = Graphics.newImage(path!)
			sheetWidth, sheetHeight = Graphics.imageSize(sheet)
			printf("loaded %s (%dx%d)\n", path!, sheetWidth, sheetHeight)
		end

		-- Wheel-driven zoom, clamped to something sane.
		local zoom: float = 2.0
		local frame: integer = 0
		local elapsed: float = 0.0

		while Window.isOpen() do
			Window.pollEvents()

			-- The wheel is a per-frame delta, valid only for this `pollEvents`.
			local wheelX: float, wheelY: float = Mouse.getWheel()
			if wheelY != 0.0 then
				zoom = Math.clamp(zoom + wheelY * 0.25, 0.5, 8.0)
			end

			-- Per-frame button edges, so a click is one event rather than a state you
			-- have to diff yourself.
			if Mouse.wasPressed(1) then
				println("clicked")
			end
			if Mouse.wasReleased(1) then
				println("released")
			end

			-- Cursor feedback: an I-beam over the left half of the window.
			local mouseX: float, mouseY: float = Mouse.getPos()
			if mouseX < 360.0 then
				Mouse.setCursor("ibeam")
			else
				Mouse.setCursor("arrow")
			end

			-- Advance the animation four cells a second.
			elapsed = elapsed + Timer.getDelta()
			frame = int(elapsed * 4.0) % 4

			Graphics.clear(0.09, 0.09, 0.12)

			Graphics.setColor(1.0, 1.0, 1.0, 1.0)
			Graphics.draw(backdrop, 24.0, 60.0)

			if sheet != 0 then
				-- One 16x16 cell, scaled by the wheel. Sampling is confined to the
				-- cell, so neighbouring frames never bleed in along the edges.
				local cellX: float = float(frame % 4) * 16.0
				local cellY: float = 0.0

				Graphics.drawFrame(sheet, cellX, cellY, 16.0, 16.0, 260.0, 60.0, 0.0, zoom, zoom)

				-- The whole sheet, tinted and half size.
				Graphics.setColor(0.6, 0.9, 1.0, 1.0)
				Graphics.draw(sheet, 260.0, 220.0, 0.0, 0.5, 0.5)
				Graphics.setColor(1.0, 1.0, 1.0, 1.0)
			end

			Graphics.print("scroll to zoom (" .. zoom .. "x), cursor changes on the left half", 24.0, 24.0)

			Graphics.present()
		end
	end
end
