-- The Keyboard API: held keys, per-frame edges, and typed text.
--
-- Saule owns the loop, so Love2D's `love.keypressed` / `love.keyreleased` /
-- `love.textinput` callbacks become queries you make once per frame:
-- `wasPressed`, `wasReleased`, and `getTextInput`. All three are measured
-- against the last `Window.pollEvents()`.
--
-- Build & install the package first (see README.md), then:
--   saule run examples/native-package/keyboard.sau
import Graphics, Keyboard, Window from engine

class Main
	static fn main()
		Window.create(720, 420, title: "Saule Keyboard Example")

		-- Key repeat makes a held key keep reporting `wasPressed` after a short
		-- delay — what a text field wants for backspace and the arrows.
		Keyboard.setKeyRepeat(true)

		-- A little text field, driven entirely by the keyboard API.
		local typed: string = ""
		-- A box moved with the arrows or WASD.
		local x: float = 360.0
		local y: float = 280.0

		while Window.isOpen() do
			Window.pollEvents()

			-- Text is layout- and modifier-aware, so shift+a arrives as "A".
			typed = typed .. Keyboard.getTextInput()

			-- Editing keys are not text, so they come from the edge queries.
			if Keyboard.wasPressed("backspace") and #typed > 0 then
				typed = String.sub(typed, 1, #typed - 1)
			end

			if Keyboard.wasPressed("return") then
				typed = ""
			end

			-- Held keys drive continuous movement; a modifier check is just two
			-- more held keys.
			local step: float = 4.0
			if Keyboard.isAnyDown({"lshift", "rshift"}) then
				step = 8.0
			end

			if Keyboard.isAnyDown({"left", "a"}) then
				x = x - step
			end

			if Keyboard.isAnyDown({"right", "d"}) then
				x = x + step
			end

			if Keyboard.isAnyDown({"up", "w"}) then
				y = y - step
			end

			if Keyboard.isAnyDown({"down", "s"}) then
				y = y + step
			end

			Graphics.clear(0.09, 0.09, 0.12)

			Graphics.setColor(0.9, 0.9, 0.95)
			Graphics.print("Type something. Backspace deletes, Enter clears.", 24.0, 24.0)
			Graphics.print("> " .. typed, 24.0, 52.0)

			-- Every key held this frame, as Love2D-style names.
			local down: table<string> = Keyboard.getKeysDown()
			local held: string = ""
			for _, key in down do
				held = held .. key .. " "
			end

			Graphics.setColor(0.5, 0.8, 1.0)
			Graphics.print("down: " .. held, 24.0, 96.0)

			-- The same information Love2D's keypressed/keyreleased would hand you.
			local pressed: table<string> = Keyboard.getKeysPressed()
			for _, key in pressed do
				printf("pressed %s\n", key)
			end

			local released: table<string> = Keyboard.getKeysReleased()
			for _, key in released do
				printf("released %s\n", key)
			end

			Graphics.setColor(1.0, 0.8, 0.2)
			Graphics.rectangle("fill", x - 20.0, y - 20.0, 40.0, 40.0)

			Graphics.present()
		end
	end
end
