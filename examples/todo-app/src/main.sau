import Storage from "storage"

import Renderer from "render"

class Main
  static fn help()
    println("TODO App Usage:")
    println("\ttodo list")
    println("\ttodo add [task]")
    println("\ttodo remove [number-of-task]")
    println("\ttodo done [number-of-task]")
  end

  static fn main()
    local storage: Storage = Storage("todo.json")
    local args: table = Os.args()

    -- Create todo.json on first run; refuse to touch it if it exists
    -- but fails to parse so we don't silently wipe the user's data.

    if not Os.exists("todo.json") then
      storage.save()
    elseif not storage.load() then
      println("error: todo.json is corrupt; refusing to overwrite")
      return
    end

    if #args == 0 then
      Main.help()
      return
    end

    match args[1]
      case "list" then Renderer.print(storage.getAll())

      case "add" then
        local due: integer? = nil

        if args[3] != nil then
          due = Os.parsedate(args[3])
          if due == nil then
            println("invalid date: " .. args[3] .. " (expected YYYY-MM-DD)")
            return
          end
        end

        storage.add(args[2], dueDate: due)
        storage.save()

      case "done" then
        local index: integer? = tointeger(args[2])
        if index == nil then
          println("error: invalid task number")
        else
          storage.update(index, isDone: true)
          storage.save()
        end

      case "due" then
        local index: integer? = tointeger(args[2])

        if index == nil then
          println("error: invalid task number")
          return
        end

        if args[3] == nil then
          println("error: missing due date")
          return
        end

        local due: integer? = Os.parsedate(args[3])
        if due == nil then
          println("invalid date: " .. args[3] .. " (expected YYYY-MM-DD)")
          return
        end

        storage.update(index, dueDate: due)

      case "remove" then
        local index: integer? = tointeger(args[2])
        if index == nil then
          println("error: invalid task number")
          return
        end

        if not storage.remove(index) then
          printf("Task id %d does not exist\n", index)
        else
          storage.save()
        end

      case _ then Main.help()
    end
  end
end
