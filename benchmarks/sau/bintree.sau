-- Binary search tree: build one, then walk it.
--
-- Allocation and pointer chasing rather than arithmetic — every `insert`
-- descends through instances, and every step is a nullable field read, a
-- comparison and a method call on a fresh receiver.
class Node
	local key: integer
	local left: Node?
	local right: Node?

	fn init(k: integer)
		self.key = k
	end

	fn insert(k: integer)
		if k < self.key then
			if self.left == nil then
				self.left = Node(k)
			else
				self.left!.insert(k)
			end
		else
			if self.right == nil then
				self.right = Node(k)
			else
				self.right!.insert(k)
			end
		end
	end

	fn sum() -> integer
		local s: integer = self.key
		if self.left != nil then
			s = s + self.left!.sum()
		end
		if self.right != nil then
			s = s + self.right!.sum()
		end
		return s
	end

	fn depth() -> integer
		local l: integer = 0
		local r: integer = 0
		if self.left != nil then
			l = self.left!.depth()
		end
		if self.right != nil then
			r = self.right!.depth()
		end
		if l > r then
			return l + 1
		end
		return r + 1
	end
end

class Main
	static fn main()
		local n: integer = 200000
		local seed: integer = 12345
		seed = (seed * 1103515245 + 12345) % 2147483648
		local root: Node = Node(seed % 1000000)
		for i: integer = 2, n do
			seed = (seed * 1103515245 + 12345) % 2147483648
			root.insert(seed % 1000000)
		end
		println(root.sum() .. " " .. root.depth())
	end
end
