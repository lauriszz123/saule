class Point
	local x: float
	local y: float

	fn init(x: float, y: float)
		self.x = x
		self.y = y
	end

	fn getX() -> float
		return self.x
	end

	fn getY() -> float
		return self.y
	end

	fn move(dx: float, dy: float)
		self.x = self.x + dx
		self.y = self.y + dy
	end
end

class Main
	static fn main()
		local n: integer = 1000000
		local p: Point = Point(0.0, 0.0)
		for i: integer = 1, n do
			p.move(1.0, 2.0)
		end
		println(p.getX() + p.getY())
	end
end
