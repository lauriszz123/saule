-- The `Iter` module: the whole combinator set over one list, per pass.
--
-- Saule ships what Lua leaves to the user. Every one of these is a loop with
-- a callback per element, so this measures the thing functional collection
-- code lives on — the cost of calling a lambda a few hundred thousand times
-- and of allocating the intermediate table each stage hands to the next.
--
-- Against hand-written Lua loops this is the fairest comparison in the suite
-- and the least flattering: the Lua twin fuses nothing either, but it pays
-- no call through a function-typed slot, so the gap is close to the price of
-- the callback itself.
class Main
	static fn main()
		local nums: table<integer> = {}
		for i: integer = 1, 1000 do
			nums[i] = (i * 2654435761) % 100000
		end

		local checksum: integer = 0
		for pass: integer = 1, 600 do
			local doubled: table<integer> = Iter.map(nums, x => x * 2)
			local kept: table<integer> = Iter.filter(doubled, x => x % 3 != 0)
			checksum = (checksum + Iter.reduce(kept, 0, (a, v) => a + v)) % 1000000007

			if Iter.any(kept, x => x > 199000) then
				checksum = checksum + 1
			end
			if Iter.all(kept, x => x >= 0) then
				checksum = checksum + 2
			end
			checksum = (checksum + Iter.count(kept, x => x % 5 == 0)) % 1000000007
			checksum = (checksum + (Iter.find(kept, x => x % 2 == 1) ?? -1)) % 1000000007
			checksum = (checksum + (Iter.findIndex(kept, x => x > 50000) ?? -1)) % 1000000007
			checksum = (checksum + (Iter.first(kept) ?? 0) + (Iter.last(kept) ?? 0)) % 1000000007

			local head: table<integer> = Iter.take(kept, 120)
			local rest: table<integer> = Iter.skip(kept, 500)
			checksum = (checksum + #head + #rest) % 1000000007

			-- `unique` keeps first-appearance order, so the result is the
			-- same list in both languages and not merely the same set.
			local uniq: table<integer> = Iter.unique(Iter.map(nums, x => x % 97))
			-- Sorted by a key that is unique within `uniq`, so stability
			-- cannot change the answer.
			local sorted: table<integer> = Iter.sortBy(uniq, x => x)
			checksum = (checksum + #uniq + (sorted[1] ?? 0) + (sorted[#sorted] ?? 0)) % 1000000007

			checksum = (checksum + Iter.reduce(Iter.zipWith(head, head, (a, b) => a + b), 0, (a, v) => a + v)) % 1000000007

			local chunks: table<table<integer>> = Iter.chunk(head, 7)
			local flat: table<integer> = Iter.flatten(chunks)
			checksum = (checksum + #chunks + #flat) % 1000000007

			-- Four buckets, read by key rather than by iteration order.
			local groups: table<integer, table<integer>> = Iter.groupBy(nums, x => x % 4)
			for k: integer = 0, 3 do
				checksum = (checksum + #(groups[k] ?? {})) % 1000000007
			end
		end

		println(checksum)
	end
end
