-- The `Bytes` module: a binary frame scanner.
--
-- Saule separates `bytes` from `string` — a `string` is always valid UTF-8
-- and is measured in codepoints, so binary data gets its own type with its
-- own module. Lua has no such split and uses a `string` as its byte buffer,
-- which is what the twin does. The workload is the one this type exists for:
-- walk a buffer byte by byte, find a marker, slice the frames between
-- markers, splice some back together and hex-dump a header.
class Main
	static fn payload(records: integer) -> string
		local parts: table<string> = {}
		local seed: integer = 4242
		for i: integer = 1, records do
			seed = (seed * 1103515245 + 12345) % 2147483648
			-- "FR" marks a frame; six ASCII bytes follow it.
			Table.insert(parts, "FR")
			Table.insert(parts, String.char(
				65 + seed % 26,
				65 + (seed / 26) % 26,
				97 + (seed / 676) % 26,
				48 + (seed / 7) % 10,
				48 + (seed / 70) % 10,
				45))
		end
		return Table.concat(parts, "")
	end

	static fn main()
		local buf: bytes = Bytes.fromString(Main.payload(6000))
		local n: integer = Bytes.len(buf)
		local marker: bytes = Bytes.fromString("FR")

		local total: integer = 0
		local frames: integer = 0
		local spanned: integer = 0
		local hex: string = ""

		for pass: integer = 1, 100 do
			-- Every byte, one at a time.
			for i: integer = 1, n do
				total = (total + (Bytes.byte(buf, i) ?? 0)) % 1000000007
			end

			-- Every marker, then the frame that follows it.
			local at: integer? = Bytes.indexOf(buf, marker, 1)
			local prev: integer = 0
			while at != nil do
				frames = frames + 1
				if prev > 0 then
					local frame: bytes = Bytes.sub(buf, prev, at! - 1)
					spanned = spanned + Bytes.len(frame)
				end
				prev = at!
				at = Bytes.indexOf(buf, marker, at! + 1)
			end

			-- Splice the head back together, and hex-dump it.
			local head: bytes = Bytes.concat(Bytes.sub(buf, 1, 8), Bytes.sub(buf, 9, 16))
			hex = Bytes.toHex(head)

			-- Round-trip a slice through a byte array and back to text.
			local arr: byte[] = Bytes.toArray(Bytes.sub(buf, 3, 8))
			local back: bytes = Bytes.fromArray(arr)!
			spanned = spanned + String.len(Bytes.toString(back) ?? "")
		end

		println(total .. " " .. frames .. " " .. spanned .. " " .. hex)
	end
end
