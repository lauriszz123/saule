-- A recursive-descent JSON scanner.
--
-- Parsing is the branchiest everyday workload there is: one character read
-- and a multi-way dispatch per step, method calls on a receiver carrying the
-- cursor, and deep recursion through nested structure. It leans on
-- single-character `String.sub`, which is what any hand-written scanner does.
class Parser
	src: string
	pos: integer
	n: integer

	fn init(s: string)
		self.src = s
		self.pos = 1
		self.n = String.len(s)
	end

	fn peek() -> string
		if self.pos > self.n then
			return ""
		end
		return String.sub(self.src, self.pos, self.pos)
	end

	fn skipWs()
		while self.pos <= self.n and String.sub(self.src, self.pos, self.pos) == " " do
			self.pos = self.pos + 1
		end
	end

	-- Every value folds into one running checksum, so the whole parse has a
	-- single comparable result without building a tree the benchmark would
	-- then have to walk.
	fn value() -> float
		self.skipWs()
		local c: string = self.peek()
		if c == "{" then
			return self.object()
		elseif c == "[" then
			return self.array()
		elseif c == "\"" then
			return self.str()
		end
		return self.number()
	end

	fn object() -> float
		self.pos = self.pos + 1
		local acc: float = 1.0
		while true do
			self.skipWs()
			local c: string = self.peek()
			if c == "}" then
				self.pos = self.pos + 1
				return acc
			end
			if c == "," then
				self.pos = self.pos + 1
			else
				acc = acc + self.str()
				self.skipWs()
				self.pos = self.pos + 1
				acc = acc + self.value()
			end
		end
		return acc
	end

	fn array() -> float
		self.pos = self.pos + 1
		local acc: float = 2.0
		while true do
			self.skipWs()
			local c: string = self.peek()
			if c == "]" then
				self.pos = self.pos + 1
				return acc
			end
			if c == "," then
				self.pos = self.pos + 1
			else
				acc = acc + self.value()
			end
		end
		return acc
	end

	fn str() -> float
		self.pos = self.pos + 1
		local len: integer = 0
		while self.pos <= self.n and String.sub(self.src, self.pos, self.pos) != "\"" do
			len = len + 1
			self.pos = self.pos + 1
		end
		self.pos = self.pos + 1
		return float(len)
	end

	fn number() -> float
		local neg: boolean = false
		if self.peek() == "-" then
			neg = true
			self.pos = self.pos + 1
		end
		local acc: integer = 0
		local digits: integer = 0
		while self.pos <= self.n do
			local b: integer = String.byte(self.src, self.pos) ?? 0
			if b >= 48 and b <= 57 then
				acc = acc * 10 + (b - 48)
				digits = digits + 1
				self.pos = self.pos + 1
			else
				break
			end
		end
		if digits == 0 then
			self.pos = self.pos + 1
			return 0.0
		end
		if neg then
			acc = -acc
		end
		return float(acc)
	end
end

class Main
	static fn doc(records: integer) -> string
		local parts: table<string> = {}
		Table.insert(parts, "[")
		local seed: integer = 24680
		for i: integer = 1, records do
			if i > 1 then
				Table.insert(parts, ",")
			end
			seed = (seed * 1103515245 + 12345) % 2147483648
			Table.insert(parts, "{\"id\": ")
			Table.insert(parts, "" .. (seed % 10000))
			Table.insert(parts, ", \"name\": \"item")
			Table.insert(parts, "" .. (seed % 97))
			Table.insert(parts, "\", \"tags\": [")
			Table.insert(parts, "" .. (seed % 5))
			Table.insert(parts, ", ")
			Table.insert(parts, "" .. (seed % 7))
			Table.insert(parts, "], \"ok\": ")
			Table.insert(parts, "" .. (seed % 2))
			Table.insert(parts, "}")
		end
		Table.insert(parts, "]")
		return Table.concat(parts, "")
	end

	static fn main()
		local text: string = Main.doc(20000)
		local total: float = 0.0
		for pass: integer = 1, 3 do
			local p: Parser = Parser(text)
			total = total + p.value()
		end
		println(String.format("%.1f %d", total, String.len(text)))
	end
end
